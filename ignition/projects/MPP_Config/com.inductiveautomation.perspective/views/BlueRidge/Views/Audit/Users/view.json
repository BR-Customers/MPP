      }
    },
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\t# Storage is SECONDS; the editor presents whole MINUTES (FAT day-1 item 6).\n\tp \u003d BlueRidge.Location.SessionPolicy.getPolicy() or {}\n\tself.view.custom.policy \u003d {\"operatorPresenceTimeoutMinutes\": int(round((p.get(\"OperatorPresenceTimeoutSeconds\") or 1800) / 60.0)), \"elevationTimeoutMinutes\": int(round((p.get(\"ElevationTimeoutSeconds\") or 300) / 60.0))}"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "handleSavePolicy",
          "params": [],
          "script": "\t# The editor holds MINUTES; the proc + column are SECONDS. Convert at the boundary.\n\tpol \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.policy) or {}\n\top \u003d BlueRidge.Common.Util.toIntOrNone(pol.get(\"operatorPresenceTimeoutMinutes\"))\n\tel \u003d BlueRidge.Common.Util.toIntOrNone(pol.get(\"elevationTimeoutMinutes\"))\n\tif op is None or el is None:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": 0, \"Message\": \"Enter whole minutes for both timeouts.\"}, \"Session timeouts saved\")\n\t\treturn\n\tres \u003d BlueRidge.Location.SessionPolicy.updatePolicy({\"operatorPresenceTimeoutSeconds\": op * 60, \"elevationTimeoutSeconds\": el * 60})\n\tBlueRidge.Common.Ui.notifyResult(res, \"Session timeouts saved\")"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "usersRefresh",
          "pageScope": true,
          "script": "\tself.view.refreshBinding(\"custom.rows\")",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
