{
  "custom": {},
  "params": {
    "id": null,
    "equipment": "",
    "schedule": "",
    "businessDate": "",
    "baseline": "",
    "override": "",
    "hours": "",
    "delta": "",
    "deltaPositive": true,
    "reason": "",
    "deprecated": false,
    "selected": false
  },
  "propConfig": {
    "params.id": {
      "paramDirection": "input"
    },
    "params.equipment": {
      "paramDirection": "input"
    },
    "params.schedule": {
      "paramDirection": "input"
    },
    "params.businessDate": {
      "paramDirection": "input"
    },
    "params.baseline": {
      "paramDirection": "input"
    },
    "params.override": {
      "paramDirection": "input"
    },
    "params.hours": {
      "paramDirection": "input"
    },
    "params.delta": {
      "paramDirection": "input"
    },
    "params.deltaPositive": {
      "paramDirection": "input"
    },
    "params.reason": {
      "paramDirection": "input"
    },
    "params.deprecated": {
      "paramDirection": "input"
    },
    "params.selected": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 44
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Equipment"
        },
        "position": {
          "basis": "220px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.equipment"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "BusinessDate"
        },
        "position": {
          "basis": "110px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.businessDate"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Schedule"
        },
        "position": {
          "basis": "110px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.schedule"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Baseline"
        },
        "position": {
          "basis": "130px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.baseline"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-secondary)",
            "textDecoration": "line-through"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Override"
        },
        "position": {
          "basis": "130px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.override"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontWeight": "600"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Hours"
        },
        "position": {
          "basis": "80px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.hours"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Delta"
        },
        "position": {
          "basis": "90px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.deltaPositive}, 'var(--mpp-success, #2e7d32)', 'var(--mpp-warning, #b26a00)')"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.delta"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontWeight": "600"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Reason"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.reason"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-secondary)",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.openPopup(id=\"mpp-shift-override-editor\", view=\"BlueRidge/Components/Popups/ShiftOverrideEditor\", modal=True, showCloseIcon=False, draggable=False, params={\"mode\": \"update\", \"editId\": self.view.params.id})"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "EditButton"
        },
        "position": {
          "basis": "80px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!{view.params.deprecated}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "btn btn-sm"
          },
          "text": "Edit"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.background": {
        "binding": {
          "config": {
            "expression": "if({view.params.selected}, 'var(--mpp-accent-20)', 'transparent')"
          },
          "type": "expr"
        }
      },
      "props.style.color": {
        "binding": {
          "config": {
            "expression": "if({view.params.selected}, 'var(--mpp-accent-90)', 'var(--mpp-text-primary)')"
          },
          "type": "expr"
        }
      },
      "props.style.opacity": {
        "binding": {
          "config": {
            "expression": "if({view.params.deprecated}, 0.55, 1)"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "style": {
        "borderBottom": "1px solid var(--mpp-border-subtle)",
        "gap": "8px",
        "overflow": "hidden",
        "padding": "8px 12px"
      }
    },
    "type": "ia.container.flex"
  }
}
