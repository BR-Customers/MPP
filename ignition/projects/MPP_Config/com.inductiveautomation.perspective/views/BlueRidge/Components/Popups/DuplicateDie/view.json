    "scripts": {
      "customMethods": [
        {
          "name": "handleDuplicate",
          "params": [],
          "script": "\tsourceId = self.view.params.sourceToolId\n\tif not sourceId:\n\t\tBlueRidge.Common.Notify.toast('No source die', 'Select a die on the Tools screen first.', 'warning')\n\t\treturn\n\tdraft = self.view.custom.editDraft or {}\n\tmeta  = draft.get('meta') or {}\n\tif not (meta.get('Code') or '').strip():\n\t\tBlueRidge.Common.Notify.toast('Code required', 'Enter a code for the new die.', 'warning')\n\t\treturn\n\tif not (meta.get('Name') or '').strip():\n\t\tBlueRidge.Common.Notify.toast('Name required', 'Enter a name for the new die.', 'warning')\n\t\treturn\n\tresult = BlueRidge.Parts.Tool.handleDuplicate(sourceId, meta.get('Code'), meta.get('Name'))\n\tBlueRidge.Common.Ui.notifyResult(result, 'Die duplicated')\n\tif result and result.get('Status'):\n\t\tnewId = result.get('NewId')\n\t\tsystem.perspective.sendMessage('toolRefresh', scope='page')\n\t\tif newId:\n\t\t\tsystem.perspective.sendMessage('toolSelectId', payload={'id': newId}, scope='page')\n\t\tsystem.perspective.closePopup(id='mpp-duplicate-die')"
        },
        {
          "name": "handleClose",
          "params": [],
          "script": "\t# Clean form closes straight away; a part-filled one routes through the\n\t# shared ConfirmUnsaved popup (same shape as AddDie).\n\tif str(self.view.custom.editDraft) == str(self.view.custom.selected):\n\t\tsystem.perspective.closePopup(id='mpp-duplicate-die')\n\telse:\n\t\tsystem.perspective.openPopup(\n\t\t\tid='mpp-confirm-unsaved',\n\t\t\tview='BlueRidge/Components/Popups/ConfirmUnsaved',\n\t\t\tmodal=True,\n\t\t\tshowCloseIcon=False,\n\t\t\tparams={\n\t\t\t\t'title':       'Discard Duplicate?',\n\t\t\t\t'message':     'You have started filling out this form. Discard before closing?',\n\t\t\t\t'saveLabel':   'Duplicate & Close',\n\t\t\t\t'discardLabel': 'Discard & Close',\n\t\t\t},\n\t\t)"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "confirmUnsavedResult",
          "pageScope": true,
          "script": "\taction = payload.get('action') if payload else None\n\tif action == 'save':\n\t\tself.handleDuplicate()\n\telif action == 'discard':\n\t\tsystem.perspective.closePopup(id='mpp-duplicate-die')",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
