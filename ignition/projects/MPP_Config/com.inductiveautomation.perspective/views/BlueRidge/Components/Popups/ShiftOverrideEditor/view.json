{
  "custom": {
    "editDraft": {
      "meta": {
        "baselineText": "",
        "businessDate": "",
        "businessDateVal": null,
        "endTime": "",
        "equipmentLabel": "",
        "id": null,
        "isDeprecated": false,
        "locationId": null,
        "reason": "",
        "scheduleName": "",
        "shiftScheduleId": null,
        "startTime": ""
      }
    },
    "equipmentOptions": [],
    "scheduleOptions": [],
    "scheduleRows": [],
    "selected": {
      "meta": {
        "baselineText": "",
        "businessDate": "",
        "businessDateVal": null,
        "endTime": "",
        "equipmentLabel": "",
        "id": null,
        "isDeprecated": false,
        "locationId": null,
        "reason": "",
        "scheduleName": "",
        "shiftScheduleId": null,
        "startTime": ""
      }
    }
  },
  "params": {
    "editId": null,
    "mode": "create"
  },
  "propConfig": {
    "custom.equipmentOptions": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.ShiftOverride.equipmentOptions\", 0)"
        },
        "type": "expr"
      }
    },
    "custom.scheduleRows": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.ShiftSchedule.search\", 0)"
        },
        "type": "expr"
      }
    },
    "custom.scheduleOptions": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.ShiftSchedule.search\", 0)"
        },
        "transforms": [
          {
            "code": "\trows = BlueRidge.Common.Util.extractQualifiedValues(value) or []\n\treturn [\n\t\t{\"label\": \"%s  (%s - %s)\" % (r.get(\"Name\"), r.get(\"StartTimeText\"), r.get(\"EndTimeText\")),\n\t\t \"value\": r.get(\"Id\")}\n\t\tfor r in rows\n\t]",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.editId": {
      "onChange": {
        "enabled": true,
        "script": "\t# Reseed both halves of the editor state from the row being edited.\n\t# NOTE on the atomic-write rule: the dirty flag here is computed ON DEMAND\n\t# inside handleClose(), not by a property binding, so there is no binding to\n\t# re-evaluate between these two writes and no dirty flag that can latch.\n\t# (The atomic single-write rule applies to the per-section editors whose\n\t# dirty state IS binding-driven and broadcast to a parent.)\n\tnewId = currentValue.value\n\tif newId is None:\n\t\tmeta = BlueRidge.Oee.ShiftOverride.emptyMeta()\n\telse:\n\t\tmeta = BlueRidge.Oee.ShiftOverride.loadMeta(newId)\n\tself.view.custom.selected = {\"meta\": meta}\n\tself.view.custom.editDraft = {\"meta\": dict(meta)}"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.mode": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 620,
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "TitleLabel"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.mode} = \"create\", \"Add Shift Override\", \"Edit Shift Override\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "modal-title",
                "fontSize": "14px",
                "fontWeight": "600"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Spacer"
            },
            "position": {
              "grow": 1
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "DirtyIndicator"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.editDraft} != {view.custom.selected}, \"● Unsaved changes\", \"\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--mpp-accent)",
                "fontSize": "11px",
                "fontStyle": "italic"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tself.view.rootContainer.handleClose()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CloseIcon",
              "tooltip": {
                "text": "Close"
              }
            },
            "props": {
              "path": "mpp/cancel",
              "style": {
                "classes": "modal-close",
                "cursor": "pointer",
                "height": "18px",
                "width": "18px"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup('shiftOverrideEditorHowTo',\n\t\t'BlueRidge/Components/Popups/ShiftOverrideEditorHowTo',\n\t\tparams={'popupId': 'shiftOverrideEditorHowTo'},\n\t\tposition={'width': '54%', 'height': '92%'},\n\t\tmodal=False, overlayDismiss=False, showCloseIcon=False)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "HowToButton",
              "tooltip": {
                "text": "How to edit a Shift Override"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "path": "material/help_outline",
              "style": {
                "cursor": "pointer",
                "height": "35px",
                "width": "35px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "HeaderBar"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "background": "var(--mpp-surface-raised)",
            "borderBottom": "1px solid var(--mpp-border-subtle)",
            "gap": "12px",
            "overflow": "hidden",
            "padding": "0 16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "EquipmentLabel"
                },
                "props": {
                  "style": {
                    "classes": "field-label"
                  },
                  "text": "Equipment"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "EquipmentDropdown"
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.mode} = \"create\""
                      },
                      "type": "expr"
                    }
                  },
                  "props.options": {
                    "binding": {
                      "config": {
                        "path": "view.custom.equipmentOptions"
                      },
                      "type": "property"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.editDraft.meta.locationId"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": "Select a press or line…"
                },
                "type": "ia.input.dropdown"
              },
              {
                "meta": {
                  "name": "EquipmentReadonly"
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.mode} != \"create\""
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.custom.editDraft.meta.equipmentLabel"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontWeight": "600",
                    "padding": "6px 0"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "EquipmentField"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "ScheduleLabel"
                },
                "props": {
                  "style": {
                    "classes": "field-label"
                  },
                  "text": "Shift"
                },
                "type": "ia.display.label"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t# Seed the window from the chosen schedule so the operator edits FROM the\n\t# scheduled times rather than typing both from scratch.\n\tdraft = dict(BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.editDraft.get(\"meta\", {})) or {})\n\tsid = draft.get(\"shiftScheduleId\")\n\trows = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scheduleRows) or []\n\tfor r in rows:\n\t\tif r.get(\"Id\") == sid:\n\t\t\tdraft[\"scheduleName\"] = r.get(\"Name\") or \"\"\n\t\t\tdraft[\"baselineText\"] = \"%s - %s\" % (r.get(\"StartTimeText\"), r.get(\"EndTimeText\"))\n\t\t\tdraft[\"startTime\"] = r.get(\"StartTimeText\") or \"\"\n\t\t\tdraft[\"endTime\"] = r.get(\"EndTimeText\") or \"\"\n\t\t\tbreak\n\tself.view.custom.editDraft = {\"meta\": draft}"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "ScheduleDropdown"
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.mode} = \"create\""
                      },
                      "type": "expr"
                    }
                  },
                  "props.options": {
                    "binding": {
                      "config": {
                        "path": "view.custom.scheduleOptions"
                      },
                      "type": "property"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.editDraft.meta.shiftScheduleId"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": "Select the shift to override…"
                },
                "type": "ia.input.dropdown"
              },
              {
                "meta": {
                  "name": "ScheduleReadonly"
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.mode} != \"create\""
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.custom.editDraft.meta.scheduleName"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontWeight": "600",
                    "padding": "6px 0"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "ScheduleField"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "DateLabel"
                },
                "props": {
