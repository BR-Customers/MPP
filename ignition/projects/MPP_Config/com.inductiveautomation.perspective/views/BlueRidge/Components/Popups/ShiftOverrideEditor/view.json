                      "config": {
                        "script": "\tself.view.rootContainer.doSave()"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "SaveButton"
                },
                "position": {
                  "basis": "51px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "btn btn-primary btn-sm"
                  },
                  "text": "Save"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "RightCluster"
            },
            "props": {
              "alignItems": "center",
              "style": {
                "gap": "8px",
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "FooterBar"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "background": "var(--mpp-surface-raised)",
            "borderTop": "1px solid var(--mpp-border-subtle)",
            "gap": "8px",
            "overflow": "hidden",
            "padding": "12px 16px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "background": "var(--mpp-surface-canvas)",
        "borderRadius": "var(--mpp-radius-md, 8px)",
        "height": "100%",
        "overflow": "hidden",
        "width": "100%"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "doSave",
          "params": [],
          "script": "\timport re\n\tdraft = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.editDraft.get(\"meta\", {})) or {}\n\tmode = self.view.params.mode\n\tst = (draft.get(\"startTime\") or \"\").strip()\n\tet = (draft.get(\"endTime\") or \"\").strip()\n\tpat = re.compile(\"^([01]?[0-9]|2[0-3]):[0-5][0-9]$\")\n\n\tif not pat.match(st) or not pat.match(et):\n\t\tBlueRidge.Common.Notify.toast(\"Cannot save\", \"Start and end must be valid 24-hour HH:MM times.\", \"warning\")\n\t\treturn\n\tif st == et:\n\t\tBlueRidge.Common.Notify.toast(\"Cannot save\", \"End must differ from start; a zero-length window is not a shift.\", \"warning\")\n\t\treturn\n\n\tif mode == \"create\":\n\t\tlocId = draft.get(\"locationId\")\n\t\tschedId = draft.get(\"shiftScheduleId\")\n\t\tdateVal = draft.get(\"businessDateVal\")\n\t\tif locId is None or schedId is None or dateVal is None:\n\t\t\tBlueRidge.Common.Notify.toast(\"Cannot save\", \"Equipment, shift and date are all required.\", \"warning\")\n\t\t\treturn\n\t\tif isinstance(dateVal, (int, long, float)):\n\t\t\tdateVal = system.date.fromMillis(long(dateVal))\n\t\tresult = BlueRidge.Oee.ShiftOverride.add({\n\t\t\t\"locationId\": locId,\n\t\t\t\"shiftScheduleId\": schedId,\n\t\t\t\"businessDate\": system.date.format(dateVal, \"yyyy-MM-dd\"),\n\t\t\t\"startTime\": st,\n\t\t\t\"endTime\": et,\n\t\t\t\"reason\": (draft.get(\"reason\") or \"\").strip()\n\t\t})\n\t\tBlueRidge.Common.Ui.notifyResult(result, \"Shift override created\")\n\telse:\n\t\tresult = BlueRidge.Oee.ShiftOverride.update({\n\t\t\t\"id\": draft.get(\"id\"),\n\t\t\t\"startTime\": st,\n\t\t\t\"endTime\": et,\n\t\t\t\"reason\": (draft.get(\"reason\") or \"\").strip()\n\t\t})\n\t\tBlueRidge.Common.Ui.notifyResult(result, \"Shift override updated\")\n\n\tif result and result.get(\"Status\"):\n\t\tsystem.perspective.sendMessage(\"shiftOverridesRefresh\", scope=\"page\")\n\t\tsystem.perspective.closePopup(id=\"mpp-shift-override-editor\")"
        },
        {
          "name": "handleClose",
          "params": [],
          "script": "\t# JSON-compare BOTH sides (never a raw != on the wrapper objects, and never\n\t# str()) -- Perspective wrapper equality is unreliable.\n\ttoJson = BlueRidge.Common.Util.convertWrapperObjectToJson\n\tif toJson(self.view.custom.editDraft) == toJson(self.view.custom.selected):\n\t\tsystem.perspective.closePopup(id=\"mpp-shift-override-editor\")\n\telse:\n\t\tsystem.perspective.openPopup(\n\t\t\tid=\"mpp-confirm-unsaved\",\n\t\t\tview=\"BlueRidge/Components/Popups/ConfirmUnsaved\",\n\t\t\tmodal=True,\n\t\t\tshowCloseIcon=False,\n\t\t\tparams={\n\t\t\t\t\"title\": \"Unsaved Changes\",\n\t\t\t\t\"message\": \"You have unsaved changes to this shift override. Save before closing?\"\n\t\t\t}\n\t\t)"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "confirmUnsavedResult",
          "pageScope": true,
          "script": "\taction = payload.get(\"action\") if payload else None\n\tif action == \"save\":\n\t\tself.doSave()\n\telif action == \"discard\":\n\t\tsystem.perspective.closePopup(id=\"mpp-shift-override-editor\")",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "confirmDestructiveResult",
          "pageScope": true,
          "script": "\tif not (payload and payload.get(\"action\") == \"confirm\"):\n\t\treturn\n\tdraft = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.editDraft.get(\"meta\", {})) or {}\n\toverrideId = draft.get(\"id\")\n\tif overrideId is None:\n\t\treturn\n\tresult = BlueRidge.Oee.ShiftOverride.deprecate(overrideId)\n\tBlueRidge.Common.Ui.notifyResult(result, \"Shift override removed\")\n\tif result and result.get(\"Status\"):\n\t\tsystem.perspective.sendMessage(\"shiftOverridesRefresh\", scope=\"page\")\n\t\tsystem.perspective.closePopup(id=\"mpp-shift-override-editor\")",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
