{
  "custom": {},
  "params": {
    "deviceCode": "",
    "deviceTypeName": "",
    "id": null,
    "index": 0,
    "plcDeviceTypeId": null,
    "sortOrder": null,
    "udtInstancePath": ""
  },
  "propConfig": {
    "params.deviceCode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.deviceTypeName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.index": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plcDeviceTypeId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sortOrder": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.udtInstancePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 60,
      "width": 640
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "RowCode"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "coalesce({view.params.deviceCode}, \"\") + \"  (\" + coalesce({view.params.deviceTypeName}, \"\") + \")\""
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "RowPath"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.udtInstancePath}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-muted"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Info"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "2px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"plcMappingEdit\", {\"id\": self.view.params.id, \"plcDeviceTypeId\": self.view.params.plcDeviceTypeId, \"deviceCode\": self.view.params.deviceCode, \"udtInstancePath\": self.view.params.udtInstancePath, \"sortOrder\": self.view.params.sortOrder}, scope\u003d\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "EditBtn"
        },
        "props": {
          "style": {
            "classes": "btn"
          },
          "text": "Edit"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"plcMappingDeprecate\", {\"id\": self.view.params.id}, scope\u003d\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "DeprecateBtn"
        },
        "props": {
          "style": {
            "classes": "btn btn-danger"
          },
          "text": "Remove"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "space-between",
      "style": {
        "classes": "surface-card",
        "gap": "10px",
        "padding": "8px"
      }
    },
    "type": "ia.container.flex"
  }
}