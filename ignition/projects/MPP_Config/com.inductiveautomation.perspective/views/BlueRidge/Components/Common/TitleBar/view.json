{
  "custom": {},
  "params": {
    "category": "",
    "howToPopupId": "",
    "howToViewPath": "",
    "title": ""
  },
  "propConfig": {
    "params.category": {
      "paramDirection": "input"
    },
    "params.howToPopupId": {
      "paramDirection": "input"
    },
    "params.howToViewPath": {
      "paramDirection": "input"
    },
    "params.title": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 60,
      "width": 1200
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "BreadcrumbCategory"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.category"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "breadcrumb"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "BreadcrumbSep"
                },
                "props": {
                  "style": {
                    "classes": "breadcrumb crumb-sep"
                  },
                  "text": "›"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "BreadcrumbActive"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.title"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "crumb-active"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "Breadcrumb"
            },
            "props": {
              "alignItems": "center",
              "style": {
                "classes": "breadcrumb"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Title"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "title-row-h1"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "TitleColumn"
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "2px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "TitleRowSpacer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "classes": "title-row-spacer"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.openPopup(self.view.params.howToPopupId,\n\t\tself.view.params.howToViewPath,\n\t\tparams\u003d{\u0027popupId\u0027: self.view.params.howToPopupId},\n\t\tposition\u003d{\u0027width\u0027: \u002754%\u0027, \u0027height\u0027: \u002792%\u0027},\n\t\tmodal\u003dFalse, overlayDismiss\u003dFalse, showCloseIcon\u003dFalse)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "HowToButton",
          "tooltip": {
            "text": "How To"
          }
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "path": "material/help_outline",
          "style": {
            "cursor": "pointer",
            "height": "35px",
            "width": "35px"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "background": "var(--mpp-surface-raised)",
        "borderBottom": "1px solid var(--mpp-border-subtle)",
        "classes": "title-row",
        "paddingBottom": "8px"
      }
    },
    "type": "ia.container.flex"
  }
}