{
  "custom": {},
  "params": {
    "id": null,
    "code": "",
    "part": "",
    "learned": ""
  },
  "propConfig": {
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.code": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.part": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.learned": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 640
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "RowCode"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Scale code \" + {view.params.code} + \"  ->  \" + {view.params.part}"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "RowLearned"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.learned}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-muted"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Info"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "2px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"scalePartCodeRemove\", {\"id\": self.view.params.id}, scope=\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "RemoveBtn"
        },
        "props": {
          "style": {
            "classes": "btn btn-danger"
          },
          "text": "Remove"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "space-between",
      "style": {
        "classes": "surface-card",
        "gap": "10px",
        "padding": "8px"
      }
    },
    "type": "ia.container.flex"
  }
}
