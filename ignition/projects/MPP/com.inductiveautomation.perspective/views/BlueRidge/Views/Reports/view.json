    "scripts": {
      "customMethods": [
        {
          "name": "selectReport",
          "params": [
            "key",
            "title",
            "desc",
            "reportPath",
            "available"
          ],
          "script": "\ttry:\n\t\tself.view.custom.selectedKey = key\n\t\tself.view.custom.selectedTitle = title\n\t\tself.view.custom.selectedDesc = desc\n\t\tif not available:\n\t\t\tBlueRidge.Common.Notify.toast(title, \"This report is coming soon.\", \"info\")\n\t\t\treturn\n\t\tself.view.custom.reportSource = reportPath\n\t\tif key == \"downtime_range\" and not self.view.custom.rangeStart:\n\t\t\tend = system.date.now()\n\t\t\tself.view.custom.rangeEnd = end\n\t\t\tself.view.custom.rangeStart = system.date.addDays(end, -7)\n\texcept Exception as e:\n\t\tBlueRidge.Common.Notify.toast(\"Report error\", str(e), \"error\")"
        },
        {
          "name": "printPdf",
          "params": [],
          "script": "\ttry:\n\t\tsrc = self.view.custom.reportSource\n\t\tsel = self.view.custom.selectedKey\n\t\tparams = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.reportParams) or {}\n\t\tif sel == \"downtime_shift\" and not params.get(\"ShiftId\"):\n\t\t\tBlueRidge.Common.Notify.toast(\"Pick a shift\", \"Select a shift before printing.\", \"warn\")\n\t\t\treturn\n\t\tif sel == \"downtime_range\" and not params.get(\"StartDate\"):\n\t\t\tBlueRidge.Common.Notify.toast(\"Pick dates\", \"Select a date range before printing.\", \"warn\")\n\t\t\treturn\n\t\tif not src:\n\t\t\tBlueRidge.Common.Notify.toast(\"No report\", \"Select a report first.\", \"warn\")\n\t\t\treturn\n\t\tdata = system.report.executeReport(src, \"MPP\", params, \"pdf\")\n\t\tsystem.perspective.download(src + \".pdf\", data)\n\texcept Exception as e:\n\t\tBlueRidge.Common.Notify.toast(\"Print failed\", str(e), \"error\")"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": null
    },
    "type": "ia.container.flex"
  }
