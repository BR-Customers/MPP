{
  "custom": {},
  "params": {},
  "propConfig": {
    "custom.openCount": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.Downtime.getByScope\", 30000, {view.custom.scopeLocationId}, true, null)"
        },
        "transforms": [
          {
            "code": "\treturn len([r for r in (value or []) if r.get(\"IsOpen\")])",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.scopeLocationId": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.Downtime.resolveScope\", 0, {session.custom.cell.locationId})"
        },
        "type": "expr"
      }
    },
    "custom.shift": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.Shift.getOpenOrEmpty\", 15000)"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 88,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.openPopup(id\u003d\"mpp-app-menu\", view\u003d\"BlueRidge/Components/Popups/AppMenu\", modal\u003dTrue, showCloseIcon\u003dFalse)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "MenuButton",
          "tooltip": {
            "text": "Menu"
          }
        },
        "position": {
          "basis": "55px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "fontSize": "18px",
            "minWidth": "44px"
          },
          "text": "≡"
        },
        "type": "ia.input.button"
      },
      {
        "children": [
          {
            "meta": {
              "name": "TerminalName"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if(isNull({session.custom.terminal.terminalName}) || {session.custom.terminal.terminalName} \u003d \"\", \"Madison Facility\", {session.custom.terminal.terminalName})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-app-title",
                "lineHeight": "1.25",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "ScopeName"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if(isNull({session.custom.terminal.zoneName}) || {session.custom.terminal.zoneName} \u003d \"\", \"\", {session.custom.terminal.zoneName})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-banner-detail",
                "lineHeight": "1.25",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "BrandCol"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "2px",
            "marginLeft": "8px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Clock"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "dateFormat(now(1000), \"EEE MMM d   h:mm:ss a\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-banner-detail",
                "fontVariantNumeric": "tabular-nums",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "ShiftLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Shift: \" + if(isNull({view.custom.shift.ScheduleName}) || {view.custom.shift.ScheduleName} \u003d \"\", \"none\", {view.custom.shift.ScheduleName})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-banner-detail",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Operator"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Operator: \" + if(isNull({session.custom.user.initials}) || {session.custom.user.initials} \u003d \"\", \"--\", {session.custom.user.initials})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-banner-detail",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "ContextCluster"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "20px",
            "marginLeft": "16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Spacer"
        },
        "position": {
          "grow": 1
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "LineDownPill"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.openCount} \u003e 0"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"● LINE DOWN · \" + toStr({view.custom.openCount})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "dt-open-badge"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(id\u003d\"mpp-downtime-manager\", view\u003d\"BlueRidge/Components/Popups/DowntimeManager\", modal\u003dTrue, showCloseIcon\u003dFalse, params\u003d{})"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "DowntimeButton"
            },
            "position": {
              "basis": "112px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary"
              },
              "text": "Downtime"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.login()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ElevatedLoginButton"
            },
            "position": {
              "basis": "142px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Elevated Login"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "RightCluster"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "8px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "pf-header",
        "height": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}