                    "type": "ia.display.flex-repeater",
                    "meta": {
                      "name": "HeldLotsRepeater"
                    },
                    "position": {
                      "basis": "0",
                      "grow": 1
                    },
                    "propConfig": {
                      "props.instances": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({view.custom.selectedHoldEventId} >= 0, {view.custom.heldLots}, {view.custom.heldLots})"
                          },
                          "transforms": [
                            {
                              "type": "script",
                              "code": "\tsel = int(self.view.custom.selectedHoldEventId or 0)\n\trows = []\n\tfor r in (value or []):\n\t\trows.append({\"holdEventId\": r.get(\"HoldEventId\"), \"lotId\": r.get(\"LotId\") or 0, \"containerId\": 0, \"label\": r.get(\"LotName\") or (\"LOT #\" + str(r.get(\"LotId\"))), \"holdTypeCode\": r.get(\"HoldTypeCode\") or \"\", \"reason\": r.get(\"Reason\") or \"\", \"placedByInitials\": r.get(\"PlacedByInitials\") or \"\", \"placedAt\": (str(r.get(\"PlacedAt\")) if r.get(\"PlacedAt\") else \"\"), \"selectedHoldEventId\": sel})\n\treturn rows"
                            }
                          ]
                        }
                      }
                    },
                    "props": {
                      "direction": "column",
                      "elementPosition": {
                        "basis": "72px",
                        "shrink": 0
                      },
                      "path": "BlueRidge/Components/PlantFloor/Quality/HoldListRow"
                    }
