                    "meta": {
                      "name": "InspectButton",
                      "tooltip": {
                        "text": "Open the Inspection terminal for the selected held LOT."
                      }
                    },
                    "position": {
                      "shrink": 0,
                      "display": false
                    },
                    "propConfig": {
                      "position.display": {
                        "binding": {
                          "config": {
                            "expression": "{view.custom.selectedLotId} > 0"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "Inspect",
                      "style": {
                        "classes": "pf-btn pf-btn-secondary"
                      }
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "type": "script",
                          "scope": "G",
                          "config": {
                            "script": "\tlotName = self.view.custom.selectedLotName\n\tif not lotName:\n\t\treturn\n\tsystem.perspective.navigate(\"/shop-floor/inspection\", params={\"lotName\": lotName, \"returnRoute\": \"/shop-floor/sort-cage\"})"
