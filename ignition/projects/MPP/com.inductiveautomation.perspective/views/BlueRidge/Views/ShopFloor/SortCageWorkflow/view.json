                          "scope": "G",
                          "config": {
                            "script": "\tself.view.custom.selectedHoldEventId = 0\n\tself.view.custom.selectedLotId = None\n\tself.view.custom.selectedLotName = \"\"\n\tsystem.perspective.sendMessage(\"holdPanelLoad\", payload={\"lotId\": 0, \"containerId\": 0, \"allowLookup\": True}, scope=\"page\")"
                          }
                        }
                      }
                    }
                  },
                  {
