{
  "custom": {
    "refreshToken": 0
  },
  "params": {},
  "propConfig": {
    "custom.activeMachined": {
      "binding": {
        "config": {
          "expression": "if({view.custom.refreshToken} \u003e\u003d 0 \u0026\u0026 !isNull({session.custom.cell.locationId}), runScript(\"BlueRidge.Lots.Lot.getWipQueueByLocation\", 0, {session.custom.cell.locationId}, true, {view.custom.refreshToken}), \"\")"
        },
        "transforms": [
          {
            "code": "\tmachined \u003d value or []\n\tr \u003d machined[-1] if machined else {}\n\treturn {\"Id\": r.get(\"Id\"), \"lotName\": r.get(\"LotName\") or \"\", \"itemPartNumber\": r.get(\"ItemPartNumber\") or \"\", \"pieceCount\": r.get(\"PieceCount\") or 0}",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.holdCount": {
      "binding": {
        "config": {
          "path": "view.custom.queue"
        },
        "transforms": [
          {
            "code": "\treturn len([r for r in (value or []) if (r.get(\"lotStatusCode\") or \"\") !\u003d \"Good\"])",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.queue": {
      "binding": {
        "config": {
          "expression": "if({view.custom.refreshToken} \u003e\u003d 0 \u0026\u0026 !isNull({session.custom.cell.locationId}), runScript(\"BlueRidge.Lots.Lot.getTrimStorageQueueForLine\", 0, {session.custom.cell.locationId}, {view.custom.refreshToken}), \"\")"
        },
        "transforms": [
          {
            "code": "\t#return value\n\trows \u003d value or []\n\treturn [{\"sourceLotId\": r.get(\"Id\"), \"lotName\": r.get(\"LotName\") or \"\", \"sourceItem\": r.get(\"ItemPartNumber\") or \"\", \"pieceCount\": r.get(\"PieceCount\") or 0, \"arrival\": str(r.get(\"LastMovementAt\") or \"\"), \"position\": i + 1, \"lotStatusCode\": r.get(\"LotStatusCode\") or \"\"} for i, r in enumerate(rows)]",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "style": {
                    "fontSize": "22px",
                    "fontWeight": 700
                  },
                  "text": "Machining IN"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Subtitle"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if(isNull({session.custom.cell.name}) || {session.custom.cell.name} \u003d \"\", \"No cell bound\", {session.custom.cell.name}) + \"  ·  5G0 Machining WC - dedicated terminal - whole-LOT FIFO pick\""
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-kpi-sub"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "TitleBlock"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "direction": "column"
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\"mpp-initials\", \"BlueRidge/Components/Popups/InitialsEntry\", params\u003d{\"popupId\": \"mpp-initials\"}, modal\u003dTrue, showCloseIcon\u003dTrue, overlayDismiss\u003dTrue)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "OperatorLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Operator: \" + if(isNull({session.custom.user.displayName}) || {session.custom.user.displayName} \u003d \"\", if(isNull({session.custom.user.initials}), \"-\", {session.custom.user.initials}), {session.custom.user.displayName})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub",
                "cursor": "pointer"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "PausedLabel"
                },
                "props": {
                  "style": {
                    "fontSize": "13px",
                    "fontWeight": "500"
                  },
                  "text": "On Hold"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "PausedCount"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "toStr({view.custom.holdCount})"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-paused-indicator-count"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "PausedIndicator"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.holdCount} \u003e 0"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "alignItems": "center",
              "style": {
                "classes": "pf-paused-indicator",
                "gap": "8px",
                "padding": "8px 14px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.refreshToken \u003d (self.view.custom.refreshToken or 0) + 1"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "RefreshButton",
              "tooltip": {
                "text": "Refresh"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Refresh"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\"mpp-inventory\", \"BlueRidge/Components/PlantFloor/InventoryManager\", params\u003d{\"locationId\": self.session.custom.cell.locationId}, modal\u003dFalse, showCloseIcon\u003dTrue, draggable\u003dTrue, resizable\u003dTrue)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "InventoryButton",
              "tooltip": {
                "text": "Check component / pass-through inventory in to this line"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Inventory"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\"mpp-scrap-entry\", \"BlueRidge/Components/Popups/ScrapEntry\", params={\"cellLocationId\": self.session.custom.cell.locationId, \"operationTypeCode\": \"MachiningIn\", \"popupId\": \"mpp-scrap-entry\"}, modal=True, showCloseIcon=True)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ScrapButton",
              "tooltip": {
                "text": "Record scrap against a LOT at this line"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Scrap"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CloseButton"
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "16px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "QueueTitle"
                },
                "props": {
                  "style": {
                    "color": "var(--mpp-text-secondary)",
                    "fontSize": "14px",
                    "fontWeight": "600",
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase"
                  },
                  "text": "Start Machining"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "QueueSub"
                },
                "props": {
                  "style": {
                    "classes": "pf-kpi-sub"
                  },
                  "text": "Scan the LTT to start machining at this line."
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "QueueHeader"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "alignItems": "flex-start",
                "classes": "pf-panel-header",
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "PickScan"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.params.cellLocationId": {
                "binding": {
                  "config": {
                    "path": "session.custom.cell.locationId"
                  },
                  "type": "property"
                }
              },
              "props.params.terminalLocationId": {
                "binding": {
                  "config": {
                    "path": "session.custom.terminal.terminalLocationId"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "replyMessage": "machiningPicked"
              },
              "path": "BlueRidge/Components/PlantFloor/MachiningPickScan"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "QueuePanel"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "pf-panel",
            "gap": "12px",
            "overflow": "hidden",
            "padding": "14px 16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "ActiveTitle"
                },
                "props": {
                  "style": {
                    "color": "var(--mpp-text-secondary)",
                    "fontSize": "14px",
                    "fontWeight": "600",
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase"
                  },
                  "text": "Active machined LOT (after pick)"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "ActiveHeader"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-panel-header"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "ActiveEmptyText"
                },
                "props": {
                  "style": {
                    "fontSize": "13px",
                    "maxWidth": "480px",
                    "textAlign": "center"
                  },
                  "text": "No LOT picked yet. Scan an LTT above to start machining at this line."
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "ActiveEmpty"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "isNull({view.custom.activeMachined.Id})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "alignItems": "center",
              "direction": "column",
              "justify": "center",
              "style": {
                "classes": "pf-empty-state",
                "gap": "8px",
                "padding": "32px 24px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "ActiveCardName"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if(isNull({view.custom.activeMachined.lotName}) || {view.custom.activeMachined.lotName} \u003d \"\", \"(machined LOT)\", {view.custom.activeMachined.lotName})"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-kpi-value",
                    "fontSize": "18px"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ActiveCardSub"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "{view.custom.activeMachined.itemPartNumber} + \"  |  \" + toStr({view.custom.activeMachined.pieceCount}) + \" pcs  |  machined LOT #\" + toStr({view.custom.activeMachined.Id})"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-kpi-sub"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "ActiveCard"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "!isNull({view.custom.activeMachined.Id})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "direction": "column",
              "style": {
                "backgroundColor": "var(--mpp-surface-raised)",
                "border": "1px solid var(--mpp-border-default)",
                "borderRadius": "8px",
                "gap": "6px",
                "padding": "16px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "ActiveLotPanel"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "pf-panel",
            "gap": "12px",
            "padding": "14px 16px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\t# Dedicated-flavor context (FDS-02-010): bind the cell to the terminal\u0027s parent line.\n\tt \u003d self.session.custom.terminal\n\tif t and t.get(\"zoneLocationId\"):\n\t\tself.session.custom.cell \u003d {\"locationId\": t.get(\"zoneLocationId\"), \"code\": t.get(\"zoneName\") or \"\", \"name\": t.get(\"zoneName\") or \"\"}\n\ttry:\n\t\tself.session.custom.presence.policy \u003d \"confirm\"\n\texcept:\n\t\tself.session.custom.presence \u003d {\"policy\": \"confirm\"}\n\tif not self.session.custom.appUserId:\n\t\tsystem.perspective.openPopup(\"mpp-initials\", \"BlueRidge/Components/Popups/InitialsEntry\", params\u003d{\"popupId\": \"mpp-initials\"}, modal\u003dTrue, showCloseIcon\u003dFalse, overlayDismiss\u003dFalse)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "canvas",
        "gap": "16px",
        "overflowY": "auto",
        "padding": "24px"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "machiningPicked",
          "pageScope": true,
          "script": "\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "inventoryChanged",
          "pageScope": true,
          "script": "\tloc \u003d (payload or {}).get(\"cellLocationId\")\n\tmyCell \u003d None\n\ttry:\n\t\tmyCell \u003d self.session.custom.cell.locationId\n\texcept:\n\t\tmyCell \u003d None\n\tif loc is None or loc \u003d\u003d myCell:\n\t\tself.view.custom.refreshToken \u003d (self.view.custom.refreshToken or 0) + 1",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}
