{
  "custom": {
    "aimDepth": 0,
    "pausedCount": 0,
    "plantAvail": {
      "AvailabilityPct": "",
      "DowntimeMinutes": 0,
      "EquipmentCount": 0,
      "HasData": false,
      "PlannedMinutes": 0,
      "RunMinutes": 0,
      "ScheduleName": "",
      "ShiftId": null
    }
  },
  "params": {},
  "propConfig": {
    "custom.aimDepth": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Lots.AimPool.getDepthOrZero\", 0)"
        },
        "type": "expr"
      }
    },
    "custom.openSummary": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.DowntimeEvent.getOpenSummary\", 0)"
        },
        "type": "expr"
      }
    },
    "custom.pausedCount": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Lots.LotPause.getOpenCount\", 0)"
        },
        "type": "expr"
      }
    },
    "custom.plantAvail": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.ShiftOverride.plantAvailabilityOrEmpty\", 0)"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "borderBottom": "1px solid var(--mpp-border-subtle)",
            "fontSize": "22px",
            "fontWeight": "700",
            "padding": "16px"
          },
          "text": "Supervisor Dashboard"
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "L"
                },
                "props": {
                  "style": {
                    "classes": "pf-kpi-label"
                  },
                  "text": "Open Downtime"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "V"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "toStr(coalesce({view.custom.openSummary.TotalOpen}, 0))"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-kpi-value"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "S"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "toStr(coalesce({view.custom.openSummary.WithoutReason}, 0)) + \" need a reason\""
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-kpi-sub"
                  }
                },
                "type": "ia.display.label"
              }
