                            "props": {
                              "placeholder": "Select defect code",
                              "style": { "classes": "pf-field-input" }
                            }
                          }
                        ]
                      },
                      {
                        "type": "ia.container.flex",
                        "meta": { "name": "ScrapRemarksField" },
                        "position": { "basis": "0", "grow": 1 },
                        "props": {
                          "direction": "column",
                          "style": { "classes": "pf-field", "gap": "4px" }
                        },
                        "children": [
                          {
                            "type": "ia.display.label",
                            "meta": { "name": "L" },
                            "props": { "text": "Remarks", "style": { "classes": "pf-field-label" } }
                          },
                          {
                            "type": "ia.input.text-field",
                            "meta": { "name": "ScrapRemarks" },
                            "propConfig": {
                              "props.text": {
                                "binding": {
                                  "type": "property",
                                  "config": { "bidirectional": true, "path": "view.custom.scrapDraft.remarks" }
                                }
                              }
                            },
                            "props": {
                              "deferUpdates": false,
                              "placeholder": "Optional remarks",
                              "style": { "classes": "pf-field-input" }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "ia.input.button",
                    "meta": { "name": "ScrapButton" },
                    "position": { "shrink": 0 },
                    "props": {
                      "text": "Record Scrap",
                      "style": { "classes": "pf-btn pf-btn-primary pf-btn-large" }
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "type": "script",
                          "scope": "G",
                          "config": { "script": "\td = self.view.custom.scrapDraft\n\tlotName = (d.get(\"lotName\") or \"\").strip()\n\tqty = BlueRidge.Common.Util.toIntOrNone(d.get(\"quantity\"))\n\tdefectId = d.get(\"defectCodeId\")\n\tremarks = (d.get(\"remarks\") or \"\").strip() or None\n\tif not lotName:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Enter a LOT name.\"}, \"Scrap Held LOT\")\n\t\treturn\n\tif defectId is None:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Select a defect code.\"}, \"Scrap Held LOT\")\n\t\treturn\n\tif qty is None or qty <= 0:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Enter a reject quantity greater than zero.\"}, \"Scrap Held LOT\")\n\t\treturn\n\tlot = BlueRidge.Lots.Lot.getByName(lotName)\n\tif not lot or lot.get(\"Id\") is None:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"No LOT found named '\" + lotName + \"'.\"}, \"Scrap Held LOT\")\n\t\treturn\n\tlotId = lot.get(\"Id\")\n\theld = BlueRidge.Quality.Hold.getOpenByLotOne(lotId)\n\tif not (held and held.get(\"IsHeld\")):\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"LOT '\" + lotName + \"' is not on hold. Use the normal scrap flow for un-held LOTs.\"}, \"Scrap Held LOT\")\n\t\treturn\n\tresult = BlueRidge.Workorder.RejectEvent.record({\"lotId\": lotId, \"defectCodeId\": defectId, \"quantity\": qty, \"remarks\": remarks}, allowHeldLot=True)\n\tBlueRidge.Common.Ui.notifyResult(result, \"Scrap recorded\")\n\tif result and result.get(\"Status\"):\n\t\tself.view.custom.scrapDraft = {\"lotName\": \"\", \"defectCodeId\": None, \"quantity\": \"\", \"remarks\": \"\"}\n\t\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1" }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
