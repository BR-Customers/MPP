                            "props": {
                              "deferUpdates": false,
                              "placeholder": "0",
                              "style": { "classes": "pf-field-input" }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "ia.container.flex",
                    "meta": { "name": "ScrapRow2" },
                    "position": { "shrink": 0 },
                    "props": {
                      "alignItems": "flex-end",
                      "wrap": "wrap",
