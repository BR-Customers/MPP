                    "type": "ia.container.flex",
                    "meta": { "name": "ScrapRow1" },
                    "position": { "shrink": 0 },
                    "props": {
                      "alignItems": "flex-end",
                      "wrap": "wrap",
                      "style": { "gap": "12px" }
                    },
                    "children": [
                      {
