{
  "custom": {
    "bulkHoldTypeId": null,
    "bulkQuery": "",
    "bulkReason": "",
    "bulkResults": [],
    "bulkSelectedLotIds": [],
    "filterText": "",
    "filterTypeId": null,
    "holdTypeOptions": [
      { "label": "Quality", "value": 1 },
      { "label": "Customer Complaint", "value": 2 },
      { "label": "Precautionary", "value": 3 }
    ],
    "refreshToken": 0,
    "selectedHoldEventId": 0,
    "scrapDraft": {
      "lotName": "",
      "defectCodeId": null,
      "quantity": "",
      "remarks": ""
    },
    "defectOptions": []
  },
  "params": {},
  "propConfig": {
    "custom.defectOptions": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Quality.DefectCode.getForDropdown\")"
        },
        "type": "expr"
      }
    },
    "custom.openHolds": {
      "binding": {
        "config": {
          "expression": "if({view.custom.refreshToken} >= 0, runScript(\"BlueRidge.Quality.Hold.listOpen\", 0, {view.custom.filterText}, {view.custom.filterTypeId}, {view.custom.refreshToken}), \"\")"
        },
        "transforms": [
          { "code": "\treturn value or []", "type": "script" }
        ],
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": { "width": 1280 }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "direction": "column",
      "style": { "classes": "canvas", "gap": "16px", "padding": "24px" }
    },
    "scripts": {
      "customMethods": null,
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "holdRowSelected",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\the = payload.get(\"holdEventId\")\n\tself.view.custom.selectedHoldEventId = int(he) if he else 0\n\tsystem.perspective.sendMessage(\"holdPanelLoad\", payload={\"lotId\": payload.get(\"lotId\") or 0, \"containerId\": payload.get(\"containerId\") or 0, \"allowLookup\": False}, scope=\"page\")"
        },
        {
          "messageType": "holdChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tself.view.custom.selectedHoldEventId = 0\n\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1\n\tsystem.perspective.sendMessage(\"holdPanelLoad\", payload={\"lotId\": 0, \"containerId\": 0, \"allowLookup\": True}, scope=\"page\")"
        },
        {
          "messageType": "bulkToggle",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tlid = payload.get(\"lotId\")\n\tif lid is None:\n\t\treturn\n\tlid = int(lid)\n\tcur = [int(x) for x in (self.view.custom.bulkSelectedLotIds or [])]\n\tif lid in cur:\n\t\tcur.remove(lid)\n\telse:\n\t\tcur.append(lid)\n\tself.view.custom.bulkSelectedLotIds = cur"
        }
      ]
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": { "name": "Header" },
        "props": {
          "alignItems": "center",
          "style": { "gap": "16px", "overflow": "hidden" }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": { "name": "TitleBlock" },
            "position": { "grow": 1 },
            "props": { "direction": "column" },
            "children": [
              {
                "type": "ia.display.label",
                "meta": { "name": "Title" },
                "props": {
                  "text": "Hold Management",
                  "style": { "fontSize": "22px", "fontWeight": 700 }
                }
              },
              {
                "type": "ia.display.label",
                "meta": { "name": "Subtitle" },
                "props": {
                  "text": "Place and release holds on LOTs / Containers - AD-elevated action",
                  "style": { "classes": "pf-kpi-sub" }
                }
              }
            ]
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "RefreshButton", "tooltip": { "text": "Refresh" } },
            "position": { "shrink": 0 },
            "props": {
              "text": "Refresh",
              "style": { "classes": "pf-btn pf-btn-secondary" }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": { "script": "\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1" }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "CloseButton" },
            "props": {
              "text": "Close",
              "style": { "classes": "pf-btn pf-btn-secondary" }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": { "script": "\tsystem.perspective.navigate(\"/\")" }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.tab",
        "meta": { "name": "TabContainer" },
        "position": { "grow": 1, "basis": "0" },
        "props": {
          "currentTabIndex": 0,
          "menuType": "modern",
          "tabs": [
            { "text": "Open Holds", "runWhileHidden": true, "disabled": false },
            { "text": "Bulk & Scrap", "runWhileHidden": true, "disabled": false }
          ],
          "menuStyle": { "classes": "tab-strip" },
          "contentStyle": { "classes": "tab-content-fill" },
          "tabStyle": {
            "active": { "classes": "tab-item tab-item-active" },
            "inactive": { "classes": "tab-item" },
            "disabled": { "classes": "tab-item" }
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": { "name": "OpenHoldsPane" },
            "position": { "tabIndex": 0 },
            "props": {
              "direction": "row",
              "wrap": "wrap",
              "style": { "gap": "16px", "padding": "16px" }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": { "name": "MasterCol" },
                "position": { "basis": "0", "grow": 1 },
                "props": {
                  "direction": "column",
                  "style": { "classes": "pf-panel", "gap": "12px", "padding": "16px" }
                },
                "children": [
                  {
                    "type": "ia.container.flex",
                    "meta": { "name": "FilterRow" },
                    "position": { "shrink": 0 },
                    "props": {
                      "alignItems": "flex-end",
                      "wrap": "wrap",
                      "style": { "gap": "12px" }
                    },
                    "children": [
                      {
                        "type": "ia.container.flex",
                        "meta": { "name": "FilterField" },
                        "position": { "basis": "0", "grow": 1 },
                        "props": {
                          "direction": "column",
                          "style": { "classes": "pf-field", "gap": "4px" }
                        },
                        "children": [
                          {
                            "type": "ia.display.label",
                            "meta": { "name": "L" },
                            "props": { "text": "Filter", "style": { "classes": "pf-field-label" } }
                          },
                          {
                            "type": "ia.input.text-field",
                            "meta": { "name": "FilterInput" },
                            "propConfig": {
                              "props.text": {
                                "binding": {
                                  "type": "property",
                                  "config": { "bidirectional": true, "path": "view.custom.filterText" }
                                }
                              }
                            },
                            "props": {
                              "placeholder": "LotName, AIM Shipper ID, Item, Location...",
                              "style": { "classes": "pf-field-input" }
                            }
                          }
                        ]
                      },
                      {
                        "type": "ia.container.flex",
                        "meta": { "name": "FilterTypeField" },
                        "position": { "basis": "220px", "shrink": 0 },
                        "props": {
                          "direction": "column",
                          "style": { "classes": "pf-field", "gap": "4px" }
                        },
                        "children": [
                          {
                            "type": "ia.display.label",
                            "meta": { "name": "L" },
                            "props": { "text": "Hold Type", "style": { "classes": "pf-field-label" } }
                          },
                          {
                            "type": "ia.input.dropdown",
                            "meta": { "name": "FilterType" },
                            "propConfig": {
                              "props.options": {
                                "binding": {
                                  "type": "property",
                                  "config": { "path": "view.custom.holdTypeOptions" }
                                }
                              },
                              "props.value": {
                                "binding": {
                                  "type": "property",
                                  "config": { "bidirectional": true, "path": "view.custom.filterTypeId" }
                                }
                              }
                            },
                            "props": {
                              "placeholder": "All hold types",
                              "style": { "classes": "pf-field-input" }
                            }
                          }
                        ]
                      },
                      {
                        "type": "ia.input.button",
                        "meta": { "name": "NewHoldButton" },
                        "position": { "shrink": 0 },
                        "props": {
                          "text": "New hold",
                          "style": { "classes": "pf-btn pf-btn-secondary" }
                        },
                        "events": {
                          "component": {
                            "onActionPerformed": {
                              "type": "script",
                              "scope": "G",
                              "config": { "script": "\tself.view.custom.selectedHoldEventId = 0\n\tsystem.perspective.sendMessage(\"holdPanelLoad\", payload={\"lotId\": 0, \"containerId\": 0, \"allowLookup\": True}, scope=\"page\")" }
                            }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "ia.display.flex-repeater",
                    "meta": { "name": "OpenHoldsRepeater" },
                    "position": { "basis": "0", "grow": 1 },
                    "propConfig": {
                      "props.instances": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({view.custom.selectedHoldEventId} >= 0, {view.custom.openHolds}, {view.custom.openHolds})"
                          },
                          "transforms": [
                            {
                              "type": "script",
                              "code": "\tsel = int(self.view.custom.selectedHoldEventId or 0)\n\trows = []\n\tfor r in (value or []):\n\t\tif r.get(\"LotId\") is not None:\n\t\t\tlabel = r.get(\"LotName\") or (\"LOT #\" + str(r.get(\"LotId\")))\n\t\telse:\n\t\t\tlabel = \"Container #\" + str(r.get(\"ContainerId\"))\n\t\t\tif r.get(\"ContainerItemPartNumber\"):\n\t\t\t\tlabel = label + \"  -  \" + r.get(\"ContainerItemPartNumber\")\n\t\trows.append({\"holdEventId\": r.get(\"HoldEventId\"), \"lotId\": r.get(\"LotId\") or 0, \"containerId\": r.get(\"ContainerId\") or 0, \"label\": label, \"holdTypeCode\": r.get(\"HoldTypeCode\") or \"\", \"reason\": r.get(\"Reason\") or \"\", \"placedByInitials\": r.get(\"PlacedByInitials\") or \"\", \"placedAt\": (str(r.get(\"PlacedAt\")) if r.get(\"PlacedAt\") else \"\"), \"selectedHoldEventId\": sel})\n\treturn rows"
                            }
                          ]
                        }
                      }
                    },
                    "props": {
                      "direction": "column",
                      "elementPosition": { "basis": "72px", "shrink": 0 },
                      "path": "BlueRidge/Components/PlantFloor/Quality/HoldListRow"
                    }
                  }
                ]
              },
              {
                "type": "ia.container.flex",
                "meta": { "name": "DetailCol" },
                "position": { "basis": "0", "grow": 1 },
                "props": {
                  "direction": "column",
                  "style": { "gap": "12px" }
                },
                "children": [
                  {
                    "type": "ia.display.view",
                    "meta": { "name": "HoldPanelEmbed" },
                    "position": { "grow": 1 },
                    "props": {
                      "path": "BlueRidge/Components/PlantFloor/Quality/HoldPanel",
                      "params": { "lotId": 0, "containerId": 0, "allowLookup": true }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": { "name": "BulkScrapPane" },
            "position": { "tabIndex": 1 },
            "props": {
              "direction": "column",
              "style": { "gap": "16px", "padding": "16px", "overflowY": "auto" }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": { "name": "BulkHoldPanel" },
                "position": { "shrink": 0 },
                "props": {
                  "direction": "column",
                  "style": { "classes": "pf-panel", "gap": "12px", "padding": "16px" }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": { "name": "BulkTitle" },
                    "position": { "shrink": 0 },
                    "props": {
                      "text": "Bulk Hold — search LOTs and place a hold on several at once",
                      "style": { "classes": "pf-panel-header" }
                    }
                  },
                  {
                    "type": "ia.container.flex",
                    "meta": { "name": "BulkSearchRow" },
                    "position": { "shrink": 0 },
                    "props": { "alignItems": "center", "gap": "10px" },
                    "children": [
                      {
                        "type": "ia.input.text-field",
                        "meta": { "name": "BulkQuery" },
                        "position": { "grow": 1 },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "type": "property",
                              "config": { "bidirectional": true, "path": "view.custom.bulkQuery" }
                            }
                          }
                        },
                        "props": {
                          "placeholder": "Search LOTs by name / part…",
                          "style": { "classes": "pf-field-input" }
                        }
                      },
                      {
                        "type": "ia.input.button",
                        "meta": { "name": "BulkSearchButton" },
                        "position": { "shrink": 0 },
                        "props": {
                          "text": "Search",
                          "style": { "classes": "pf-btn pf-btn-secondary" }
                        },
                        "events": {
                          "component": {
                            "onActionPerformed": {
                              "type": "script",
                              "scope": "G",
                              "config": { "script": "\tself.view.custom.bulkSelectedLotIds = []\n\tself.view.custom.bulkResults = BlueRidge.Lots.Lot.search(self.view.custom.bulkQuery or None, 1) or []" }
                            }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "ia.display.flex-repeater",
                    "meta": { "name": "BulkResultsRepeater" },
                    "position": { "basis": "0", "grow": 1 },
                    "propConfig": {
                      "props.instances": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if(len({view.custom.bulkSelectedLotIds}) >= 0, {view.custom.bulkResults}, {view.custom.bulkResults})"
                          },
                          "transforms": [
                            {
                              "type": "script",
                              "code": "\tsel = [int(x) for x in (self.view.custom.bulkSelectedLotIds or [])]\n\trows = []\n\tfor r in (value or []):\n\t\tlid = r.get(\"Id\")\n\t\trows.append({\"lotId\": lid, \"lotName\": r.get(\"LotName\") or \"?\", \"partNumber\": r.get(\"ItemPartNumber\") or \"\", \"statusCode\": r.get(\"LotStatusCode\") or \"\", \"locationName\": r.get(\"CurrentLocationName\") or \"\", \"selected\": (int(lid) in sel if lid is not None else False)})\n\treturn rows"
                            }
                          ]
                        }
                      }
                    },
                    "props": {
                      "direction": "column",
                      "elementPosition": { "basis": "64px", "shrink": 0 },
                      "path": "BlueRidge/Components/PlantFloor/Quality/BulkResultRow"
                    }
                  },
                  {
                    "type": "ia.container.flex",
                    "meta": { "name": "BulkActionRow" },
                    "position": { "shrink": 0 },
                    "props": { "alignItems": "center", "gap": "10px" },
                    "children": [
                      {
                        "type": "ia.input.dropdown",
                        "meta": { "name": "BulkHoldType" },
                        "position": { "basis": "200px", "shrink": 0 },
                        "propConfig": {
                          "props.options": {
                            "binding": {
                              "type": "property",
                              "config": { "path": "view.custom.holdTypeOptions" }
                            }
                          },
                          "props.value": {
                            "binding": {
                              "type": "property",
                              "config": { "bidirectional": true, "path": "view.custom.bulkHoldTypeId" }
                            }
                          }
                        },
                        "props": {
                          "placeholder": "Hold type",
                          "style": { "classes": "pf-field-input" }
                        }
                      },
                      {
                        "type": "ia.input.text-field",
                        "meta": { "name": "BulkReason" },
                        "position": { "grow": 1 },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "type": "property",
                              "config": { "bidirectional": true, "path": "view.custom.bulkReason" }
                            }
                          }
                        },
                        "props": {
                          "placeholder": "Reason (optional)",
                          "style": { "classes": "pf-field-input" }
                        }
                      },
                      {
                        "type": "ia.input.button",
                        "meta": { "name": "BulkPlaceButton" },
                        "position": { "shrink": 0 },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "type": "expr",
                              "config": { "expression": "\"Place hold on \" + len({view.custom.bulkSelectedLotIds}) + \" selected\"" }
                            }
                          }
                        },
                        "props": { "style": { "classes": "pf-btn pf-btn-primary" } },
                        "events": {
                          "component": {
                            "onActionPerformed": {
                              "type": "script",
                              "scope": "G",
                              "config": { "script": "\tids = self.view.custom.bulkSelectedLotIds or []\n\tif self.view.custom.bulkHoldTypeId is None:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Select a hold type.\"}, \"Bulk Hold\")\n\t\treturn\n\tif len(ids) == 0:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Select at least one LOT.\"}, \"Bulk Hold\")\n\t\treturn\n\treason = (self.view.custom.bulkReason or \"\").strip() or None\n\tres = BlueRidge.Quality.Hold.placeBulk(ids, self.view.custom.bulkHoldTypeId, reason)\n\tBlueRidge.Common.Ui.notifyResult(res, \"Bulk Hold\")\n\tif res and res.get(\"Status\"):\n\t\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1\n\t\tself.view.custom.bulkResults = []\n\t\tself.view.custom.bulkSelectedLotIds = []" }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "ia.container.flex",
