                            "props": { "text": "Defect code", "style": { "classes": "pf-field-label" } }
                          },
                          {
                            "type": "ia.input.dropdown",
                            "meta": { "name": "ScrapDefect" },
                            "propConfig": {
                              "props.options": {
                                "binding": {
                                  "type": "property",
                                  "config": { "path": "view.custom.defectOptions" }
