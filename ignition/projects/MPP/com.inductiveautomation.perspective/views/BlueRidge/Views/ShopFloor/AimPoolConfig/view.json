    "scripts": {
      "customMethods": [
        {
          "name": "load",
          "params": [],
          "script": "\trows \u003d BlueRidge.Lots.AimPoolConfig.get() or []\n\tr \u003d rows[0] if rows else {}\n\tdef _s(val):\n\t\treturn \"\" if val is None else (val if isinstance(val, basestring) else unicode(val))\n\tloaded \u003d {\n\t\t\"Id\":                     r.get(\"Id\"),\n\t\t\"TargetBufferDepth\":      _s(r.get(\"TargetBufferDepth\")),\n\t\t\"TopupThreshold\":         _s(r.get(\"TopupThreshold\")),\n\t\t\"AlarmWarningDepth\":      _s(r.get(\"AlarmWarningDepth\")),\n\t\t\"AlarmCriticalDepth\":     _s(r.get(\"AlarmCriticalDepth\")),\n\t\t\"AimBaseUrl\":             _s(r.get(\"AimBaseUrl\")),\n\t\t\"AimCompanyCode\":         _s(r.get(\"AimCompanyCode\")),\n\t\t\"AimPathToken\":           _s(r.get(\"AimPathToken\")),\n\t\t\"PostWarningAgeMinutes\":  _s(r.get(\"PostWarningAgeMinutes\")),\n\t\t\"PostCriticalAgeMinutes\": _s(r.get(\"PostCriticalAgeMinutes\")),\n\t\t\"AimPostingEnabled\":      bool(r.get(\"AimPostingEnabled\")),\n\t}\n\tself.view.custom.state \u003d {\"selected\": dict(loaded), \"editDraft\": dict(loaded)}"
        },
        {
          "name": "loadUnposted",
          "params": [],
          "script": "\trows \u003d BlueRidge.Lots.AimPool.listUnposted(50) or []\n\tmapped \u003d []\n\tfor r in rows:\n\t\tageMin \u003d r.get(\"AgeMinutes\") or 0\n\t\tif ageMin \u003e\u003d 60:\n\t\t\tageDisplay \u003d \"%dh %dm\" % (ageMin // 60, ageMin % 60)\n\t\telse:\n\t\t\tageDisplay \u003d \"%d min\" % ageMin\n\t\tmapped.append({\"poolId\": r.get(\"Id\"), \"serial\": r.get(\"AimShipperId\") or \"\", \"containerId\": r.get(\"ContainerId\") or 0, \"customerPartNumber\": r.get(\"CustomerPartNumber\") or \"\", \"quantity\": r.get(\"Quantity\") or 0, \"lotNumber\": r.get(\"LotNumber\") or \"\", \"postAttempts\": r.get(\"PostAttempts\") or 0, \"lastPostError\": r.get(\"LastPostError\") or \"\", \"ageDisplay\": ageDisplay})\n\tself.view.custom.unposted \u003d mapped"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "aimMarkPostedResult",
          "pageScope": true,
          "script": "\tif payload and payload.get(\"action\") \u003d\u003d \"confirm\":\n\t\tself.loadUnposted()",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "aimConnectionResult",
          "pageScope": true,
          "script": "\tif payload and payload.get(\"action\") \u003d\u003d \"save\":\n\t\tself.load()",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "mpp-toast",
          "pageScope": false,
          "script": "\tBlueRidge.Common.Notify._handle(self, payload)",
          "sessionScope": true,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
