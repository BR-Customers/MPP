                        "background": "var(--bg-row-alt)",
                        "borderRadius": "12px",
                        "color": "var(--mpp-text-secondary)",
                        "fontSize": "13px",
                        "padding": "4px 10px"
                      }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "meta": {
                  "name": "UnpostedHeaderRow"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "alignItems": "center",
                  "style": {
                    "gap": "10px"
                  },
                  "wrap": "wrap"
                },
                "type": "ia.container.flex"
              },
              {
                "meta": {
                  "name": "UnpostedEmptyState"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "len({view.custom.unposted}) = 0"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Nothing owed to AIM.",
                  "style": {
                    "color": "var(--mpp-text-secondary)",
                    "fontSize": "14px",
                    "padding": "12px 0"
                  }
                },
                "type": "ia.display.label"
