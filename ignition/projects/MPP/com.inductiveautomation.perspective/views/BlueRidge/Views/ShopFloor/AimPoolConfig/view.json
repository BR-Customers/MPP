      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "canvas"
      }
    },
    "type": "ia.container.flex",
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tself.load()\n\tself.loadUnposted()"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "load",
          "params": [],
          "script": "\trows = BlueRidge.Lots.AimPoolConfig.get() or []\n\tr = rows[0] if rows else {}\n\tdef _s(val):\n\t\treturn \"\" if val is None else (val if isinstance(val, basestring) else unicode(val))\n\tloaded = {\n\t\t\"Id\":                     r.get(\"Id\"),\n\t\t\"TargetBufferDepth\":      _s(r.get(\"TargetBufferDepth\")),\n\t\t\"TopupThreshold\":         _s(r.get(\"TopupThreshold\")),\n\t\t\"AlarmWarningDepth\":      _s(r.get(\"AlarmWarningDepth\")),\n\t\t\"AlarmCriticalDepth\":     _s(r.get(\"AlarmCriticalDepth\")),\n\t\t\"AimBaseUrl\":             _s(r.get(\"AimBaseUrl\")),\n\t\t\"AimCompanyCode\":         _s(r.get(\"AimCompanyCode\")),\n\t\t\"AimPathToken\":           _s(r.get(\"AimPathToken\")),\n\t\t\"PostWarningAgeMinutes\":  _s(r.get(\"PostWarningAgeMinutes\")),\n\t\t\"PostCriticalAgeMinutes\": _s(r.get(\"PostCriticalAgeMinutes\")),\n\t\t\"AimPostingEnabled\":      bool(r.get(\"AimPostingEnabled\")),\n\t}\n\tself.view.custom.state = {\"selected\": dict(loaded), \"editDraft\": dict(loaded)}"
        },
        {
          "name": "loadUnposted",
          "params": [],
          "script": "\trows = BlueRidge.Lots.AimPool.listUnposted(50) or []\n\tmapped = []\n\tfor r in rows:\n\t\tageMin = r.get(\"AgeMinutes\") or 0\n\t\tif ageMin >= 60:\n\t\t\tageDisplay = \"%dh %dm\" % (ageMin // 60, ageMin % 60)\n\t\telse:\n\t\t\tageDisplay = \"%d min\" % ageMin\n\t\tmapped.append({\"poolId\": r.get(\"Id\"), \"serial\": r.get(\"AimShipperId\") or \"\", \"containerId\": r.get(\"ContainerId\") or 0, \"customerPartNumber\": r.get(\"CustomerPartNumber\") or \"\", \"quantity\": r.get(\"Quantity\") or 0, \"lotNumber\": r.get(\"LotNumber\") or \"\", \"postAttempts\": r.get(\"PostAttempts\") or 0, \"lastPostError\": r.get(\"LastPostError\") or \"\", \"ageDisplay\": ageDisplay})\n\tself.view.custom.unposted = mapped"
        }
      ],
      "messageHandlers": [
        {
          "messageType": "aimMarkPostedResult",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif payload and payload.get(\"action\") == \"confirm\":\n\t\tself.loadUnposted()"
        }
      ]
    }
  }
}
