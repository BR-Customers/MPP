        "transforms": [
          {
            "code": "\trows = value or []\n\tr = rows[0] if rows else {}\n\treturn {\"Id\": r.get(\"Id\") or 1, \"TargetBufferDepth\": r.get(\"TargetBufferDepth\") or 0, \"TopupThreshold\": r.get(\"TopupThreshold\") or 0, \"AlarmWarningDepth\": r.get(\"AlarmWarningDepth\") or 0, \"AlarmCriticalDepth\": r.get(\"AlarmCriticalDepth\") or 0, \"AimBaseUrl\": r.get(\"AimBaseUrl\") or \"\", \"AimCompanyCode\": r.get(\"AimCompanyCode\") or \"\", \"AimPathToken\": r.get(\"AimPathToken\") or \"\", \"PostWarningAgeMinutes\": r.get(\"PostWarningAgeMinutes\") or 0, \"PostCriticalAgeMinutes\": r.get(\"PostCriticalAgeMinutes\") or 0, \"AimPostingEnabled\": r.get(\"AimPostingEnabled\") or False}",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "onChange": {
        "enabled": true,
        "script": "\tc = value or {}\n\tself.view.custom.draft = {\"aimPostingEnabled\": bool(c.get(\"AimPostingEnabled\")), \"alarmCriticalDepth\": str(c.get(\"AlarmCriticalDepth\") or 0), \"alarmWarningDepth\": str(c.get(\"AlarmWarningDepth\") or 0), \"targetBufferDepth\": str(c.get(\"TargetBufferDepth\") or 0), \"topupThreshold\": str(c.get(\"TopupThreshold\") or 0)}"
      }
