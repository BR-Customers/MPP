                    "meta": { "name": "PostCriticalAgeField" },
                    "position": { "basis": "180px", "shrink": 0 },
                    "props": { "direction": "column", "style": { "classes": "pf-field", "gap": "4px" } },
                    "type": "ia.container.flex"
                  }
                ],
                "meta": { "name": "ConnFieldRow" },
                "position": { "shrink": 0 },
                "props": { "alignItems": "flex-end", "style": { "gap": "12px" }, "wrap": "wrap" },
                "type": "ia.container.flex"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\td = self.view.custom.editDraft\n\trows = BlueRidge.Lots.AimPoolConfig.get() or []\n\tcur = rows[0] if rows else {}\n\tbaseUrl = d.get(\"aimBaseUrl\") or None\n\tcompanyCode = d.get(\"aimCompanyCode\") or None\n\tpathToken = d.get(\"aimPathToken\") or None\n\twarnAge = BlueRidge.Common.Util.toIntOrNone(d.get(\"postWarningAgeMinutes\"))\n\tcritAge = BlueRidge.Common.Util.toIntOrNone(d.get(\"postCriticalAgeMinutes\"))\n\ttarget = cur.get(\"TargetBufferDepth\") or 0\n\ttopup = cur.get(\"TopupThreshold\") or 0\n\twarn = cur.get(\"AlarmWarningDepth\") or 0\n\tcritical = cur.get(\"AlarmCriticalDepth\") or 0\n\tresult = BlueRidge.Lots.AimPoolConfig.update(target, topup, warn, critical, baseUrl, companyCode, pathToken, warnAge, critAge)\n\tBlueRidge.Common.Ui.notifyResult(result, \"Connection settings saved\")\n\tif result and result.get(\"Status\"):\n\t\tself.view.custom.editDraft = {\"aimBaseUrl\": \"\", \"aimCompanyCode\": \"\", \"aimPathToken\": \"\", \"postWarningAgeMinutes\": \"\", \"postCriticalAgeMinutes\": \"\"}\n\t\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": { "name": "SaveConnButton" },
                "position": { "shrink": 0 },
                "props": {
                  "style": { "classes": "pf-btn pf-btn-primary pf-btn-large" },
                  "text": "Save connection settings"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": { "name": "ConnectionsPanel" },
            "position": { "shrink": 0 },
            "props": {
              "direction": "column",
              "style": { "classes": "pf-panel", "gap": "16px", "padding": "16px" }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "meta": { "name": "UnpostedTitle" },
                    "position": { "shrink": 0 },
                    "props": { "style": { "fontSize": "18px", "fontWeight": "700" }, "text": "AIM post backlog" },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "UnpostedCountBadge" },
                    "position": { "shrink": 0 },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": { "expression": "toStr(len({view.custom.unposted})) + \" owed\"" },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "0 owed",
                      "style": {
                        "background": "var(--bg-row-alt)",
                        "borderRadius": "12px",
                        "color": "var(--mpp-text-secondary)",
                        "fontSize": "13px",
                        "padding": "4px 10px"
                      }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "meta": { "name": "UnpostedHeaderRow" },
                "position": { "shrink": 0 },
                "props": { "alignItems": "center", "style": { "gap": "10px" }, "wrap": "wrap" },
                "type": "ia.container.flex"
              },
              {
                "meta": { "name": "UnpostedEmptyState" },
                "position": { "shrink": 0 },
                "propConfig": {
                  "position.display": {
                    "binding": { "config": { "expression": "len({view.custom.unposted}) = 0" }, "type": "expr" }
                  }
                },
                "props": {
                  "text": "Nothing owed to AIM.",
                  "style": { "color": "var(--mpp-text-secondary)", "fontSize": "14px", "padding": "12px 0" }
                },
                "type": "ia.display.label"
              },
              {
                "meta": { "name": "UnpostedList" },
                "position": { "shrink": 0 },
                "propConfig": {
                  "position.display": {
                    "binding": { "config": { "expression": "len({view.custom.unposted}) > 0" }, "type": "expr" }
                  },
                  "props.instances": {
                    "binding": {
                      "config": { "path": "view.custom.unposted" },
                      "transforms": [
                        {
                          "code": "\treturn [BlueRidge.Common.Util.extractQualifiedValues(r) or {} for r in (value or [])]",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "direction": "column",
                  "elementPosition": { "basis": "64px", "shrink": 0 },
                  "path": "BlueRidge/Components/PlantFloor/AimUnpostedRow",
                  "style": { "gap": "6px", "maxHeight": "420px", "overflowY": "auto" },
                  "useDefaultViewHeight": true,
                  "useDefaultViewWidth": false
                },
                "type": "ia.display.flex-repeater"
              }
