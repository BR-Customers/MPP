          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "canvas"
      }
    },
    "type": "ia.container.flex",
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tself.loadUnposted()"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "loadUnposted",
          "params": [],
          "script": "\trows = BlueRidge.Lots.AimPool.listUnposted(50) or []\n\tmapped = []\n\tfor r in rows:\n\t\tageMin = r.get(\"AgeMinutes\") or 0\n\t\tif ageMin >= 60:\n\t\t\tageDisplay = \"%dh %dm\" % (ageMin // 60, ageMin % 60)\n\t\telse:\n\t\t\tageDisplay = \"%d min\" % ageMin\n\t\tmapped.append({\"poolId\": r.get(\"Id\"), \"serial\": r.get(\"AimShipperId\") or \"\", \"containerId\": r.get(\"ContainerId\") or 0, \"customerPartNumber\": r.get(\"CustomerPartNumber\") or \"\", \"quantity\": r.get(\"Quantity\") or 0, \"lotNumber\": r.get(\"LotNumber\") or \"\", \"postAttempts\": r.get(\"PostAttempts\") or 0, \"lastPostError\": r.get(\"LastPostError\") or \"\", \"ageDisplay\": ageDisplay})\n\tself.view.custom.unposted = mapped"
        }
      ],
      "messageHandlers": [
        {
          "messageType": "aimMarkPostedResult",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif payload and payload.get(\"action\") == \"confirm\":\n\t\tself.loadUnposted()"
        }
      ]
    }
  }
}