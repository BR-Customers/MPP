              {
                "meta": {
                  "name": "UnpostedList"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "len({view.custom.unposted}) > 0"
                      },
                      "type": "expr"
                    }
                  },
                  "props.instances": {
                    "binding": {
                      "config": {
                        "path": "view.custom.unposted"
                      },
                      "transforms": [
                        {
                          "code": "\treturn [BlueRidge.Common.Util.extractQualifiedValues(r) or {} for r in (value or [])]",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "direction": "column",
                  "elementPosition": {
                    "basis": "64px",
                    "shrink": 0
                  },
                  "path": "BlueRidge/Components/PlantFloor/AimUnpostedRow",
                  "style": {
                    "gap": "6px",
                    "maxHeight": "420px",
                    "overflowY": "auto"
                  },
                  "useDefaultViewHeight": true,
                  "useDefaultViewWidth": false
