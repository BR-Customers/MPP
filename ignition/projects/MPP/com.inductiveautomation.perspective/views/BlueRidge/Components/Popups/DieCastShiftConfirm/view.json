{
  "custom": {
    "chosenShiftId": null,
    "shiftLabel": "",
    "shiftOptions": []
  },
  "params": {
    "popupId": "mpp-diecast-shift-confirm",
    "replyMessage": "dieCastShiftConfirmResult",
    "shiftId": null
  },
  "propConfig": {
    "custom.chosenShiftId": {
      "binding": {
        "config": {
          "path": "view.params.shiftId"
        },
        "type": "property"
      }
    },
    "custom.shiftLabel": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.Shift.labelFor\", 0, {view.params.shiftId})"
        },
        "type": "expr"
      }
    },
    "custom.shiftOptions": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.Shift.getRecentOptions\", 0, {view.params.shiftId})"
        },
        "type": "expr"
      }
    },
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.shiftId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 520,
      "width": 720
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "props": {
          "style": {
            "fontSize": "20px",
            "fontWeight": 700
          },
          "text": "Confirm the reporting shift"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Lead"
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub",
            "fontSize": "18px"
          },
          "text": "You are submitting shift output for:"
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "ShiftName"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.shiftLabel"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--mpp-state-warn-fg)",
                "fontSize": "52px",
                "fontWeight": 900,
                "lineHeight": "1.1",
                "textAlign": "center",
                "textTransform": "uppercase",
                "whiteSpace": "normal"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "ShiftBanner"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "backgroundColor": "var(--mpp-state-warn-bg)",
            "border": "4px solid var(--mpp-state-warn-border)",
            "borderRadius": "var(--mpp-radius-lg)",
            "padding": "20px 16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "ChangeLabel"
            },
            "props": {
              "style": {
                "classes": "pf-field-label",
                "whiteSpace": "nowrap"
              },
              "text": "Wrong shift? Pick the right one:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "ShiftDropdown"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "path": "view.custom.shiftOptions"
                  },
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.chosenShiftId"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "placeholder": {
                "text": "Select a shift"
              },
              "style": {
                "classes": "pf-field-select"
              }
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "name": "ChangeRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "12px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "ChangeNotice"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!isNull({view.custom.chosenShiftId}) \u0026\u0026 {view.custom.chosenShiftId} !\u003d {view.params.shiftId}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub",
            "color": "var(--mpp-state-warn-fg)",
            "fontWeight": 600,
            "whiteSpace": "normal"
          },
          "text": "Changing the shift recomputes the totals. Nothing is submitted: review the numbers, then press Submit again."
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Spacer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {},
          "text": ""
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\"action\": \"cancel\"}, scope\u003d\"page\")\n\tsystem.perspective.closePopup(id\u003dself.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CancelButton"
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary pf-btn-large"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "meta": {
              "name": "ButtonSpacer"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {},
              "text": ""
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\"action\": \"change\", \"shiftId\": self.view.custom.chosenShiftId}, scope\u003d\"page\")\n\tsystem.perspective.closePopup(id\u003dself.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ChangeButton"
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "!isNull({view.custom.chosenShiftId}) \u0026\u0026 {view.custom.chosenShiftId} !\u003d {view.params.shiftId}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary pf-btn-large"
              },
              "text": "CHANGE SHIFT \u0026 RECOMPUTE"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\"action\": \"confirm\", \"shiftId\": self.view.params.shiftId}, scope\u003d\"page\")\n\tsystem.perspective.closePopup(id\u003dself.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ConfirmButton"
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "!(!isNull({view.custom.chosenShiftId}) \u0026\u0026 {view.custom.chosenShiftId} !\u003d {view.params.shiftId})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary pf-btn-large"
              },
              "text": "CONFIRM \u0026 SUBMIT"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "ButtonRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "10px",
            "overflow": "visible"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "surface-card",
        "gap": "16px",
        "padding": "24px"
      }
    },
    "type": "ia.container.flex"
  }
}