{
  "custom": {
    "crtBaseline": false,
    "draft": {
      "adAccount": "",
      "crtEnabled": false,
      "newMethod": "",
      "password": ""
    }
  },
  "params": {
    "terminalLocationId": null
  },
  "propConfig": {
    "params.terminalLocationId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 540,
      "width": 480
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "HeaderTitle"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "fontSize": "18px",
                "fontWeight": "700"
              },
              "text": "Change Closure Mode"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "classes": "modal-header",
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Prompt"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "color": "var(--mpp-text-secondary)",
                "fontSize": "13px"
              },
              "text": "Select the new closure mode and authorize with supervisor Active Directory credentials. The mode persists until the next changeover."
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "MethodLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "New closure mode"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "MethodDropdown"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.options": {
                    "binding": {
                      "config": {
                        "path": "session.custom.closureCapabilities"
                      },
                      "transforms": [
                        {
                          "code": "\treturn [{\"label\": {\"ByCount\": \"By Count\", \"ByWeight\": \"By Weight\", \"ByVision\": \"By Vision\"}.get(m, m), \"value\": m} for m in (value or [])]",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.draft.newMethod"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": {
                    "text": "Select mode"
                  },
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.dropdown"
              }
            ],
            "meta": {
              "name": "MethodField"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "CrtLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Controlled Run Tag"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "CrtCheckbox"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.selected": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.draft.crtEnabled"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "text": "Hold containers for second-person validation"
                },
                "type": "ia.input.checkbox"
              }
            ],
            "meta": {
              "name": "CrtField"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "8px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "AccountLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "AD account"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "AccountInput"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.draft.adAccount"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "deferUpdates": false,
                  "placeholder": "domain\\username",
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.text-field"
              }
            ],
            "meta": {
              "name": "AccountField"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "PasswordLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Password"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "PasswordInput"
                },
                "position": {
                  "basis": "45px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.draft.password"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "deferUpdates": false,
                  "placeholder": "Password",
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.password-field"
              }
            ],
            "meta": {
              "name": "PasswordField"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "Body"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "modal-body"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.closePopup(\"mpp-changeover\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CancelButton"
            },
            "position": {
              "basis": "107px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\td \u003d self.view.custom.draft\n\ttid \u003d self.view.params.terminalLocationId\n\tok \u003d True\n\tif d.newMethod:\n\t\tr \u003d BlueRidge.Location.ClosureMode.changeover(tid, d.newMethod, d.adAccount, d.password)\n\t\tBlueRidge.Common.Ui.notifyResult(r, \"Closure mode changed\")\n\t\tif r and r.get(\"Status\"):\n\t\t\tself.session.custom.closureMethod \u003d d.newMethod\n\t\tok \u003d ok and bool(r and r.get(\"Status\"))\n\tif bool(d.crtEnabled) !\u003d bool(self.view.custom.crtBaseline):\n\t\tr \u003d BlueRidge.Location.ClosureMode.setCrt(tid, d.crtEnabled, d.adAccount, d.password)\n\t\tBlueRidge.Common.Ui.notifyResult(r, \"Controlled Run Tag updated\")\n\t\tok \u003d ok and bool(r and r.get(\"Status\"))\n\tif ok:\n\t\tsystem.perspective.closePopup(\"mpp-changeover\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ConfirmButton"
            },
            "position": {
              "basis": "241px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary"
              },
              "text": "Confirm changeover"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Footer"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "flex-end",
          "style": {
            "classes": "modal-footer",
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\ttid = self.view.params.terminalLocationId\n\tcur = bool(BlueRidge.Location.Terminal.getCrtEnabled(tid))\n\td = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.draft) or {}\n\td[\"crtEnabled\"] = cur\n\tself.view.custom.draft = d\n\tself.view.custom.crtBaseline = cur"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "modal"
      }
    },
    "type": "ia.container.flex"
  }
}