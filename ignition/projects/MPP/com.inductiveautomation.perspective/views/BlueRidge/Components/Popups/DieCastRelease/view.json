          }
        ],
        "meta": {
          "name": "MathStrip"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "stretch",
          "style": {
            "gap": "8px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "ScrapLabel"
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "SCRAP ON THIS BASKET"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ScrapSpacer"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "text": ""
                },
                "type": "ia.display.label"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.rootContainer.addScrapLine()"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "AddScrapButton"
                },
                "props": {
                  "image": {
                    "icon": {
                      "path": "mpp/add_circle"
                    }
                  },
                  "style": {
                    "classes": "pf-btn pf-btn-secondary",
                    "minHeight": "36px"
                  },
                  "text": "Add scrap reason"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "ScrapHeader"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "style": {
                "gap": "10px",
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "ScrapRepeater"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "config": {
                    "path": "view.custom.scrapLines"
                  },
                  "transforms": [
                    {
                      "code": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(value) or []\n\topts \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapDefectOptions) or []\n\tlotId \u003d self.view.params.lotId\n\tout \u003d []\n\tfor i, r in enumerate(rows):\n\t\tr \u003d r or {}\n\t\tout.append({\"lotId\": lotId, \"index\": i, \"defectCodeId\": r.get(\"defectCodeId\"), \"quantity\": r.get(\"quantity\") or \"\", \"defectOptions\": opts})\n\treturn out",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "direction": "column",
              "elementPosition": {
                "basis": "auto",
                "shrink": 0
              },
              "path": "BlueRidge/Components/PlantFloor/DieCastEntry/ScrapLineRow",
              "style": {
                "flexWrap": "nowrap",
                "gap": "6px",
                "overflow": "visible"
              },
              "useDefaultViewHeight": true,
              "useDefaultViewWidth": false
            },
            "type": "ia.display.flex-repeater"
          }
        ],
        "meta": {
          "name": "ScrapBlock"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "6px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "ChainNote"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"This cavity is already credited through counter \" + numberFormat({view.custom.preview.creditedThrough}, \"#,##0\") + \". The system subtracts it -- you never do.\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Advisory"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.preview.readingState} !\u003d \"Ok\" || {view.custom.preview.belowStandardAfter}"
              },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.custom.preview.readingState} \u003d \"Behind\", \"var(--mpp-state-bad-fg)\", \"var(--mpp-state-warn-fg)\")"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.custom.preview.readingState} \u003d \"Behind\", \"That reading is behind the last reading recorded for this die, \" + numberFormat({view.custom.preview.dieCreditedThrough}, \"#,##0\") + \" for this shift. Check the number you wrote down.\", if({view.custom.preview.readingState} \u003d \"None\", \"No reading entered. Releasing now closes the basket at its current count and credits this cavity nothing further.\", \"This basket will close under the standard fill of \" + numberFormat(if(isNull({view.custom.preview.maxPieceCount}), 0, {view.custom.preview.maxPieceCount}), \"#,##0\") + \" pc.\"))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub",
            "fontWeight": 600
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\"action\": \"cancel\"}, scope\u003d\"page\")\n\tsystem.perspective.closePopup(id\u003dself.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CancelButton"
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary pf-btn-large"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t# The way out of a wall the operator cannot otherwise pass: the counter\n\t# was reset, or a wrong number was entered earlier and has blocked this\n\t# die for the rest of the shift. Opens on top of this dialog and replies\n\t# page-scoped, so the release in progress is never lost.\n\tp \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.preview) or {}\n\tsystem.perspective.openPopup(\"mpp-diecast-counter-anchor\",\n\t\t\"BlueRidge/Components/Popups/DieCastCounterAnchor\",\n\t\tparams\u003d{\"toolId\": p.get(\"toolId\"), \"shiftId\": self.view.params.shiftId,\n\t\t\t\"cellLocationId\": self.view.params.cellLocationId,\n\t\t\t\"dieName\": p.get(\"cavityName\") or \"\",\n\t\t\t\"popupId\": \"mpp-diecast-counter-anchor\",\n\t\t\t\"replyMessage\": \"dieCastAnchorResult\"},\n\t\tmodal\u003dTrue, showCloseIcon\u003dTrue)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "FixCounterButton"
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.preview.readingState} \u003d \"Behind\", \"pf-btn pf-btn-primary\", \"pf-btn pf-btn-secondary\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {},
              "text": "Counter reset / wrong total?"
            },
            "type": "ia.input.button"
          },
          {
            "meta": {
              "name": "Spacer"
            },
            "position": {
              "grow": 1
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t# The reading rides the reply so the caller writes exactly the\n\t# number this dialog showed the arithmetic for. The operator\u0027s counted\n\t# Good rides too, but ONLY when it still disagrees with the derived\n\t# figure (D3) -- two independent facts, allowed to disagree; when they\n\t# match, the proc\u0027s own counterReading-derived delta runs unmodified.\n\tp \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.preview) or {}\n\t# The field holds the basket TOTAL; the proc takes a DELTA. Derive it.\n\t# Only override when the counted total still disagrees with the\n\t# derived one -- when they match, the proc runs its own\n\t# counterReading-derived delta unmodified (D3).\n\tonBasket \u003d BlueRidge.Common.Util.toIntOrNone(p.get(\"pieceCount\")) or 0\n\tderivedTotal \u003d BlueRidge.Common.Util.toIntOrNone(p.get(\"projectedPieceCount\"))\n\tif derivedTotal is None:\n\t\tderivedTotal \u003d onBasket + (BlueRidge.Common.Util.toIntOrNone(p.get(\"newShots\")) or 0)\n\tcountedTotal \u003d BlueRidge.Common.Util.toIntOrNone(self.view.custom.good)\n\tif countedTotal is not None and countedTotal !\u003d derivedTotal:\n\t\tfinalPieceDelta \u003d countedTotal - onBasket\n\telse:\n\t\tfinalPieceDelta \u003d None\n\tscrapLines \u003d []\n\tfor r in (BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []):\n\t\tr \u003d r or {}\n\t\td \u003d r.get(\"defectCodeId\")\n\t\tq \u003d r.get(\"quantity\")\n\t\tif d is not None and q not in (None, \"\"):\n\t\t\tscrapLines.append({\"defectCodeId\": d, \"quantity\": q})\n\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\n\t\t\"action\": \"confirm\",\n\t\t\"counterReading\": self.view.custom.counterReading,\n\t\t\"finalPieceDelta\": finalPieceDelta,\n\t\t\"scrapLines\": scrapLines,\n\t}, scope\u003d\"page\")\n\tsystem.perspective.closePopup(id\u003dself.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ReleaseButton"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.preview.readingState} !\u003d \"Behind\""
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.preview.belowStandardAfter} || {view.custom.preview.readingState} \u003d \"None\", \"pf-btn pf-btn-danger pf-btn-large\", \"pf-btn pf-btn-primary pf-btn-large\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {},
              "text": "Release basket"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "ButtonRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "10px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "scripts": {
      "customMethods": [
        {
          "name": "addScrapLine",
          "params": [],
          "script": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows \u003d [dict(r or {}) for r in rows]\n\trows.append({\"defectCodeId\": None, \"quantity\": \"\"})\n\tself.view.custom.scrapLines \u003d rows"
        },
        {
          "name": "setScrapLine",
          "params": [
            "index",
            "defectCodeId",
            "quantity"
          ],
          "script": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows \u003d [dict(r or {}) for r in rows]\n\tif index is None or index \u003c 0 or index \u003e\u003d len(rows):\n\t\treturn\n\trows[index] \u003d {\"defectCodeId\": defectCodeId, \"quantity\": quantity or \"\"}\n\tself.view.custom.scrapLines \u003d rows"
        },
        {
          "name": "removeScrapLine",
          "params": [
            "index"
          ],
          "script": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows \u003d [dict(r or {}) for r in rows]\n\tif index is None or index \u003c 0 or index \u003e\u003d len(rows):\n\t\treturn\n\tdel rows[index]\n\tself.view.custom.scrapLines \u003d rows"
        },
        {
          "name": "_isMineScrapLine",
          "params": [
            "payload"
          ],
          "script": "\t# ScrapLineRow broadcasts on PAGE scope -- filter to rows this dialog owns.\n\tif not payload:\n\t\treturn False\n\treturn (\"%s\" % payload.get(\"lotId\")) \u003d\u003d (\"%s\" % self.view.params.lotId)"
        }
      ],
      "messageHandlers": [
        {
          "messageType": "dieCastAnchorResult",
          "pageScope": true,
          "script": "\t# The anchor moved the die watermark without touching any of the\n\t# preview binding\u0027s real inputs, so nothing would re-evaluate on\n\t# its own and this dialog would go on quoting the number that had\n\t# just been superseded.\n\tif payload and payload.get(\"action\") \u003d\u003d \"anchored\":\n\t\tself.view.custom.refreshToken \u003d (self.view.custom.refreshToken or 0) + 1",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "dieCastScrapLineChanged",
          "pageScope": true,
          "script": "\tif self._isMineScrapLine(payload):\n\t\tself.setScrapLine(payload.get(\"index\"), payload.get(\"defectCodeId\"), payload.get(\"quantity\"))",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "dieCastScrapLineRemoved",
          "pageScope": true,
          "script": "\tif self._isMineScrapLine(payload):\n\t\tself.removeScrapLine(payload.get(\"index\"))",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
