{
  "custom": {
    "context": {
      "cellLocationId": null,
      "dieCreditedThrough": 0,
      "found": false,
      "hasAnchor": false,
      "note": "",
      "reasonName": "",
      "recordedAt": null,
      "recordedBy": "",
      "shiftId": null,
      "sourceKind": "None",
      "toolId": null
    },
    "contextLine": "",
    "counterReading": "",
    "good": "",
    "refreshToken": 0,
    "scrapDefectOptions": [],
    "scrapLines": [],
    "preview": {
      "belowStandardAfter": false,
      "cavityName": "",
      "cavityCode": "",
      "creditedThrough": 0,
      "dieCreditedThrough": 0,
      "found": false,
      "lotId": null,
      "lotName": "",
      "maxPieceCount": null,
      "newShots": 0,
      "partNumber": "",
      "pieceCount": 0,
      "projectedPieceCount": 0,
      "readingState": "None",
      "toolCavityId": null,
      "toolId": null
    }
  },
  "params": {
    "cellLocationId": null,
    "lotId": null,
    "popupId": "mpp-diecast-release",
    "replyMessage": "releaseConfirmResult",
    "shiftId": null
  },
  "propConfig": {
    "custom.context": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Workorder.DieCast.getCounterContext\", 0, {view.custom.preview.toolId}, {view.params.shiftId}, {view.params.cellLocationId})"
        },
        "type": "expr"
      }
    },
    "custom.contextLine": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Workorder.DieCast.describeCounterContext\", 0, {view.custom.context})"
        },
        "type": "expr"
      }
    },
    "custom.preview": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Workorder.DieCast.getReleasePreview\", 0, {view.params.lotId}, {view.params.shiftId}, {view.params.cellLocationId}, {view.custom.counterReading}, {view.custom.refreshToken})"
        },
        "type": "expr"
      },
      "onChange": {
        "enabled": true,
        "script": "\t# A fresh proposal replaces the operator\u0027s counted-good override, mirroring\n\t# CavityLotRow\u0027s params.proposedGood reseed. Independent from the counter\n\t# reading itself (D3) -- the operator\u0027s count only rides along on Release\n\t# when it still disagrees with this freshly-derived figure.\n\tp \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.preview) or {}\n\t# The field is the basket TOTAL, so it prefills with the projected\n\t# close-at (what is on the basket + what this release adds), not\n\t# with the delta alone.\n\tval \u003d p.get(\"projectedPieceCount\")\n\tif val is None:\n\t\tval \u003d (BlueRidge.Common.Util.toIntOrNone(p.get(\"pieceCount\")) or 0) \\\n\t\t\t+ (BlueRidge.Common.Util.toIntOrNone(p.get(\"newShots\")) or 0)\n\tself.view.custom.good \u003d str(val) if val is not None else \"0\""
      }
    },
    "custom.scrapDefectOptions": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Quality.DefectCode.getForDropdown\", 0, \"DieCast\")"
        },
        "type": "expr"
      }
    },
    "params.cellLocationId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.lotId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.shiftId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 520,
      "width": 760
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "props": {
          "style": {
            "fontSize": "20px",
            "fontWeight": 700
