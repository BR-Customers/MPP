{
  "custom": {
    "applyEnabled": false,
    "decisions": {}
  },
  "params": {
    "overflow": [],
    "popupId": "mpp-diecast-overflow",
    "replyMessage": "dieCastOverflowResult"
  },
  "propConfig": {
    "params.overflow": {
      "paramDirection": "input"
    },
    "params.popupId": {
      "paramDirection": "input"
    },
    "params.replyMessage": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 440,
      "width": 580
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "props": {
          "style": {
            "classes": "pf-panel-header",
            "fontSize": "18px",
            "fontWeight": 700
          },
          "text": "Basket capacity exceeded"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Sub"
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub"
          },
          "text": "For each cavity, either scan a new LTT to fill the current basket, release it, and roll the remainder into a new basket — or tick Overfill to push the extra onto the current basket. Choose per cavity, then Apply."
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Rows"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.params.overflow"
              },
              "transforms": [
                {
                  "code": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(value) or []\n\treturn [{\"lotId\": r.get(\"lotId\"), \"lotName\": r.get(\"lotName\") or \"\", \"cavityNumber\": r.get(\"cavityNumber\") or \"\", \"headroom\": r.get(\"headroom\") or 0, \"good\": r.get(\"good\") or 0, \"remainder\": r.get(\"remainder\") or 0} for r in rows]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "auto",
            "shrink": 0
          },
          "path": "BlueRidge/Components/Popups/DieCastOverflowRow",
          "style": {
            "gap": "8px",
            "overflowY": "auto"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.getChild(\"root\").reply(\"cancel\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CancelButton"
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.getChild(\"root\").reply(\"apply\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ApplyButton"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.applyEnabled}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary"
              },
              "text": "Apply"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Actions"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "flex-end",
          "style": {
            "gap": "10px",
            "paddingTop": "6px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-panel",
        "gap": "12px",
        "padding": "18px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "reply",
          "params": [
            "action"
          ],
          "script": "\tpayload \u003d {\"action\": action}\n\tif action \u003d\u003d \"apply\":\n\t\tpayload[\"decisions\"] \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.decisions) or {}\n\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003dpayload, scope\u003d\"page\")\n\tsystem.perspective.closePopup(self.view.params.popupId)"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "overflowDecisionChanged",
          "pageScope": true,
          "script": "\tm \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.decisions) or {}\n\tm \u003d dict(m)\n\tm[\"%s\" % payload.get(\"lotId\")] \u003d {\"mode\": payload.get(\"mode\") or \"fill\", \"ltt\": (payload.get(\"ltt\") or \"\").strip()}\n\tself.view.custom.decisions \u003d m\n\tself.view.custom.applyEnabled \u003d BlueRidge.Common.Util.overflowDecisionsComplete(m, self.view.params.overflow)",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}