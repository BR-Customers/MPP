{
  "custom": {
    "ltt": "",
    "overfill": false
  },
  "params": {
    "cavityNumber": "",
    "good": 0,
    "headroom": 0,
    "lotId": null,
    "lotName": "",
    "remainder": 0
  },
  "propConfig": {
    "params.cavityNumber": {
      "paramDirection": "input"
    },
    "params.good": {
      "paramDirection": "input"
    },
    "params.headroom": {
      "paramDirection": "input"
    },
    "params.lotId": {
      "paramDirection": "input"
    },
    "params.lotName": {
      "paramDirection": "input"
    },
    "params.remainder": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 96,
      "width": 520
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Desc"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Cavity \" + toStr({view.params.cavityNumber}) + \"  ·  \" + {view.params.lotName} + \" — basket full. Submitting \" + toStr({view.params.good}) + \" pc: \" + toStr({view.params.headroom}) + \" fits, \" + toStr({view.params.remainder}) + \" overflow.\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontWeight": 600
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.getChild(\"root\").sendDecision()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "OverfillCheck"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.overfill"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "text": "Overfill this basket"
            },
            "type": "ia.input.checkbox"
          },
          {
            "events": {
              "dom": {
                "onBlur": {
                  "config": {
                    "script": "\tself.view.getChild(\"root\").sendDecision()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "LttInput"
            },
            "position": {
              "basis": "0",
              "grow": 1
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "!{view.custom.overfill}"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.ltt"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "placeholder": "Scan new LTT for the overflow basket",
              "style": {
                "classes": "pf-field-input-mono"
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "name": "ControlRow"
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-inventory-row",
        "gap": "6px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "sendDecision",
          "params": [],
          "script": "\tmode \u003d \"overfill\" if self.view.custom.overfill else \"fill\"\n\tsystem.perspective.sendMessage(\"overflowDecisionChanged\", payload\u003d{\"lotId\": self.view.params.lotId, \"mode\": mode, \"ltt\": self.view.custom.ltt or \"\"}, scope\u003d\"page\")"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": null
    },
    "type": "ia.container.flex"
  }
}