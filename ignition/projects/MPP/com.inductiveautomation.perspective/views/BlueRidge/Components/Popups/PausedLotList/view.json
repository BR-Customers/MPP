{
  "custom": {
    "pauses": []
  },
  "params": {
    "locationId": null
  },
  "propConfig": {
    "params.locationId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 520,
      "width": 720
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "PauseIconLabel"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "color": "var(--pf-status-warn-fg)",
                "fontSize": "20px"
              },
              "text": "⏸"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "HeaderTitle"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "fontSize": "18px",
                "fontWeight": "600"
              },
              "text": "Paused LOTs"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "CountBadge"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "toStr(len({view.custom.pauses})) + \" paused\""
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "background": "var(--bg-row-alt)",
                "borderRadius": "12px",
                "color": "var(--mpp-text-secondary)",
                "fontSize": "13px",
                "padding": "4px 10px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\u0027pausedLotListHowTo\u0027,\n\t\t\u0027BlueRidge/Components/Popups/PausedLotListHowTo\u0027,\n\t\tparams\u003d{\u0027popupId\u0027: \u0027pausedLotListHowTo\u0027},\n\t\tposition\u003d{\u0027width\u0027: \u002754%\u0027, \u0027height\u0027: \u002792%\u0027},\n\t\tmodal\u003dFalse, overlayDismiss\u003dFalse, showCloseIcon\u003dFalse)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "HowToButton",
              "tooltip": {
                "text": "How to resume a paused LOT"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "path": "material/help_outline",
              "style": {
                "cursor": "pointer",
                "height": "35px",
                "width": "35px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "classes": "modal-header",
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "EmptyIcon"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "color": "var(--mpp-state-good-fg)",
                    "fontSize": "36px"
                  },
                  "text": "✓"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "EmptyMessage"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "color": "var(--mpp-text-secondary)",
                    "fontSize": "15px"
                  },
                  "text": "No paused LOTs at this Cell"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "EmptyState"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "len({view.custom.pauses}) \u003d 0"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "alignItems": "center",
              "direction": "column",
              "justify": "center",
              "style": {
                "color": "var(--mpp-text-secondary)",
                "gap": "12px",
                "padding": "48px 24px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "PauseList"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "len({view.custom.pauses}) \u003e 0"
                  },
                  "type": "expr"
                }
              },
              "props.instances": {
                "binding": {
                  "config": {
                    "path": "view.custom.pauses"
                  },
                  "transforms": [
                    {
                      "code": "\treturn [BlueRidge.Common.Util.extractQualifiedValues(r) or {} for r in (value or [])]",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "direction": "column",
              "elementPosition": {
                "basis": "auto",
                "grow": 0,
                "shrink": 0
              },
              "path": "BlueRidge/Components/Popups/PausedLotList/PausedLotRow",
              "style": {
                "gap": "0px"
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false
            },
            "type": "ia.display.flex-repeater"
          }
        ],
        "meta": {
          "name": "Body"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "modal-body",
            "gap": "0px",
            "overflowY": "auto"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.closePopup(id\u003d\"mpp-paused-list\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CloseButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Footer"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "flex-end",
          "style": {
            "classes": "modal-footer",
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tself.load()"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "modal"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "load",
          "params": [],
          "script": "\tself.view.custom.pauses \u003d BlueRidge.Lots.LotPause.getByLocation(self.view.params.locationId) or []"
        },
        {
          "name": "resumePause",
          "params": [
            "pauseEventId",
            "lotId"
          ],
          "script": "\tresult \u003d BlueRidge.Lots.LotPause.resume(pauseEventId)\n\tBlueRidge.Common.Ui.notifyResult(result, successTitle\u003d\"Resumed\")\n\tif result and result.get(\"Status\"):\n\t\tself.view.custom.pauses \u003d BlueRidge.Lots.LotPause.getByLocation(self.view.params.locationId) or []\n\t\tsystem.perspective.sendMessage(\"pausedLotResumed\", {\"lotId\": lotId}, scope\u003d\"page\")"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "resumePauseRequested",
          "pageScope": true,
          "script": "\tif payload:\n\t\tself.resumePause(payload.get(\"pauseEventId\"), payload.get(\"lotId\"))",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}