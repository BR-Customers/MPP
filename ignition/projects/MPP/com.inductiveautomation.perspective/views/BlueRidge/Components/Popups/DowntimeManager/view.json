    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "background": "var(--mpp-surface-canvas)",
        "height": "100%",
        "width": "100%"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "applyScope",
          "params": [
            "activeCellLocationId"
          ],
          "script": "\t# Day-one feedback item 3. The downtime unit is resolved by SQL from the\n\t# TERMINAL, not from session.custom.cell -- the Trim screen deliberately\n\t# CLEARS that cell (no Trim Press context cells exist), which is why the\n\t# manager used to open at trim with no scope and no rows. This is the\n\t# FIRST-OPEN seed only (events.system.onStartup) -- it applies the proc\u0027s\n\t# DEFAULT rule, which returns no default at a split line. Every subsequent\n\t# operator pick goes through pickScope instead, which honours the pick.\n\timport BlueRidge.Oee.Downtime as D\n\tt \u003d BlueRidge.Common.Util.extractQualifiedValues(self.session.custom.terminal) or {}\n\td \u003d D.getDefaultScopeForTerminal(t.get(\"terminalLocationId\"), activeCellLocationId)\n\tself.view.custom.scopeLocationId \u003d d.get(\"ScopeLocationId\")\n\tself.view.custom.scopeName \u003d d.get(\"Name\") or \"\"\n\tself.refreshRows()"
        },
        {
          "name": "pickScope",
          "params": [
            "locationId"
          ],
          "script": "\timport BlueRidge.Oee.Downtime as D\n\tt \u003d BlueRidge.Common.Util.extractQualifiedValues(self.session.custom.terminal) or {}\n\td \u003d D.getScopeForPick(t.get(\"terminalLocationId\"), locationId)\n\tself.view.custom.scopeLocationId \u003d d.get(\"ScopeLocationId\")\n\tself.view.custom.scopeName \u003d d.get(\"Name\") or \"\"\n\tself.refreshRows()"
        },
        {
          "name": "refreshRows",
          "params": [],
          "script": "\timport BlueRidge.Oee.Downtime as D\n\tself.view.custom.rows \u003d D.getByScope(self.view.custom.scopeLocationId, True, self.view.custom.shiftId)"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "dtReasonSelected",
          "pageScope": true,
          "script": "\timport BlueRidge.Oee.Downtime as D\n\timport BlueRidge.Common.Ui as Ui\n\tp \u003d BlueRidge.Common.Util.extractQualifiedValues(payload) or {}\n\t# Supervisor-only for a PAST shift once its 30-minute grace window has\n\t# elapsed (Oee.DowntimeEvent_RequiresReasonGate) -- a current/open shift, or\n\t# a past shift still inside grace, needs no elevation. requireElevation\n\t# stashes {code, params} and opens the ElevationModal; on success\n\t# Session.dispatchElevatedAction re-sends THIS message and the isElevated\n\t# test below passes. refreshRows on the deferred path snaps the dropdown\n\t# back to the stored reason so a cancelled elevation leaves no phantom\n\t# selection on screen.\n\tif D.requiresReasonGate(p.get(\"downtimeEventId\")) and not BlueRidge.Common.Session.isElevated(self.session):\n\t\tBlueRidge.Common.Session.requireElevation(self.session, \"DowntimeReason\", \"Edit downtime reason\", p)\n\t\tself.refreshRows()\n\t\treturn\n\tres \u003d D.updateReason(p.get(\"downtimeEventId\"), p.get(\"reasonCodeId\"))\n\tUi.notifyResult(res, \"Reason updated\")\n\tself.refreshRows()",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "dtEndRequested",
          "pageScope": true,
          "script": "\timport BlueRidge.Oee.DowntimeEvent as DE\n\timport BlueRidge.Common.Ui as Ui\n\tres \u003d DE.end(payload[\"downtimeEventId\"])\n\tUi.notifyResult(res, \"Downtime ended\")\n\tself.refreshRows()",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "dtVoidRequested",
          "pageScope": true,
          "script": "\timport BlueRidge.Oee.Downtime as D\n\timport BlueRidge.Common.Ui as Ui\n\tp \u003d BlueRidge.Common.Util.extractQualifiedValues(payload) or {}\n\t# Supervisor-only (auth backlog 4.1) - voiding is irreversible.\n\tif not BlueRidge.Common.Session.isElevated(self.session):\n\t\tBlueRidge.Common.Session.requireElevation(self.session, \"DowntimeVoid\", \"Void downtime event\", p)\n\t\treturn\n\tres \u003d D.void(p.get(\"downtimeEventId\"))\n\tUi.notifyResult(res, \"Downtime voided\")\n\tself.refreshRows()",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "dtEditRequested",
          "pageScope": true,
          "script": "\tp \u003d BlueRidge.Common.Util.extractQualifiedValues(payload) or {}\n\teid \u003d p.get(\"downtimeEventId\")\n\t# Supervisor-only (auth backlog 4.1). Gate BEFORE the editor opens; the\n\t# editor\u0027s Save re-tests as defence in depth.\n\tif not BlueRidge.Common.Session.isElevated(self.session):\n\t\tBlueRidge.Common.Session.requireElevation(self.session, \"DowntimeEdit\", \"Edit downtime event\", p)\n\t\treturn\n\trow \u003d None\n\tfor r in (self.view.custom.rows or []):\n\t\tif r.get(\"DowntimeEventId\") \u003d\u003d eid:\n\t\t\trow \u003d r; break\n\tif row is None:\n\t\treturn\n\tst \u003d row.get(\"StartedAtEt\"); en \u003d row.get(\"EndedAtEt\")\n\tsystem.perspective.openPopup(id\u003d\"mpp-downtime-editor\", view\u003d\"BlueRidge/Components/Popups/DowntimeEditor\", modal\u003dTrue, showCloseIcon\u003dFalse, params\u003d{\n\t\t\"mode\": \"update\", \"editId\": eid, \"scopeLocationId\": self.view.custom.scopeLocationId,\n\t\t\"reasonCodeId\": row.get(\"DowntimeReasonCodeId\"),\n\t\t\"startedAtEtStr\": system.date.format(st, \"yyyy-MM-dd HH:mm:ss\") if st is not None else None,\n\t\t\"endedAtEtStr\": system.date.format(en, \"yyyy-MM-dd HH:mm:ss\") if en is not None else None,\n\t\t\"remarks\": row.get(\"Remarks\")})",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "downtimeManagerRefresh",
          "pageScope": true,
          "script": "\tself.refreshRows()",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}