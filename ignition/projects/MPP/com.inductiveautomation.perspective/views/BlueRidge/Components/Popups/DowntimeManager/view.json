  "params": {},
  "propConfig": {
    "custom.scopeOptions": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.Downtime.getScopeOptionsForTerminal\", 0, {session.custom.terminal.terminalLocationId}, {session.custom.cell.locationId})"
        },
        "type": "expr"
      }
    },
    "custom.shiftOptions": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Oee.Shift.listRecent\", 0)"
        },
        "transforms": [
          {
            "code": "\topts \u003d [{\"value\": None, \"label\": \"Current shift\"}]\n\tfor r in (value or []):\n\t\tst \u003d r.get(\"ActualStart\")\n\t\tlbl \u003d (r.get(\"ScheduleName\") or \"Shift\")\n\t\tif st is not None:\n\t\t\tlbl \u003d lbl + \"  \" + system.date.format(st, \"MM/dd HH:mm\")\n\t\topts.append({\"value\": r.get(\"Id\"), \"label\": lbl})\n\treturn opts",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    }
  },
