    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tc \u003d BlueRidge.Common.Util.extractQualifiedValues(self.session.custom.cell) or {}\n\tself.applyScope(c.get(\"locationId\"))"
          },
          "scope": "G",
          "type": "script"
        }
      }
