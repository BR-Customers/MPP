                    "script": "\timport BlueRidge.Oee.DowntimeEvent as DE\n\timport BlueRidge.Common.Ui as Ui\n\tsid \u003d self.view.custom.scopeLocationId\n\tif sid is None:\n\t\tUi.notifyResult({\"Status\": 0, \"Message\": \"Pick a machine at the top of this window first.\"}, \"\")\n\t\treturn\n\tres \u003d DE.start(sid)\n\tUi.notifyResult(res, \"Downtime started\")\n\tself.view.rootContainer.refreshRows()"
