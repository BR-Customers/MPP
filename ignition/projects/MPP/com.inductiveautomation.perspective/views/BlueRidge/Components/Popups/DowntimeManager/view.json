                  "transforms": [
                    {
                      "code": "\tout \u003d []\n\tfor r in (value or []):\n\t\tst \u003d r.get(\"StartedAtEt\"); en \u003d r.get(\"EndedAtEt\")\n\t\tstStr \u003d system.date.format(st, \"MM/dd HH:mm\") if st is not None else \"\"\n\t\tenStr \u003d system.date.format(en, \"HH:mm\") if en is not None else \"open\"\n\t\trc \u003d r.get(\"ReasonCode\"); rd \u003d r.get(\"ReasonDescription\")\n\t\treason \u003d (rc + \" - \" + rd) if rc else \"\"\n\t\tout.append({\n\t\t\t\"downtimeEventId\": r.get(\"DowntimeEventId\"),\n\t\t\t\"reasonCodeId\": r.get(\"DowntimeReasonCodeId\"),\n\t\t\t\"timeRange\":       stStr + \"  -\u003e  \" + enStr,\n\t\t\t\"durationMinutes\": r.get(\"DurationMinutes\"),\n\t\t\t\"reasonLabel\":     reason,\n\t\t\t\"sourceCode\":      r.get(\"SourceCode\") or \"\",\n\t\t\t\"initials\":        r.get(\"OperatorInitials\") or \"\",\n\t\t\t\"isOpen\":          bool(r.get(\"IsOpen\")),\n\t\t\t\"isApproximate\":   bool(r.get(\"IsApproximate\")),\n\t\t\t\"isVoided\":        bool(r.get(\"IsVoided\"))\n\t\t})\n\treturn out",
                      "type": "script"
                    }
                  ],
