                    },
                    "props": {
                      "path": "BlueRidge/Components/PlantFloor/Numpad",
                      "params": {
                        "messageName": "scrapEntryQtyKey"
                      },
                      "style": {
                        "height": "424px"
                      }
                    }
                  }
                ],
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.custom.pane} = \"numpad\""
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "RemarkPane"
                },
                "position": {
                  "basis": "0",
                  "grow": 1
                },
                "props": {
                  "direction": "column",
                  "alignItems": "center",
                  "style": {
                    "gap": "8px",
                    "overflow": "auto"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "RemarkHeader"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "props": {
                      "style": {
                        "classes": "pf-field-label"
                      },
                      "text": "Remark (optional) - applies to everything in this entry"
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "RemarkText"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "props": {
                      "style": {
                        "fontSize": "18px",
                        "minHeight": "44px",
                        "width": "800px",
                        "padding": "8px 14px",
                        "classes": "pf-field-input"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "property",
                          "config": {
                            "path": "view.custom.draft.remarks"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.display.view",
                    "meta": {
                      "name": "KeyboardHost"
                    },
                    "position": {
                      "basis": "350px",
                      "shrink": 0
                    },
                    "props": {
                      "path": "BlueRidge/Components/PlantFloor/Keyboard",
                      "params": {
                        "messageName": "scrapEntryRemarkKey"
                      },
                      "style": {
                        "width": "800px"
                      },
                      "useDefaultViewHeight": false,
                      "useDefaultViewWidth": false
                    }
                  }
                ],
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.custom.pane} = \"remark\""
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "EntryCol"
            },
            "position": {
              "basis": "450px",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "8px",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "EnteredHeader"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "3 - Entered"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "EnteredEmpty"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-help"
                  },
                  "text": "Nothing entered yet. Tap a reason once for each scrapped part."
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "len({view.custom.scrapLineRows}) = 0"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.flex-repeater",
                "meta": {
                  "name": "ScrapLinesRepeater"
                },
                "position": {
                  "basis": "0",
                  "grow": 1
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.scrapLineRows"
                      }
                    }
                  }
                },
                "props": {
                  "direction": "column",
                  "elementPosition": {
                    "basis": "52px",
                    "grow": 0,
                    "shrink": 0
                  },
                  "path": "BlueRidge/Components/PlantFloor/Scrap/ScrapLineRow",
                  "style": {
                    "gap": "6px",
                    "overflowY": "auto"
                  },
                  "useDefaultViewWidth": false
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "TotalRow"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "direction": "row",
                  "alignItems": "center",
                  "style": {
                    "gap": "8px"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "TotalLabel"
                    },
                    "position": {
                      "basis": "0",
                      "grow": 1
                    },
                    "props": {
                      "style": {
                        "fontSize": "20px",
                        "fontWeight": 700
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "toStr({view.custom.scrapTotal}) + \" pcs scrap\""
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "OnHandLabel"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "props": {
                      "style": {
                        "classes": "pf-kpi-sub"
                      }
                    },
                    "propConfig": {
                      "position.display": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "!isNull({view.custom.draft.itemId})"
                          }
                        }
                      },
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "\"of \" + toStr({view.custom.available}) + \" on hand\""
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "RemarkButton"
                },
                "position": {
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tself.view.rootContainer.toggleRemark()"
                      }
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-btn pf-btn-secondary",
                    "minHeight": "44px",
                    "justifyContent": "space-between",
                    "overflow": "hidden"
                  },
                  "image": {
                    "position": "right",
                    "icon": {
                      "path": "material/expand_more"
                    }
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(len({view.custom.draft.remarks}) > 0, \"Remark: \" + {view.custom.draft.remarks}, \"Remark (optional)\")"
                      }
                    }
                  },
                  "props.image.icon.path": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.pane} = \"remark\", \"material/expand_less\", \"material/expand_more\")"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "ButtonRow"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "direction": "row",
                  "style": {
                    "gap": "10px"
                  }
                },
                "children": [
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "CancelButton"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "type": "script",
                          "scope": "G",
                          "config": {
                            "script": "\tsystem.perspective.closePopup(id=self.view.params.popupId)"
                          }
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "classes": "pf-btn pf-btn-secondary",
                        "fontSize": "16px",
                        "minHeight": "56px",
                        "minWidth": "110px"
                      },
                      "text": "Cancel"
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "SubmitButton"
                    },
                    "position": {
                      "basis": "0",
                      "grow": 1
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "type": "script",
                          "scope": "G",
                          "config": {
                            "script": "\tself.view.rootContainer.submitScrap()"
                          }
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "classes": "pf-btn pf-btn-primary",
                        "fontSize": "16px",
                        "minHeight": "56px"
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "!isNull({view.custom.draft.itemId}) && {view.custom.scrapTotal} > 0"
                          }
                        }
                      },
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({view.custom.scrapTotal} > 0, \"Record Scrap (\" + toStr({view.custom.scrapTotal}) + \")\", \"Record Scrap\")"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}