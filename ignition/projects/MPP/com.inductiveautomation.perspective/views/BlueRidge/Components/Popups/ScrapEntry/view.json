{
  "custom": {
    "draft": {
      "defectCodeId": null,
      "itemId": null,
      "quantity": 0,
      "remarks": ""
    },
    "defectOptions": [],
    "partInstances": [],
    "refreshToken": 0,
    "shortfall": {
      "active": false,
      "requested": 0,
      "available": 0,
      "short": 0,
      "partNumber": ""
    }
  },
  "params": {
    "cellLocationId": null,
    "operationTypeCode": null,
    "popupId": "mpp-scrap-entry",
    "replyMessage": "inventoryChanged"
  },
  "propConfig": {
    "params.cellLocationId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.operationTypeCode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.defectOptions": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"BlueRidge.Quality.DefectCode.getForDropdown\", 0, {view.params.operationTypeCode})"
        }
      }
    },
    "custom.partInstances": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"BlueRidge.Lots.Lot.getScrapPartInstances\", 0, {view.params.cellLocationId}, {view.custom.draft.itemId}, {view.custom.refreshToken})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 680,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-panel",
        "gap": "12px",
        "overflow": "hidden",
        "padding": "16px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "HeaderRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "PanelHeader"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "pf-panel-header",
                "fontSize": "20px",
                "fontWeight": 700
              },
              "text": "Record Scrap"
            }
          },
          {
            "type": "ia.display.icon",
            "meta": {
              "name": "HowToButton",
              "tooltip": {
                "text": "How to record scrap"
              }
            },
            "position": {
              "shrink": 0
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup('scrapEntryHowTo',\n\t\t'BlueRidge/Components/Popups/ScrapEntryHowTo',\n\t\tparams={'popupId': 'scrapEntryHowTo'},\n\t\tposition={'width': '54%', 'height': '92%'},\n\t\tmodal=False, overlayDismiss=False, showCloseIcon=False)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "props": {
              "path": "material/help_outline",
              "style": {
                "cursor": "pointer",
                "height": "35px",
                "width": "35px"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "FormBody"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "!{view.custom.shortfall.active}"
              }
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "12px",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "PartLabel"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-field-label"
              },
              "text": "Part"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "NoPartsHint"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "len({view.custom.partInstances}) = 0"
                  }
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              },
              "text": "Nothing on hand at this line to scrap."
            }
          },
          {
            "type": "ia.display.flex-repeater",
            "meta": {
              "name": "PartRepeater"
            },
            "position": {
              "basis": "120px",
              "grow": 1
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "runScript(\"BlueRidge.Lots.Lot.getScrapPartInstances\", 0, {view.params.cellLocationId}, {view.custom.draft.itemId}, {view.custom.refreshToken})"
                  }
                }
              }
            },
            "props": {
              "direction": "column",
              "useDefaultViewHeight": false,
              "elementPosition": {
                "basis": "56px",
                "shrink": 0
              },
              "elementStyle": {
                "overflow": "hidden",
                "marginBottom": "6px"
              },
              "instances": [],
              "path": "BlueRidge/Components/Popups/_ScrapEntry/PartRow",
              "style": {
                "overflowY": "auto",
                "overflowX": "hidden"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "DefectField"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px",
                "overflow": "visible"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "DefectFieldLabel"
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Defect Code"
                }
              },
              {
                "type": "ia.input.dropdown",
                "meta": {
                  "name": "DefectDropdown"
                },
                "propConfig": {
                  "props.options": {
