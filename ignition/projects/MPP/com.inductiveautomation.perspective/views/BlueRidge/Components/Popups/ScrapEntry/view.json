{
  "custom": {
    "available": 0,
    "busyUntil": 0,
    "defectCodeTiles": [],
    "draft": {
      "itemId": null,
      "remarks": ""
    },
    "numpad": {
      "defectCodeId": null,
      "label": "",
      "value": ""
    },
    "pane": "reasons",
    "partInstances": [],
    "partNumber": "",
    "refreshToken": 0,
    "scrapLineRows": [],
    "scrapLines": [],
    "scrapMoreCount": 0,
    "scrapShowAll": false,
    "scrapTiles": [],
    "scrapTotal": 0
  },
  "params": {
    "cellLocationId": null,
    "operationTypeCode": null,
    "popupId": "mpp-scrap-entry",
    "replyMessage": "inventoryChanged"
  },
  "propConfig": {
    "params.cellLocationId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.operationTypeCode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.partInstances": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"BlueRidge.Lots.Lot.getScrapPartInstances\", 0, {view.params.cellLocationId}, {view.custom.draft.itemId}, {view.custom.refreshToken})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 540,
      "width": 1920
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-panel",
        "gap": "8px",
        "overflow": "hidden",
        "padding": "12px 16px"
      }
    },
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tself.init()"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "init",
          "params": [],
          "script": "\tself.view.custom.defectCodeTiles = BlueRidge.Quality.DefectCode.getForTilesRanked(self.view.params.cellLocationId, self.view.params.operationTypeCode)\n\tparts = BlueRidge.Lots.Lot.getScrappableParts(self.view.params.cellLocationId) or []\n\tif len(parts) == 1:\n\t\t# only one part on hand at this line: no reason to make the operator pick it\n\t\tself.selectPart(parts[0].get(\"ItemId\"))\n\telse:\n\t\tself.refreshScrapUi()"
        },
        {
          "name": "selectPart",
          "params": [
            "itemId"
          ],
          "script": "\tstock = BlueRidge.Lots.Lot.getScrappableStock(self.view.params.cellLocationId, itemId)\n\tself.view.custom.draft.itemId = itemId\n\tself.view.custom.available = stock.get(\"available\") or 0\n\tself.view.custom.partNumber = stock.get(\"partNumber\") or \"\"\n\tself.view.custom.pane = \"reasons\"\n\tif self.refreshScrapUi() > (stock.get(\"available\") or 0):\n\t\t# what was entered against the previous part does not fit this one\n\t\tself.view.custom.scrapLines = []\n\t\tBlueRidge.Common.Notify.toast(\"Entries cleared\", \"More was entered than this part has on hand.\", \"warning\")\n\t\tself.refreshScrapUi()"
        },
        {
          "name": "refreshScrapUi",
          "params": [],
          "script": "\t# Rebuild every derived scrap prop in ONE pass from the two sources of truth\n\t# (defectCodeTiles = the ranked catalog, scrapLines = what has been entered).\n\tm = BlueRidge.Quality.DefectCode.buildScrapEntryModel(self.view.custom.defectCodeTiles, self.view.custom.scrapLines, self.view.custom.scrapShowAll, \"scrapEntryChanged\", True)\n\tself.view.custom.scrapTiles = m[\"tiles\"]\n\tself.view.custom.scrapLineRows = m[\"lines\"]\n\tself.view.custom.scrapTotal = m[\"total\"]\n\tself.view.custom.scrapMoreCount = m[\"moreCount\"]\n\treturn m[\"total\"]"
        },
        {
          "name": "changeScrap",
          "params": [
            "payload"
          ],
          "script": "\t# One entry point for every scrap interaction: tile tap / -/+ stepper\n\t# (payload.delta), keyed quantity or remove (payload.quantity), and a tap on\n\t# a line's quantity (payload.edit -> open the keypad).\n\tif self.view.custom.draft.itemId is None:\n\t\tBlueRidge.Common.Notify.toast(\"Pick a part\", \"Select which part to scrap first.\", \"warning\")\n\t\treturn\n\tif payload.get(\"edit\"):\n\t\tself.openNumpad(payload.get(\"defectCodeId\"))\n\t\treturn\n\tavailable = self.view.custom.available\n\tres = BlueRidge.Quality.DefectCode.applyScrapChange(self.view.custom.scrapLines, payload.get(\"defectCodeId\"), payload.get(\"delta\"), payload.get(\"quantity\"), available)\n\tself.view.custom.scrapLines = res[\"lines\"]\n\tif res[\"clamped\"]:\n\t\tBlueRidge.Common.Notify.toast(\"Scrap capped\", \"Only %s of %s on hand at this line.\" % (available, self.view.custom.partNumber), \"warning\")\n\tself.refreshScrapUi()"
        },
        {
          "name": "toggleScrapShowAll",
          "params": [],
          "script": "\tself.view.custom.scrapShowAll = not self.view.custom.scrapShowAll\n\tself.refreshScrapUi()"
        },
        {
          "name": "openNumpad",
          "params": [
            "defectCodeId"
          ],
          "script": "\ttext = \"\"\n\tfor r in (self.view.custom.scrapLineRows or []):\n\t\tif r[\"defectCodeId\"] == defectCodeId:\n\t\t\ttext = \"%s - %s\" % (r[\"code\"], r[\"description\"])\n\tself.view.custom.numpad = {\"defectCodeId\": defectCodeId, \"label\": text, \"value\": \"\"}\n\tself.view.custom.pane = \"numpad\""
        },
        {
          "name": "numpadKey",
          "params": [
            "payload"
          ],
          "script": "\ta = payload.get(\"action\") if payload else None\n\tv = self.view.custom.numpad.value or \"\"\n\tif a == \"key\" and len(v) < 5:\n\t\tv = v + (\"%s\" % payload.get(\"key\"))\n\telif a == \"backspace\":\n\t\tv = v[:-1]\n\telif a == \"clear\":\n\t\tv = \"\"\n\tself.view.custom.numpad.value = v"
        },
        {
          "name": "numpadOk",
          "params": [],
          "script": "\tdefectCodeId = self.view.custom.numpad.defectCodeId\n\tv = self.view.custom.numpad.value or \"\"\n\tself.view.custom.pane = \"reasons\"\n\tif v != \"\":\n\t\t# 0 removes the line; nothing keyed leaves it as it was\n\t\tself.changeScrap({\"defectCodeId\": defectCodeId, \"quantity\": v})"
        },
        {
          "name": "toggleRemark",
          "params": [],
          "script": "\tself.view.custom.pane = \"reasons\" if self.view.custom.pane == \"remark\" else \"remark\""
        },
        {
          "name": "remarkKey",
          "params": [
            "payload"
          ],
          "script": "\ta = payload.get(\"action\") if payload else None\n\tt = self.view.custom.draft.remarks or \"\"\n\tif a == \"key\" or a == \"space\":\n\t\tt = (t + (\" \" if a == \"space\" else (\"%s\" % payload.get(\"key\"))))[:500]\n\telif a == \"backspace\":\n\t\tt = t[:-1]\n\telif a == \"clear\":\n\t\tt = \"\"\n\telif a == \"enter\":\n\t\tself.view.custom.pane = \"reasons\"\n\tself.view.custom.draft.remarks = t"
        },
        {
          "name": "submitScrap",
          "params": [],
          "script": "\tnowMs = system.date.toMillis(system.date.now())\n\tif nowMs < (self.view.custom.busyUntil or 0):\n\t\treturn\n\tself.view.custom.busyUntil = nowMs + 2000\n\ttermId = None\n\ttry:\n\t\ttermId = self.session.custom.terminal.terminalLocationId\n\texcept:\n\t\ttermId = None\n\tdata = {\"itemId\": self.view.custom.draft.itemId, \"locationId\": self.view.params.cellLocationId, \"lines\": self.view.custom.scrapLines, \"remarks\": self.view.custom.draft.remarks, \"operationTypeCode\": self.view.params.operationTypeCode}\n\tr = BlueRidge.Workorder.RejectEvent.submitScrapEntry(data, BlueRidge.Common.Session.currentAppUserId(self.session), termId)\n\tif r[\"ok\"]:\n\t\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload={\"lotId\": None, \"cellLocationId\": self.view.params.cellLocationId}, scope=\"page\")\n\t\tsystem.perspective.closePopup(id=self.view.params.popupId)\n\telse:\n\t\t# refused (e.g. inventory moved since the entry was keyed): fresh numbers, entry kept\n\t\tself.view.custom.available = r[\"available\"]\n\t\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1\n\t\tself.view.custom.busyUntil = 0"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "scrapEntryPartSelected",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tself.selectPart((payload or {}).get(\"itemId\"))"
        },
        {
          "messageType": "scrapEntryChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tself.changeScrap(payload)"
        },
        {
          "messageType": "scrapEntryQtyKey",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tself.numpadKey(payload)"
        },
        {
          "messageType": "scrapEntryRemarkKey",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tself.remarkKey(payload)"
        }
      ]
    },
    "children": [
      {
