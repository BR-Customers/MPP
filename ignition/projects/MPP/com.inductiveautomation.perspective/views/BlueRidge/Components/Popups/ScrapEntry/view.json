                  },
                  "style": {
                    "classes": "pf-field-select",
                    "fontSize": "16px"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "QuantityField"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px",
                "overflow": "visible"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "QuantityFieldLabel"
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Quantity"
                }
              },
              {
                "type": "ia.input.text-field",
                "meta": {
                  "name": "QuantityInput"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.draft.quantity",
                        "bidirectional": true
                      }
                    }
                  }
                },
                "props": {
                  "deferUpdates": false,
                  "style": {
                    "classes": "pf-field-input"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "RemarksField"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px",
                "overflow": "visible"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "RemarksFieldLabel"
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Remarks (optional)"
                }
              },
              {
                "type": "ia.input.text-field",
                "meta": {
                  "name": "RemarksInput"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.draft.remarks",
                        "bidirectional": true
                      }
                    }
                  }
                },
                "props": {
                  "deferUpdates": false,
                  "placeholder": "Optional",
                  "style": {
                    "classes": "pf-field-input"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ButtonRow"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "justify": "flex-end",
              "style": {
                "gap": "8px",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "CancelButton"
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.perspective.closePopup(id=self.view.params.popupId)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-btn pf-btn-secondary",
                    "fontSize": "16px",
                    "minHeight": "48px",
                    "minWidth": "110px"
                  },
                  "text": "Cancel"
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "SubmitButton"
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.rootContainer.submitScrap()"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-btn pf-btn-primary",
                    "fontSize": "16px",
                    "minHeight": "48px",
                    "minWidth": "150px"
                  },
                  "text": "Record Scrap"
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "!isNull({view.custom.draft.itemId}) && !isNull({view.custom.draft.defectCodeId}) && {view.custom.draft.quantity} > 0"
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ShortfallBody"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.shortfall.active}"
              }
            }
          }
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "gap": "16px",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ShortHeadline"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"Inventory is \" + toStr({view.custom.shortfall.short}) + if({view.custom.shortfall.short} = 1, \" part short.\", \" parts short.\")"
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "22px",
                "fontWeight": 700,
                "color": "var(--mpp-text-primary)",
                "textAlign": "center"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ShortDetail"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"You entered \" + toStr({view.custom.shortfall.requested}) + \", but only \" + toStr({view.custom.shortfall.available}) + \" of \" + {view.custom.shortfall.partNumber} + \" can be scrapped at this line.\""
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "15px",
                "color": "var(--mpp-text-secondary)",
                "textAlign": "center",
                "whiteSpace": "normal"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ShortQuestion"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"Submit \" + toStr({view.custom.shortfall.available}) + \" instead?\""
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "18px",
                "fontWeight": 700,
                "color": "var(--mpp-text-primary)",
                "textAlign": "center"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ShortButtonRow"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "justify": "center",
              "style": {
                "gap": "12px",
                "overflow": "hidden",
                "marginTop": "8px"
              }
            },
            "children": [
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "GoBackButton"
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.custom.shortfall = {\"active\": False, \"requested\": 0, \"available\": 0, \"short\": 0, \"partNumber\": \"\"}"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-btn pf-btn-secondary",
                    "fontSize": "16px",
                    "minHeight": "48px",
                    "minWidth": "140px"
                  },
                  "text": "Go back"
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "YesButton"
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.rootContainer.commitScrap(self.view.custom.shortfall.available)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "pf-btn pf-btn-primary",
                    "fontSize": "16px",
                    "minHeight": "48px",
                    "minWidth": "140px"
                  },
                  "text": "Yes"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "\"Yes, submit \" + toStr({view.custom.shortfall.available})"
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "scripts": {
      "customMethods": [
        {
          "name": "submitScrap",
          "params": [],
          "script": "\tdraft = dict(self.view.custom.draft)\n\titemId = draft.get(\"itemId\")\n\tif itemId is None:\n\t\tBlueRidge.Common.Notify.toast(\"Part required\", \"Select which part to scrap.\", \"warning\")\n\t\treturn\n\tqty = BlueRidge.Common.Util.toIntOrNone(draft.get(\"quantity\"))\n\tif qty is None or qty <= 0:\n\t\tBlueRidge.Common.Notify.toast(\"Quantity required\", \"Enter how many pieces to scrap.\", \"warning\")\n\t\treturn\n\t# Fresh read: the list on screen may be stale. The proc is still the guard.\n\tstock = BlueRidge.Lots.Lot.getScrappableStock(self.view.params.cellLocationId, itemId)\n\tavailable = stock.get(\"available\") or 0\n\tif available <= 0:\n\t\tBlueRidge.Common.Notify.toast(\"None on hand\", \"That part has nothing on hand at this line to scrap.\", \"warning\")\n\t\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1\n\t\treturn\n\tif qty > available:\n\t\tself.view.custom.shortfall = {\"active\": True, \"requested\": qty, \"available\": available, \"short\": qty - available, \"partNumber\": stock.get(\"partNumber\") or \"\"}\n\t\treturn\n\tself.commitScrap(qty)"
        },
        {
          "name": "commitScrap",
          "params": [
            "quantity"
          ],
          "script": "\tdraft = dict(self.view.custom.draft)\n\tremarks = draft.get(\"remarks\")\n\tif remarks is not None and unicode(remarks).strip() == \"\":\n\t\tremarks = None\n\tdata = {\"itemId\": draft.get(\"itemId\"), \"locationId\": self.view.params.cellLocationId, \"defectCodeId\": draft.get(\"defectCodeId\"), \"quantity\": quantity, \"remarks\": remarks, \"operationTypeCode\": self.view.params.operationTypeCode}\n\tappUserId = BlueRidge.Common.Session.currentAppUserId(self.session)\n\ttermId = None\n\ttry:\n\t\ttermId = self.session.custom.terminal.terminalLocationId\n\texcept:\n\t\ttermId = None\n\tresult = BlueRidge.Workorder.RejectEvent.recordByPartFifo(data, appUserId, termId)\n\tBlueRidge.Common.Ui.notifyResult(result, successTitle=\"Scrap recorded\")\n\tif result and result.get(\"Status\"):\n\t\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload={\"lotId\": None, \"cellLocationId\": self.view.params.cellLocationId}, scope=\"page\")\n\t\tsystem.perspective.closePopup(id=self.view.params.popupId)\n\telse:\n\t\t# Refused (e.g. inventory moved since the prompt): back to the form with fresh numbers.\n\t\tself.view.custom.shortfall = {\"active\": False, \"requested\": 0, \"available\": 0, \"short\": 0, \"partNumber\": \"\"}\n\t\tself.view.custom.refreshToken = (self.view.custom.refreshToken or 0) + 1"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "scrapEntryPartSelected",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tself.view.custom.draft.itemId = (payload or {}).get(\"itemId\")"
        }
      ]
    }
  }
}