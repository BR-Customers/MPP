{
  "custom": {
    "draft": {
      "adAccount": "",
      "password": ""
    }
  },
  "params": {
    "popupId": "mpp-move-override",
    "reason": "",
    "replyMessage": "moveOverrideAuthorized"
  },
  "propConfig": {
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.reason": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 380,
      "width": 480
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "fontSize": "18px",
                "fontWeight": 700,
                "padding": "16px 16px 4px 16px"
              },
              "text": "Supervisor override - backward move"
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\u0027moveOverrideHowTo\u0027,\n\t\t\u0027BlueRidge/Components/Popups/MoveOverrideHowTo\u0027,\n\t\tparams\u003d{\u0027popupId\u0027: \u0027moveOverrideHowTo\u0027},\n\t\tposition\u003d{\u0027width\u0027: \u002754%\u0027, \u0027height\u0027: \u002792%\u0027},\n\t\tmodal\u003dFalse, overlayDismiss\u003dFalse, showCloseIcon\u003dFalse)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "HowToButton",
              "tooltip": {
                "text": "How to authorize a move override"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "path": "material/help_outline",
              "style": {
                "cursor": "pointer",
                "height": "35px",
                "width": "35px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "props": {
          "alignItems": "center"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Reason"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if(isNull({view.params.reason}) || {view.params.reason} \u003d \"\", \"This move is backward on the route. Authorize with supervisor Active Directory credentials to proceed.\", {view.params.reason} + \"  Authorize with supervisor credentials to proceed.\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub",
            "padding": "0 16px 8px 16px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "AccountLabel"
            },
            "props": {
              "style": {
                "classes": "pf-field-label"
              },
              "text": "Supervisor AD account"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "AccountInput"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.draft.adAccount"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "deferUpdates": false,
              "placeholder": "Account",
              "style": {
                "classes": "pf-field-input"
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "name": "AccountField"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "pf-field",
            "gap": "4px",
            "padding": "4px 16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "PasswordLabel"
            },
            "props": {
              "style": {
                "classes": "pf-field-label"
              },
              "text": "Password"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "PasswordInput"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.draft.password"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "deferUpdates": false,
              "placeholder": "Password",
              "style": {
                "classes": "pf-field-input"
              }
            },
            "type": "ia.input.password-field"
          }
        ],
        "meta": {
          "name": "PasswordField"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "pf-field",
            "gap": "4px",
            "padding": "4px 16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.closePopup(self.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CancelButton"
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\td \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.draft) or {}\n\tacct \u003d (d.get(\"adAccount\") or \"\").strip()\n\tpw \u003d d.get(\"password\") or \"\"\n\tif not acct or not pw:\n\t\tBlueRidge.Common.Notify.toast(\"Credentials required\", \"Enter a supervisor account and password.\", \"warning\")\n\t\treturn\n\ttry:\n\t\ttermId \u003d self.session.custom.terminal.terminalLocationId\n\texcept:\n\t\ttermId \u003d None\n\tel \u003d BlueRidge.Location.AppUser.elevate(acct, pw, \"MoveOverride\", termId)\n\tif el and el.get(\"success\"):\n\t\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\"appUserId\": el.get(\"appUserId\")}, scope\u003d\"page\")\n\t\tsystem.perspective.closePopup(self.view.params.popupId)\n\telse:\n\t\tBlueRidge.Common.Notify.toast(\"Override denied\", (el or {}).get(\"message\") or \"Elevation failed.\", \"error\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "AuthorizeButton"
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary"
              },
              "text": "Authorize \u0026 move"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Footer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "alignItems": "end",
          "justify": "end",
          "style": {
            "gap": "8px",
            "padding": "8px 16px 16px 16px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "modal"
      }
    },
    "type": "ia.container.flex"
  }
}