          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\td = self.view.custom.state.editDraft\n\tcur = self.view.custom.state.selected\n\tbaseUrl = d.get(\"AimBaseUrl\") or None\n\tcompanyCode = d.get(\"AimCompanyCode\") or None\n\tpathToken = d.get(\"AimPathToken\") or None\n\twarnAge = BlueRidge.Common.Util.toIntOrNone(d.get(\"PostWarningAgeMinutes\"))\n\tcritAge = BlueRidge.Common.Util.toIntOrNone(d.get(\"PostCriticalAgeMinutes\"))\n\t# thresholds are owned by the parent screen -- pass the pristine values straight back\n\ttarget = BlueRidge.Common.Util.toIntOrNone(cur.get(\"TargetBufferDepth\")) or 0\n\ttopup = BlueRidge.Common.Util.toIntOrNone(cur.get(\"TopupThreshold\")) or 0\n\twarn = BlueRidge.Common.Util.toIntOrNone(cur.get(\"AlarmWarningDepth\")) or 0\n\tcritical = BlueRidge.Common.Util.toIntOrNone(cur.get(\"AlarmCriticalDepth\")) or 0\n\tresult = BlueRidge.Lots.AimPoolConfig.update(target, topup, warn, critical, baseUrl, companyCode, pathToken, warnAge, critAge)\n\tBlueRidge.Common.Ui.notifyResult(result, \"Connection settings saved\")\n\tif result and result.get(\"Status\"):\n\t\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload={\"action\": \"save\"}, scope=\"page\")\n\t\tsystem.perspective.closePopup(id=self.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "SaveButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary pf-btn-large"
