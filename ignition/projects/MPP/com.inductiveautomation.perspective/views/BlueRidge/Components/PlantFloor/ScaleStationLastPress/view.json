{
  "custom": {
    "last": {
      "hasPress": false,
      "time": "",
      "net": "-",
      "verdict": "-",
      "verdictClass": "pf-pill",
      "outcome": "No presses yet.",
      "scale": "",
      "window": ""
    }
  },
  "params": {
    "terminalLocationId": null,
    "pressToken": 0
  },
  "propConfig": {
    "params.terminalLocationId": {
      "paramDirection": "input"
    },
    "params.pressToken": {
      "paramDirection": "input"
    },
    "custom.last": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"BlueRidge.Workorder.ScaleStation.lastPressOrEmpty\", 0, {view.params.terminalLocationId}, {view.params.pressToken})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 220,
      "width": 560
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-panel",
        "gap": "10px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "12px"
          },
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Kicker"
            },
            "props": {
              "text": "LAST PRESS",
              "style": {
                "classes": "pf-kpi-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Time"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.last.time}"
                  }
                }
              }
            },
            "position": {
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Scale"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(len({view.custom.last.scale}) > 0, 'Scale: ' + {view.custom.last.scale}, '')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Reading"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "20px"
          },
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Net"
            },
            "props": {
              "style": {
                "fontSize": "56px",
                "classes": "pf-kpi-value pf-kpi-value-mono"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.last.net}"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Verdict"
            },
            "props": {},
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.last.verdict}"
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.last.verdictClass}"
                  }
                }
              }
            },
            "position": {
              "shrink": 0
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Window"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.last.window}"
                  }
                }
              }
            },
            "position": {
              "grow": 1
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Outcome"
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.last.outcome}"
              }
            }
          }
        }
      }
    ]
  }
}
