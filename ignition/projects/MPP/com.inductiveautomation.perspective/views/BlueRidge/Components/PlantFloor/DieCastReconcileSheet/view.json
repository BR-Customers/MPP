                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"Nothing is recorded for this shift on \" + {view.custom.header.PressName} + \" — no entries, no LOTs, no rejects. Everything below comes from the press sheet.\""
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "classes": "pf-kpi-sub"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ContentBody"
        },
        "position": {
          "grow": 1,
          "basis": "0"
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "14px",
            "overflow": "auto"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "EntriesSection"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "10px"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "EntriesHeaderRow"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "direction": "row",
                  "alignItems": "center",
                  "style": {
                    "gap": "8px"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "EntriesTitle"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "props": {
                      "text": "Entries on record",
                      "style": {
                        "fontSize": "15px",
                        "fontWeight": 700
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "EntriesCount"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "toStr(len({view.custom.entries})) + \" on record\""
                          }
                        }
                      }
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "classes": "pf-kpi-sub"
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "NoEntriesText"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "len({view.custom.entries}) = 0"
                      }
                    }
                  }
                },
                "props": {
                  "text": "Nothing is on record yet for this shift.",
                  "style": {
                    "classes": "pf-kpi-sub"
                  }
                }
              },
              {
                "type": "ia.display.flex-repeater",
                "meta": {
                  "name": "EntriesList"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "len({view.custom.entries}) > 0"
                      }
                    }
                  },
                  "props.instances": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.entries"
                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\tshiftId = self.view.params.shiftId\n\tcellId = self.view.params.cellLocationId\n\ttoolId = self.view.params.toolId\n\tfromLabel = self.view.custom.header.ShiftLabel\n\tout = []\n\tfor r in (value or []):\n\t\trow = BlueRidge.Common.Util.extractQualifiedValues(r) or {}\n\t\tout.append({\n\t\t\t\"entry\": row,\n\t\t\t\"shiftId\": shiftId,\n\t\t\t\"cellLocationId\": cellId,\n\t\t\t\"toolId\": toolId,\n\t\t\t\"fromShiftLabel\": fromLabel,\n\t\t\t\"isStaged\": row.get(\"IsStaged\") or False,\n\t\t\t\"stagedToShiftLabel\": row.get(\"StagedToShiftLabel\") or \"\",\n\t\t})\n\treturn out"
                        }
                      ]
                    }
                  }
                },
                "props": {
                  "direction": "column",
                  "elementPosition": {
                    "basis": "auto",
                    "grow": 0,
                    "shrink": 0
                  },
                  "path": "BlueRidge/Components/PlantFloor/_DieCastReconcileSheet/EntryCard",
                  "style": {
                    "gap": "10px"
                  },
                  "useDefaultViewHeight": false,
                  "useDefaultViewWidth": false
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
