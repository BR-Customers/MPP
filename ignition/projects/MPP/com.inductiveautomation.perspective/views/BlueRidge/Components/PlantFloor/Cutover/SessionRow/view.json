{
  "custom": {},
  "params": {
    "CastDate": null,
    "CavityCode": "",
    "LotId": null,
    "LotName": "",
    "PartNumber": "",
    "PieceCount": 0
  },
  "propConfig": {
    "params.CastDate": {
      "paramDirection": "input"
    },
    "params.CavityCode": {
      "paramDirection": "input"
    },
    "params.LotId": {
      "paramDirection": "input"
    },
    "params.LotName": {
      "paramDirection": "input"
    },
    "params.PartNumber": {
      "paramDirection": "input"
    },
    "params.PieceCount": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 52,
      "width": 420
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "NameLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.LotName"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-queue-name"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "MetaLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.PartNumber} + \"  ·  cav \" + if(isNull({view.params.CavityCode}) || {view.params.CavityCode} \u003d \"\", \"-\", {view.params.CavityCode}) + \"  ·  \" + if(isNull({view.params.CastDate}), \"-\", dateFormat({view.params.CastDate}, \"MMM d\"))"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-queue-detail"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Info"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "2px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "QtyLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "toStr({view.params.PieceCount}) + \" pc\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-primary)",
            "fontFamily": "var(--mpp-font-mono)",
            "fontSize": "15px",
            "fontWeight": 600
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tres \u003d BlueRidge.Cutover.Scan.voidEntry(self.view.params.LotId, self.session.custom.appUserId, self.session)\n\tBlueRidge.Common.Ui.notifyResult(res, \"Entry voided\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "VoidButton"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "color": "var(--mpp-text-tertiary)",
            "minHeight": "32px",
            "minWidth": "32px",
            "padding": "0"
          },
          "text": "✕"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "pf-inventory-row",
        "gap": "10px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}