{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 44,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "OperatorLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Operator: \" + if(isNull({session.custom.user.displayName}) || {session.custom.user.displayName} \u003d \"\", if(isNull({session.custom.user.initials}), \"-\", {session.custom.user.initials}), {session.custom.user.displayName})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.openPopup(\"mpp-initials\", \"BlueRidge/Components/Popups/InitialsEntry\", params\u003d{\"popupId\": \"mpp-initials\"}, modal\u003dTrue, showCloseIcon\u003dTrue, overlayDismiss\u003dTrue)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "ChangeOperatorButton"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-btn pf-btn-secondary"
          },
          "text": "Change Operator"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "flex-end",
      "style": {
        "borderBottom": "1px solid var(--mpp-border-subtle)",
        "classes": "canvas",
        "gap": "12px",
        "padding": "6px 16px"
      }
    },
    "type": "ia.container.flex"
  }
}