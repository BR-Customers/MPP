{
  "custom": {},
  "params": {
    "toolCavityId": null,
    "cavityNumber": "",
    "lotId": null,
    "lotName": "",
    "pieceCount": 0,
    "contributorCount": 0,
    "openedAtDisplay": "",
    "voidEligible": false
  },
  "propConfig": {
    "params.toolCavityId": { "paramDirection": "input" },
    "params.cavityNumber": { "paramDirection": "input" },
    "params.lotId": { "paramDirection": "input" },
    "params.lotName": { "paramDirection": "input" },
    "params.pieceCount": { "paramDirection": "input" },
    "params.contributorCount": { "paramDirection": "input" },
    "params.openedAtDisplay": { "paramDirection": "input" },
    "params.voidEligible": { "paramDirection": "input" }
  },
  "props": {
    "defaultSize": { "height": 56, "width": 900 }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "alignItems": "center",
      "style": { "classes": "pf-inventory-row", "gap": "12px", "overflow": "hidden" }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": { "name": "InfoBlock" },
        "position": { "basis": "0", "grow": 1, "shrink": 0 },
        "props": { "direction": "column", "style": { "gap": "2px", "overflow": "hidden" } },
        "children": [
          {
            "type": "ia.display.label",
            "meta": { "name": "TitleLabel" },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": { "expression": "\"Cavity \" + toStr({view.params.cavityNumber}) + \"  ·  \" + {view.params.lotName}" }
                }
              }
            },
            "props": { "text": "", "style": { "fontWeight": 600, "fontFamily": "var(--mpp-font-mono)" } }
          },
          {
            "type": "ia.display.label",
            "meta": { "name": "SubLabel" },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "toStr({view.params.pieceCount}) + \" pc  ·  \" + toStr({view.params.contributorCount}) + \" contributor(s)  ·  opened \" + {view.params.openedAtDisplay}"
                  }
                }
              }
            },
            "props": { "text": "", "style": { "classes": "pf-kpi-sub" } }
          }
        ]
      },
      {
        "type": "ia.input.button",
        "meta": { "name": "ReleaseButton" },
        "position": { "basis": "auto", "shrink": 0 },
        "props": { "text": "Release", "style": { "classes": "pf-btn pf-btn-primary" } },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script", "scope": "G",
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"requestReleaseBasket\", payload={\"lotId\": self.view.params.lotId, \"lotName\": self.view.params.lotName}, scope=\"page\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": { "name": "VoidButton" },
        "position": { "basis": "auto", "shrink": 0 },
        "propConfig": {
          "position.display": { "binding": { "type": "property", "config": { "path": "view.params.voidEligible" } } }
        },
        "props": { "text": "Void", "style": { "classes": "pf-btn pf-btn-danger" } },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script", "scope": "G",
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"requestVoidBasket\", payload={\"lotId\": self.view.params.lotId, \"lotName\": self.view.params.lotName}, scope=\"page\")"
              }
            }
          }
        }
      }
    ]
  }
}
