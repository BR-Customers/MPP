{
  "custom": {},
  "params": {
    "row": {
      "ByLine": "",
      "Id": null,
      "NoteText": "",
      "SnapshotLine": "",
      "WasElevated": false,
      "WhenLine": "",
      "WhereLine": ""
    }
  },
  "propConfig": {
    "params.row": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 84,
      "width": 800
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "ByLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.row.ByLine"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--mpp-text-primary)",
                "fontSize": "14px",
                "fontWeight": "600"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SupervisorBadge",
              "tooltip": {
                "enabled": true,
                "text": "Written while a supervisor elevation was active"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.row.WasElevated"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "badge badge-amber"
              },
              "text": "Supervisor"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "WhereLabel"
            },
            "position": {
              "basis": "0",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.row.WhereLine"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--mpp-text-secondary)",
                "fontSize": "12px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "WhenLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.row.WhenLine"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--mpp-text-secondary)",
                "fontSize": "12px"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "HeaderRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "NoteTextLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.row.NoteText"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-primary)",
            "fontSize": "15px",
            "overflowWrap": "anywhere",
            "whiteSpace": "pre-wrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "SnapshotLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.row.SnapshotLine"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-secondary)",
            "fontSize": "12px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "borderBottom": "1px solid var(--mpp-border-subtle)",
        "gap": "4px",
        "paddingBottom": "10px",
        "paddingLeft": "12px",
        "paddingRight": "12px",
        "paddingTop": "10px"
      }
    },
    "type": "ia.container.flex"
  }
