      {
        "type": "ia.display.table",
        "meta": { "name": "ShiftsTable" },
        "position": { "grow": 1, "basis": "0" },
        "events": {
          "component": {
            "onSelectionChange": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsel = self.props.selection.data\n\tif sel is None or len(sel) == 0:\n\t\treturn\n\trow = sel[0]\n\tcode = row.get(\"StatusCode\") or \"\"\n\tif code.startswith(\"GroupHeader\"):\n\t\t# The header row is presentation only -- toggle its group's collapsed\n\t\t# state and rebuild the display list. It never reaches reconcileShiftChosen.\n\t\tsid = row.get(\"ShiftId\")\n\t\tids = list(self.view.custom.collapsedShiftIds or [])\n\t\tif sid in ids:\n\t\t\tids.remove(sid)\n\t\telse:\n\t\t\tids.append(sid)\n\t\tself.view.custom.collapsedShiftIds = ids\n\t\tself.view.rootContainer.rebuildDisplayRows()\n\t\treturn\n\tif row.get(\"StatusCode\") == \"Open\":\n\t\tBlueRidge.Common.Notify.toast(\"Shift is open\",\n\t\t\t\"This shift is still running. The live die cast screen owns it.\", \"info\")\n\t\treturn\n\tsystem.perspective.sendMessage(\"reconcileShiftChosen\", payload={\n\t\t\"shiftId\": row.get(\"ShiftId\"), \"cellLocationId\": row.get(\"CellLocationId\"),\n\t\t\"toolId\": row.get(\"ToolId\"), \"shiftLabel\": row.get(\"ShiftLabel\")}, scope=\"page\")"
              }
            }
          }
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "type": "property",
              "config": { "path": "view.custom.displayRows" }
            }
          }
