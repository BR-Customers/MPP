{
  "custom": {},
  "params": {
    "peer": {
      "Cavity": "",
      "LotName": "",
      "PieceCount": 0
    }
  },
  "propConfig": {
    "params.peer": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 52,
      "width": 300
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "3px",
        "paddingTop": "7px",
        "paddingBottom": "7px",
        "borderBottom": "1px solid var(--mpp-border-subtle)"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "PrimaryLine"
        },
        "props": {
          "direction": "row",
          "alignItems": "baseline",
          "justify": "space-between",
          "style": {
            "gap": "10px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "CavityLabel"
            },
            "props": {
              "style": {
                "classes": "pf-feed-cavity"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"Cavity \" + toStr({view.params.peer.Cavity})"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "CountLabel"
            },
            "props": {
              "style": {
                "classes": "pf-feed-metric"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.params.peer.PieceCount} > 0, toStr({view.params.peer.PieceCount}) + \" pcs\", \"lot opened\")"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "LotNameLabel"
        },
        "props": {
          "style": {
            "classes": "pf-feed-lot"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.peer.LotName"
              }
            }
          }
        }
      }
    ]
  }
}
