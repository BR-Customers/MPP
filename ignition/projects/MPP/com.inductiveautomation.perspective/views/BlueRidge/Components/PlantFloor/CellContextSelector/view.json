{
  "custom": {
    "scanCode": "",
    "selectedCellId": 3
  },
  "params": {
    "replyMessage": "cellContextChanged"
  },
  "propConfig": {
    "custom.cells": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Location.Terminal.getContextCellsForDropdown\", 0, {session.custom.terminal.terminalLocationId})"
        },
        "type": "expr"
      }
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 640
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "CellLabel"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-field-label",
            "marginBottom": "0px"
          },
          "text": "Cell:"
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tself.view.rootContainer.applyCell(self.props.value)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "CellDropdown"
        },
        "position": {
          "basis": "260px",
          "shrink": 0
        },
        "propConfig": {
          "props.options": {
            "binding": {
              "config": {
                "path": "view.custom.cells"
              },
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.custom.selectedCellId"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "placeholder": "Select cell",
          "style": {
            "classes": "pf-field-select"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "meta": {
          "name": "ScanIcon"
        },
        "position": {
          "basis": "22px",
          "shrink": 0
        },
        "props": {
          "path": "mpp/qr_code_scanner",
          "style": {
            "color": "var(--mpp-text-secondary)",
            "height": "22px",
            "width": "22px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "events": {
          "dom": {
            "onBlur": {
              "config": {
                "script": "\tself.view.rootContainer.applyByScan()"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "ScannerInput"
        },
        "position": {
          "basis": "180px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.custom.scanCode"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "placeholder": "Scan cell",
          "style": {
            "classes": "pf-field-input-mono",
            "textTransform": "uppercase"
          }
        },
        "type": "ia.input.text-field"
      },
      {
        "meta": {
          "name": "SelectedCellName"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({session.custom.cell.name} \u003d \"\", \"No cell selected\", {session.custom.cell.name})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-secondary)",
            "fontSize": "14px",
            "marginLeft": "4px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tc \u003d self.session.custom.cell\n\tif c and c.get(\"locationId\"):\n\t\tself.view.custom.selectedCellId \u003d c.get(\"locationId\")"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "pf-field-row",
        "gap": "10px",
        "padding": "8px 12px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "applyCell",
          "params": [
            "cellId"
          ],
          "script": "\tcellId \u003d BlueRidge.Common.Util.extractQualifiedValues(cellId)\n\trow \u003d BlueRidge.Location.Location.findCellById(self.view.custom.cells, cellId)\n\tif row is None:\n\t\treturn\n\tself.view.custom.selectedCellId \u003d row.get(\"value\")\n\tself.session.custom.cell \u003d {\"locationId\": row.get(\"value\"), \"code\": row.get(\"code\") or \"\", \"name\": row.get(\"name\") or \"\"}\n\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\"locationId\": row.get(\"value\"), \"code\": row.get(\"code\") or \"\", \"name\": row.get(\"name\") or \"\"}, scope\u003d\"page\")"
        },
        {
          "name": "applyByScan",
          "params": [],
          "script": "\tmatch \u003d BlueRidge.Location.Location.findCellByCode(self.view.custom.cells, self.view.custom.scanCode)\n\tif match is None:\n\t\treturn\n\tself.view.custom.scanCode \u003d \"\"\n\tself.applyCell(match.get(\"value\"))"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": null
    },
    "type": "ia.container.flex"
  }
}