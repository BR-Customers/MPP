{
  "custom": {},
  "params": {
    "CavityCode": "",
    "Description": "",
    "Id": null
  },
  "propConfig": {
    "params.CavityCode": {
      "paramDirection": "input"
    },
    "params.Description": {
      "paramDirection": "input"
    },
    "params.Id": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 72
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "CodeLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.CavityCode"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontFamily": "var(--mpp-font-mono)",
            "fontSize": "18px",
            "fontWeight": 600,
            "textTransform": "none"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "SubLabel"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-toggle-btn-meta"
          },
          "text": "CAV"
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tst = BlueRidge.Cutover.Scan.getState(self.session)\n\tst[\"entry\"][\"toolCavityId\"] = self.view.params.Id\n\tst[\"entry\"][\"cavityCode\"] = self.view.params.CavityCode\n\tself.session.custom.cutover = st"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if({view.params.Id} = {session.custom.cutover.entry.toolCavityId}, 'pf-toggle-btn pf-toggle-btn-selected', 'pf-toggle-btn')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "column",
      "justify": "center",
      "style": {
        "cursor": "pointer",
        "gap": "0px",
        "overflow": "hidden",
        "padding": "4px"
      }
    },
    "type": "ia.container.flex"
  }
}