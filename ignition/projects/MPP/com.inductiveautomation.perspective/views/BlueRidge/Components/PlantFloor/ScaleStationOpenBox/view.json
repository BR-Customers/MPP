{
  "custom": {},
  "params": {
    "terminalLocationId": null,
    "rp": {
      "ItemId": null,
      "PartNumber": "",
      "Description": "",
      "Source": "None",
      "PartsPerTray": 0,
      "TraysPerContainer": 0,
      "TargetWeight": null,
      "ToleranceWeight": null,
      "LowLimit": null,
      "HighLimit": null,
      "EligibleCount": 0,
      "Message": "",
      "OverrideItemId": null,
      "OverrideSetBy": "",
      "OverrideSetAtEt": null,
      "OpenContainerId": null,
      "OpenTraysClosed": 0,
      "OpenPartsClosed": 0
    }
  },
  "propConfig": {
    "params.terminalLocationId": {
      "paramDirection": "input"
    },
    "params.rp": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 220,
      "width": 720
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-panel",
        "gap": "12px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "12px"
          },
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Kicker"
            },
            "props": {
              "text": "OPEN BOX",
              "style": {
                "classes": "pf-kpi-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "BoxId"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(isNull({view.params.rp.OpenContainerId}), 'No box open: the next good press opens one', 'Box #' + toStr({view.params.rp.OpenContainerId}))"
                  }
                }
              }
            },
            "position": {
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "LabelHint"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.params.rp.TraysPerContainer} > 0, 'Label prints when tray ' + toStr({view.params.rp.TraysPerContainer}) + ' closes', '')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Counts"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "20px"
          },
          "alignItems": "baseline"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Trays"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "toStr({view.params.rp.OpenTraysClosed}) + ' of ' + toStr({view.params.rp.TraysPerContainer}) + ' trays'"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Parts"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "toStr({view.params.rp.OpenPartsClosed}) + ' of ' + toStr({view.params.rp.TraysPerContainer} * {view.params.rp.PartsPerTray}) + ' parts'"
                  }
                }
              }
            },
            "position": {
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ToGo"
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "toStr(toInt(max(0, {view.params.rp.TraysPerContainer} - {view.params.rp.OpenTraysClosed}))) + ' trays to go'"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "TrayStrip"
        },
        "position": {
          "basis": "48px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "path": "BlueRidge/Components/PlantFloor/ScaleStationTrayCell",
          "elementPosition": {
            "basis": "48px",
            "grow": 0,
            "shrink": 0
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false,
          "wrap": "wrap"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"BlueRidge.Workorder.ScaleStation.trayCellsFor\", 0, {view.params.rp.TraysPerContainer}, {view.params.rp.OpenTraysClosed}, {view.params.rp.OpenContainerId})"
              }
            }
          }
        }
      }
    ]
  }
}
