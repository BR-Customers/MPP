{
  "custom": {},
  "params": {
    "rowData": {
      "CurrentLocationName": "",
      "LastOperationName": ""
    },
    "value": ""
  },
  "propConfig": {
    "params.rowData": {
      "paramDirection": "input"
    },
    "params.value": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 190
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "NameLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-primary)",
            "fontSize": "14px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "OpChip"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.rowData.LastOperationName}, \"\") !\u003d \"\""
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.rowData.LastOperationName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "background": "var(--mpp-accent-20)",
            "borderRadius": "4px",
            "color": "var(--mpp-accent-70)",
            "fontSize": "11px",
            "fontWeight": "600",
            "padding": "1px 7px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NoOpLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.rowData.LastOperationName}, \"\") \u003d \"\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-text-tertiary)",
            "fontSize": "11px"
          },
          "text": "no operation yet"
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "flex-start",
      "direction": "column",
      "justify": "center",
      "style": {
        "gap": "2px",
        "height": "100%",
        "paddingLeft": "4px",
        "width": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}