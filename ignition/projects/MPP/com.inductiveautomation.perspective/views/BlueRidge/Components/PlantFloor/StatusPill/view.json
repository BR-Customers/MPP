{
  "custom": {},
  "params": {
    "value": ""
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 120
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Pill"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "\"pf-pill \" + if({view.params.value} \u003d \"Good\", \"pf-pill-good\", if({view.params.value} \u003d \"Held\", \"pf-pill-hold\", if({view.params.value} \u003d \"Scrapped\", \"pf-pill-bad\", if({view.params.value} \u003d \"Rejected\", \"pf-pill-bad\", \"pf-pill\"))))"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderRadius": "999px",
            "fontSize": "12px",
            "fontWeight": "600",
            "padding": "3px 10px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "height": "100%",
        "width": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}