{
  "custom": {},
  "params": {
    "IsLow": false,
    "ItemPartNumber": "",
    "OnHand": 0,
    "ProjectedRemainingConsumption": 0
  },
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "PartNum"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.ItemPartNumber}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontWeight": 600
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Need"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "toStr({view.params.ProjectedRemainingConsumption}) + \" needed / \" + toStr({view.params.OnHand}) + \" have\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "13px",
            "opacity": 0.85
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Low"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.IsLow}, \"LOW\", \"\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "#e05a4d",
            "fontSize": "12px",
            "fontWeight": 700,
            "minWidth": "34px",
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "gap": "8px"
      }
    },
    "type": "ia.container.flex"
  }
}