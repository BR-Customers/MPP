              }
            ],
            "meta": {
              "name": "HoldTypeField"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "L"
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Reason"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Reason"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.placeDraft.reason"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": "Reason for hold",
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.text-field"
              }
            ],
            "meta": {
              "name": "ReasonField"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\td \u003d self.view.custom.placeDraft\n\tt \u003d self.view.custom.target or {}\n\thtc \u003d d.get(\"holdTypeCodeId\")\n\treason \u003d (d.get(\"reason\") or \"\").strip() or None\n\tkind \u003d t.get(\"kind\")\n\ttid \u003d t.get(\"id\") or 0\n\tif htc is None:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Select a hold type.\"}, \"Place Hold\")\n\t\treturn\n\tif not tid:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"No target selected.\"}, \"Place Hold\")\n\t\treturn\n\tterm \u003d self.session.custom.terminal\n\ttermId \u003d term.terminalLocationId if term else None\n\tres \u003d BlueRidge.Quality.Hold.place(htc, lotId\u003d(tid if kind \u003d\u003d \"lot\" else None), containerId\u003d(tid if kind \u003d\u003d \"container\" else None), reason\u003dreason, appUserId\u003dself.session.custom.appUserId, terminalLocationId\u003dtermId)\n\tBlueRidge.Common.Ui.notifyResult(res, \"Hold placed\")\n\tif res and res.get(\"Status\"):\n\t\tif kind \u003d\u003d \"lot\":\n\t\t\tcons \u003d BlueRidge.Quality.Hold.listAssociatedContainers(tid) or []\n\t\t\tif len(cons) \u003e 0:\n\t\t\t\tBlueRidge.Common.Notify.toast(\"Container advisory\", str(len(cons)) + \" associated container(s) - review whether they need holding too.\", \"warning\")\n\t\tself.view.rootContainer.refresh()\n\t\tsystem.perspective.sendMessage(\"holdChanged\", payload\u003d{\"lotId\": (tid if kind \u003d\u003d \"lot\" else 0), \"containerId\": (tid if kind \u003d\u003d \"container\" else 0), \"action\": \"placed\", \"holdEventId\": res.get(\"NewId\")}, scope\u003d\"page\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "PlaceButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary "
              },
              "text": "Place hold"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "PlaceGroup"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.target.id} \u003e 0 \u0026\u0026 !coalesce({view.custom.hold.IsHeld}, false)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "pf-panel",
            "overflow": "hidden",
            "padding": "16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "ReleaseTitle"
            },
            "props": {
              "style": {
                "fontSize": "16px",
                "fontWeight": "700"
              },
              "text": "Release hold"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "HoldSummary"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Hold #\" + toStr({view.custom.hold.Id}) + \"  ·  \" + coalesce({view.custom.hold.HoldTypeCode}, \"\") + if(isNull({view.custom.hold.PlacedByInitials}), \"\", \"  ·  \" + {view.custom.hold.PlacedByInitials}) + if(isNull({view.custom.hold.Reason}) || {view.custom.hold.Reason} \u003d \"\", \"\", \"  ·  \" + {view.custom.hold.Reason})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-queue-detail"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "L"
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Release remarks"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ReleaseRemarks"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.releaseDraft.releaseRemarks"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": "Reason for release",
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.text-field"
              }
            ],
            "meta": {
              "name": "RemarksField"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\th \u003d self.view.custom.hold or {}\n\theId \u003d h.get(\"Id\")\n\tt \u003d self.view.custom.target or {}\n\tif not heId:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"No open hold to release.\"}, \"Release Hold\")\n\t\treturn\n\trd \u003d self.view.custom.releaseDraft or {}\n\tremarks \u003d (rd.get(\"releaseRemarks\") or \"\").strip() or None\n\tterm \u003d self.session.custom.terminal\n\ttermId \u003d term.terminalLocationId if term else None\n\tres \u003d BlueRidge.Quality.Hold.release(heId, releaseRemarks\u003dremarks, appUserId\u003dself.session.custom.appUserId, terminalLocationId\u003dtermId)\n\tBlueRidge.Common.Ui.notifyResult(res, \"Hold released\")\n\tif res and res.get(\"Status\"):\n\t\tkind \u003d t.get(\"kind\")\n\t\ttid \u003d t.get(\"id\") or 0\n\t\tself.view.rootContainer.refresh()\n\t\tsystem.perspective.sendMessage(\"holdChanged\", payload\u003d{\"lotId\": (tid if kind \u003d\u003d \"lot\" else 0), \"containerId\": (tid if kind \u003d\u003d \"container\" else 0), \"action\": \"released\", \"holdEventId\": heId}, scope\u003d\"page\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ReleaseButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary pf-btn-large"
              },
              "text": "Release hold"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "ReleaseGroup"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.target.id} \u003e 0 \u0026\u0026 coalesce({view.custom.hold.IsHeld}, false)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "pf-panel",
            "gap": "12px",
            "padding": "16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "EmptyHint"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.target.id} \u003d 0 \u0026\u0026 !coalesce({view.custom.allowLookup}, false)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub"
          },
          "text": "No LOT or container selected."
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tself.applyTarget(self.view.params.lotId, self.view.params.containerId, self.view.params.allowLookup)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-panel",
        "gap": "12px",
        "padding": "16px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "applyTarget",
          "params": [
            "lotId",
            "containerId",
            "allowLookup"
          ],
          "script": "\tlid \u003d BlueRidge.Common.Util.toIntOrNone(lotId) or 0\n\tcid \u003d BlueRidge.Common.Util.toIntOrNone(containerId) or 0\n\tif lid \u003e 0:\n\t\tlot \u003d BlueRidge.Lots.Lot.get(lid) or {}\n\t\ttgt \u003d {\"kind\": \"lot\", \"id\": lid, \"label\": (lot.get(\"LotName\") or (\"LOT #\" + str(lid)))}\n\telif cid \u003e 0:\n\t\ttgt \u003d {\"kind\": \"container\", \"id\": cid, \"label\": \"Container #\" + str(cid)}\n\telse:\n\t\ttgt \u003d {\"kind\": None, \"id\": 0, \"label\": \"\"}\n\tself.view.custom.target \u003d tgt\n\tself.view.custom.allowLookup \u003d bool(allowLookup)\n\tself.refresh()"
        },
        {
          "name": "refresh",
          "params": [],
          "script": "\tt \u003d self.view.custom.target or {}\n\tkind \u003d t.get(\"kind\")\n\ttid \u003d t.get(\"id\") or 0\n\tif kind \u003d\u003d \"lot\" and tid \u003e 0:\n\t\tself.view.custom.hold \u003d BlueRidge.Quality.Hold.getOpenByLotOne(tid)\n\telif kind \u003d\u003d \"container\" and tid \u003e 0:\n\t\tself.view.custom.hold \u003d BlueRidge.Quality.Hold.getOpenByContainerOne(tid)\n\telse:\n\t\tself.view.custom.hold \u003d {\"IsHeld\": False, \"Id\": None, \"HoldTypeCode\": None, \"Reason\": None, \"PlacedByInitials\": None, \"PlacedAt\": None}\n\tself.view.custom.placeDraft \u003d {\"holdTypeCodeId\": None, \"reason\": \"\"}\n\tself.view.custom.releaseDraft \u003d {\"releaseRemarks\": \"\"}"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "holdPanelLoad",
          "pageScope": true,
          "script": "\tself.applyTarget(payload.get(\"lotId\"), payload.get(\"containerId\"), payload.get(\"allowLookup\"))",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}