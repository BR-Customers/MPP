            },
            "position": {
              "basis": "260px",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "L"
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Container Id"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LookupContainerId"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.lookupDraft.containerId"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": "Container Id",
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.text-field"
              }
            ],
            "meta": {
              "name": "LookupContainerField"
            },
            "position": {
              "basis": "180px",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field",
                "gap": "4px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\td \u003d self.view.custom.lookupDraft\n\tlotName \u003d (d.get(\"lotName\") or \"\").strip()\n\tcid \u003d BlueRidge.Common.Util.toIntOrNone(d.get(\"containerId\"))\n\tif lotName and cid is not None:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Enter only one of LOT name or Container Id, not both.\"}, \"Load target\")\n\t\treturn\n\tif not lotName and cid is None:\n\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"Enter a LOT name or a Container Id.\"}, \"Load target\")\n\t\treturn\n\tif lotName:\n\t\tlot \u003d BlueRidge.Lots.Lot.getByName(lotName)\n\t\tif not lot or lot.get(\"Id\") is None:\n\t\t\tBlueRidge.Common.Ui.notifyResult({\"Status\": False, \"Message\": \"No LOT found named \u0027\" + lotName + \"\u0027.\"}, \"Load target\")\n\t\t\treturn\n\t\tself.view.rootContainer.applyTarget(lot.get(\"Id\"), 0, True)\n\telse:\n\t\tself.view.rootContainer.applyTarget(0, cid, True)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "LoadButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
