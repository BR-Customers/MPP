{
  "custom": {
    "adAccount": "",
    "busy": false,
    "error": "",
    "password": ""
  },
  "params": {
    "actionCode": "",
    "actionLabel": "Protected Action",
    "popupId": "mpp-elevation-modal",
    "replyMessage": "elevationResult"
  },
  "propConfig": {
    "params.actionCode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.actionLabel": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 540,
      "width": 480
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "LockIcon"
            },
            "position": {
              "basis": "22px",
              "shrink": 0
            },
            "props": {
              "path": "mpp/lock",
              "style": {
                "height": "22px",
                "width": "22px"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "HeaderTitle"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Authorize: \" + {view.params.actionLabel}"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "classes": "modal-header",
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Prompt"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "color": "var(--mpp-text-secondary)",
                "fontSize": "13px"
              },
              "text": "Enter your Active Directory credentials to authorize this action."
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "AccountLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "AD Username"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "AccountInput"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.adAccount"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": "domain\\username",
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.text-field"
              }
            ],
            "meta": {
              "name": "AccountField"
            },
            "position": {
              "basis": "30%",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "PasswordLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-field-label"
                  },
                  "text": "Password"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "PasswordInput"
                },
                "position": {
                  "basis": "45px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.password"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "placeholder": "Password",
                  "style": {
                    "classes": "pf-field-input"
                  }
                },
                "type": "ia.input.password-field"
              }
            ],
            "meta": {
              "name": "PasswordField"
            },
            "position": {
              "basis": "30%",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "pf-field"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "ErrorLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.error} !\u003d \"\""
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.error"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--mpp-state-bad-fg)",
                "fontSize": "13px"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Body"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "modal-body"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(self.view.params.replyMessage, payload\u003d{\"success\": False, \"cancelled\": True}, scope\u003d\"page\")\n\tsystem.perspective.closePopup(id\u003dself.view.params.popupId)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CancelButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tres \u003d BlueRidge.Location.AppUser.elevate(self.view.custom.adAccount, self.view.custom.password, self.view.params.actionCode, self.session.custom.terminal.terminalLocationId)\n\tif res.get(\"success\"):\n\t\tsystem.perspective.sendMessage(self.view.params.replyMessage, res, scope\u003d\"page\")\n\t\tsystem.perspective.closePopup(self.view.params.popupId)\n\telse:\n\t\tself.view.custom.error \u003d res.get(\"message\") or \"Authentication failed\""
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "AuthenticateButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary"
              },
              "text": "Authenticate"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Footer"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "flex-end",
          "style": {
            "classes": "modal-footer",
            "gap": "10px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "modal"
      }
    },
    "type": "ia.container.flex"
  }
}