{
  "custom": {
    "alert": {
      "text": "",
      "visible": false,
      "shippingLabelId": null
    },
    "seen": []
  },
  "params": {},
  "props": {
    "defaultSize": {
      "height": 52,
      "width": 700
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Msg"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.alert.text"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--pf-status-warn-fg, #7c2d12)",
                "fontWeight": "600"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsid = self.view.custom.alert.shippingLabelId\n\tif sid is None:\n\t\treturn\n\tresult = BlueRidge.Lots.Shipping.reprintAndDispatch(sid, None, BlueRidge.Common.Session.currentAppUserId(self.session), self.session.custom.terminal.terminalLocationId)\n\tBlueRidge.Common.Ui.notifyPrintResult(result, \"Label reprinted\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Reprint"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "!isNull({view.custom.alert.shippingLabelId})"
                  }
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-primary"
              },
              "text": "Reprint"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsid = self.view.custom.alert.shippingLabelId\n\tif sid is not None:\n\t\tBlueRidge.Lots.Shipping.ackBanner(sid)\n\tself.view.custom.alert = {\"visible\": False, \"text\": \"\", \"shippingLabelId\": None}"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Ack"
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary"
              },
              "text": "Acknowledge"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Banner"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.alert.visible}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "style": {
            "backgroundColor": "var(--pf-status-warn-bg, #fde68a)",
            "borderRadius": "6px",
            "gap": "12px",
            "padding": "10px 16px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "print-failure-alert",
          "pageScope": true,
          "script": "\tr = BlueRidge.Lots.PrintFailureGateway.handleAlert(self.session, payload, self.view.custom.seen)\n\tif r:\n\t\tself.view.custom.seen = r[\"seen\"]\n\t\tself.view.custom.alert = r[\"alert\"]",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}
