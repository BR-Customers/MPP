          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "propConfig": {
          "props.params.terminalLocationId": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tid}"
              }
            }
          }
        }
      }
    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "scalePressRecorded",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\ttid = (payload or {}).get(\"terminalLocationId\")\n\tif tid is None or str(tid) == str(self.view.custom.tid):\n\t\tself.view.custom.pressToken = (self.view.custom.pressToken or 0) + 1"
        },
        {
          "messageType": "scaleRunningPartChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\ttid = (payload or {}).get(\"terminalLocationId\")\n\tif tid is None or str(tid) == str(self.view.custom.tid):\n\t\tself.view.custom.pressToken = (self.view.custom.pressToken or 0) + 1"
        },
        {
          "messageType": "inventoryChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\ttid = (payload or {}).get(\"terminalLocationId\")\n\tif tid is None or str(tid) == str(self.view.custom.tid):\n\t\tself.view.custom.pressToken = (self.view.custom.pressToken or 0) + 1"
        }
      ]
    }
