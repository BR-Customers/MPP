    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "scalePressRecorded",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif BlueRidge.Workorder.ScaleStation.shouldRefresh(\"scalePressRecorded\", payload, self.view.custom.tid, self.view.custom.cellId):\n\t\tself.view.custom.pressToken = (self.view.custom.pressToken or 0) + 1"
        },
        {
          "messageType": "scaleRunningPartChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif BlueRidge.Workorder.ScaleStation.shouldRefresh(\"scaleRunningPartChanged\", payload, self.view.custom.tid, self.view.custom.cellId):\n\t\tself.view.custom.pressToken = (self.view.custom.pressToken or 0) + 1"
        },
        {
          "messageType": "inventoryChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
