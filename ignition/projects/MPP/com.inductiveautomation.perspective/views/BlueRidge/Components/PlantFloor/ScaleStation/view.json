{
  "custom": {
    "pressToken": 0,
    "tid": null
  },
  "params": {
    "terminalLocationId": null
  },
  "propConfig": {
    "params.terminalLocationId": {
      "paramDirection": "input"
    },
    "custom.tid": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(isNull({view.params.terminalLocationId}), {session.custom.terminal.terminalLocationId}, {view.params.terminalLocationId})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1500
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "14px",
        "minHeight": "100%",
        "boxSizing": "border-box",
        "overflowY": "auto",
        "gap": "14px"
      }
    },
    "children": [
      {
        "type": "ia.display.view",
        "meta": {
          "name": "RunningPart"
        },
        "position": {
          "basis": "96px",
          "grow": 0
        },
        "props": {
          "path": "BlueRidge/Components/PlantFloor/ScaleStationRunningPart",
          "params": {
            "terminalLocationId": null,
            "pressToken": 0
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "propConfig": {
          "props.params.terminalLocationId": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tid}"
              }
            }
          },
          "props.params.pressToken": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.pressToken}"
              }
            }
          }
        }
      },
