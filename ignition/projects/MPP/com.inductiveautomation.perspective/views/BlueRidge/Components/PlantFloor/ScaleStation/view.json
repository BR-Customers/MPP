  "params": {
    "terminalLocationId": null
  },
  "propConfig": {
    "params.terminalLocationId": {
      "paramDirection": "input"
    },
    "custom.tid": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(isNull({view.params.terminalLocationId}), {session.custom.terminal.terminalLocationId}, {view.params.terminalLocationId})"
        }
      }
    },
    "custom.cellId": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{session.custom.cell.locationId}"
        }
      }
    },
    "custom.rp": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"BlueRidge.Workorder.ScaleStation.getRunningPartOrEmpty\", 0, {view.custom.tid}, {view.custom.pressToken})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1500
    }
  },
