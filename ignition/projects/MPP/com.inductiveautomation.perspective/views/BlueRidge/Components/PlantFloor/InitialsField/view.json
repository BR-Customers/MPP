{
  "custom": {
    "initials": "",
    "resolved": {
      "appUserId": null,
      "checked": false,
      "displayName": "",
      "valid": false
    }
  },
  "params": {
    "label": "Initials",
    "replyMessage": "initialsResolved"
  },
  "propConfig": {
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.replyMessage": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 78,
      "width": 280
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "FieldLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-field-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onBlur": {
              "config": {
                "script": "\tself.view.rootContainer.resolveInitials()"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "InitialsInput"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.custom.initials"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "placeholder": "Enter initials",
          "style": {
            "classes": "pf-field-input-mono",
            "textTransform": "uppercase"
          }
        },
        "type": "ia.input.text-field"
      },
      {
        "meta": {
          "name": "ResolvedName"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.resolved.valid}"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.resolved.displayName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-state-good-fg)",
            "fontSize": "13px",
            "marginTop": "2px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NotRecognised"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.resolved.checked} \u0026\u0026 !{view.custom.resolved.valid} \u0026\u0026 {view.custom.initials} !\u003d \"\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--mpp-state-bad-fg)",
            "fontSize": "13px",
            "marginTop": "2px"
          },
          "text": "Initials not recognised"
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tu \u003d self.session.custom.user\n\tif self.session.custom.presence.policy \u003d\u003d \"confirm\" and u and u.get(\"initials\"):\n\t\tself.view.custom.initials \u003d u.get(\"initials\")\n\t\tself.resolveInitials()"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-field"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "resolveInitials",
          "params": [],
          "script": "\tres \u003d BlueRidge.Location.AppUser.resolveForPresence(self.view.custom.initials)\n\tself.view.custom.resolved \u003d res\n\tsystem.perspective.sendMessage(self.view.params.replyMessage, res, scope\u003d\"page\")"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": null
    },
    "type": "ia.container.flex"
  }
}