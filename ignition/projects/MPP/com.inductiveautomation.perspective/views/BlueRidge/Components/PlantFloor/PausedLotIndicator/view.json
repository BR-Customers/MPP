{
  "custom": {
    "count": {
      "OpenPauseCount": 0
    }
  },
  "params": {
    "locationId": null
  },
  "propConfig": {
    "params.locationId": {
      "onChange": {
        "enabled": true,
        "script": "\tself.view.rootContainer.load()"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 44,
      "width": 160
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "PauseIcon"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": "14px",
            "lineHeight": "1"
          },
          "text": "⏸"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "PausedLabel"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": "13px",
            "fontWeight": "500"
          },
          "text": "Paused"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "CountChip"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "toStr({view.custom.count.OpenPauseCount})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "alignItems": "center",
            "background": "var(--pf-status-warn-fg)",
            "borderRadius": "12px",
            "color": "var(--bg-panel)",
            "display": "inline-flex",
            "fontSize": "13px",
            "fontWeight": "700",
            "height": "24px",
            "justifyContent": "center",
            "minWidth": "32px",
            "padding": "0 8px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tsystem.perspective.openPopup(id\u003d\"mpp-paused-list\", view\u003d\"BlueRidge/Components/Popups/PausedLotList\", params\u003d{\"locationId\": self.view.params.locationId}, modal\u003dTrue)"
          },
          "scope": "G",
          "type": "script"
        }
      },
      "system": {
        "onStartup": {
          "config": {
            "script": "\tself.load()"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "background": "var(--pf-status-warn-bg)",
        "border": "1px solid var(--pf-status-warn-fg)",
        "borderRadius": "var(--radius-lg)",
        "color": "var(--pf-status-warn-fg)",
        "cursor": "pointer",
        "display": "inline-flex",
        "fontSize": "13px",
        "fontWeight": "500",
        "gap": "8px",
        "padding": "8px 14px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "load",
          "params": [],
          "script": "\tresult \u003d BlueRidge.Lots.LotPause.getCountByLocation(self.view.params.locationId)\n\tself.view.custom.count \u003d result if result is not None else {\"OpenPauseCount\": 0}"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "pausedLotResumed",
          "pageScope": true,
          "script": "\tself.load()",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}