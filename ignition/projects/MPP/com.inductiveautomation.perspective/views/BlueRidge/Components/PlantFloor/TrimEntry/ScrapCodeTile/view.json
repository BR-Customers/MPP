{
  "custom": {},
  "params": {
    "badge": "",
    "code": "",
    "defectCodeId": null,
    "description": "",
    "isPrimary": false,
    "isSelected": false,
    "quantity": 0
  },
  "propConfig": {
    "params.badge": {
      "paramDirection": "input"
    },
    "params.code": {
      "paramDirection": "input"
    },
    "params.defectCodeId": {
      "paramDirection": "input"
    },
    "params.description": {
      "paramDirection": "input"
    },
    "params.isPrimary": {
      "paramDirection": "input"
    },
    "params.isSelected": {
      "paramDirection": "input"
    },
    "params.quantity": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 64,
      "width": 152
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "DescLabel"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.description"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "13px",
            "fontWeight": "600",
            "letterSpacing": "normal",
            "overflow": "hidden",
            "textAlign": "center",
            "textTransform": "none",
            "whiteSpace": "normal"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "CodeLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.code"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-toggle-btn-meta",
                "fontSize": "11px",
                "overflow": "hidden"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "CountLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "{view.params.quantity} \u003e 0"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.badge"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "--mpp-accent-90",
                "fontSize": "11px",
                "fontWeight": "600",
                "overflow": "hidden"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "MetaRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "gap": "6px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tsystem.perspective.sendMessage(\"trimScrapChanged\", payload\u003d{\"defectCodeId\": self.view.params.defectCodeId, \"delta\": 1}, scope\u003d\"page\")"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root",
      "tooltip": {
        "text": "Tap to add 1"
      }
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if({view.params.isSelected}, \u0027pf-toggle-btn pf-toggle-btn-selected\u0027, \u0027pf-toggle-btn\u0027)"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "justify": "space-between",
      "style": {
        "cursor": "pointer",
        "minHeight": "64px",
        "overflow": "hidden",
        "padding": "4px 4px",
        "textAlign": "center"
      }
    },
    "type": "ia.container.flex"
  }
}