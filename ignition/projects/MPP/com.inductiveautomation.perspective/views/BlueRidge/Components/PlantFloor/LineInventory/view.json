{
  "custom": {
    "lastShortPart": "",
    "lineWide": false,
    "locationId": null,
    "lock": {
      "available": 0,
      "boxQuantity": null,
      "description": "",
      "finishedGoodItemId": null,
      "itemId": null,
      "partNumber": "",
      "piecesPerTray": 0,
      "short": false,
      "shortCount": 0,
      "thresholdTrays": 0,
      "traysLeft": 0
    },
    "lockShort": false,
    "refreshToken": 0,
    "released": false,
    "showLock": false
  },
  "params": {
    "locationId": null,
    "lockEnabled": false,
    "terminalRole": ""
  },
  "propConfig": {
    "custom.footer": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Lots.Lot.getLineInventoryFooter\", 30000, {view.custom.locationId}, {view.params.terminalRole}, {view.custom.lineWide}, {view.custom.refreshToken})"
        },
        "type": "expr"
      }
    },
    "custom.locationId": {
      "binding": {
        "config": {
          "expression": "if(isNull({view.params.locationId}), {session.custom.cell.locationId}, {view.params.locationId})"
        },
        "type": "expr"
      }
    },
    "custom.lock": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Workorder.Assembly.getLowInventoryLock\", 30000, if({view.params.lockEnabled}, {view.custom.locationId}, null), {session.custom.selectedFinishedGoodItemId}, {session.custom.closureMethod}, {view.custom.refreshToken})"
        },
        "type": "expr"
      }
    },
    "custom.lockShort": {
      "binding": {
        "config": {
          "expression": "{view.custom.lock.short}"
        },
        "type": "expr"
      },
      "onChange": {
        "enabled": true,
        "script": "\t# Low-inventory lock -\u003e downtime. Start when a part goes short; end only on a\n\t# real short -\u003e clear transition seen by THIS terminal (never on first load, so\n\t# another station\u0027s page opening cannot end an event that is still warranted).\n\tnow \u003d bool(currentValue.value) if currentValue is not None else False\n\twas \u003d bool(previousValue.value) if previousValue is not None else False\n\tif now \u003d\u003d was or not self.params.lockEnabled:\n\t\treturn\n\tif now:\n\t\tself.custom.lastShortPart \u003d self.custom.lock.description\n\tuid \u003d BlueRidge.Common.Session.currentAppUserId(self.session) or BlueRidge.Common.Util.systemAppUserId()\n\ttid \u003d None\n\ttry:\n\t\ttid \u003d self.session.custom.terminal.terminalLocationId\n\texcept:\n\t\ttid \u003d None\n\tBlueRidge.Workorder.Assembly.syncLowInventoryDowntime(self.custom.locationId, now, self.custom.lastShortPart, uid, tid)"
      }
    },
    "custom.showLock": {
      "binding": {
        "config": {
          "expression": "{view.custom.lock.short} \u0026\u0026 !{view.custom.released}"
        },
        "type": "expr"
      },
      "onChange": {
        "enabled": true,
        "script": "\t# Open / close the full-screen low-inventory lock.\n\tnow \u003d bool(currentValue.value) if currentValue is not None else False\n\twas \u003d bool(previousValue.value) if previousValue is not None else False\n\tif now and not was:\n\t\tsystem.perspective.openPopup(\"mpp-low-inventory-lock\", \"BlueRidge/Components/Popups/LowInventoryLock\", params\u003d{\"locationId\": self.custom.locationId, \"finishedGoodItemId\": self.session.custom.selectedFinishedGoodItemId, \"closureMethod\": self.session.custom.closureMethod}, modal\u003dTrue, showCloseIcon\u003dFalse, overlayDismiss\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, position\u003d{\"left\": 0, \"top\": 0, \"width\": \"100%\", \"height\": \"100%\"})\n\telif was and not now:\n\t\tsystem.perspective.closePopup(\"mpp-low-inventory-lock\")"
      }
    },
    "params.locationId": {
      "paramDirection": "input"
    },
    "params.lockEnabled": {
      "paramDirection": "input"
    },
    "params.terminalRole": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 700,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Title"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "pf-inv-title"
                  },
                  "text": "Line Inventory"
                },
                "type": "ia.display.label"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.custom.lineWide \u003d not bool(self.view.custom.lineWide)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "LineWideButton"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "if({view.custom.lineWide}, \"pf-btn pf-inv-hbtn pf-inv-hbtn-on\", \"pf-btn pf-inv-hbtn\")"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {},
                  "text": "Line-wide"
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.perspective.openPopup(\"mpp-line-tolerances\", \"BlueRidge/Components/PlantFloor/LineTolerances\", params\u003d{\"locationId\": self.view.custom.locationId}, modal\u003dTrue, showCloseIcon\u003dTrue)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "TolerancesButton"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "pf-btn pf-inv-hbtn"
                  },
                  "text": "Tolerances"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "HeadRow"
            },
            "props": {
              "style": {
                "classes": "pf-inv-hrow"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Sub"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "runScript(\"BlueRidge.Lots.Lot.getLineInventoryHeader\", 30000, {view.custom.locationId}, {view.params.terminalRole}, {view.custom.lineWide}, {view.custom.refreshToken})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-inv-sub"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Head"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "pf-inv-head"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Rows"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "expression": "runScript(\"BlueRidge.Lots.Lot.getLineInventoryInstances\", 30000, {view.custom.locationId}, {view.params.terminalRole}, {view.custom.lineWide}, {view.custom.refreshToken})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "40px",
            "grow": 0,
            "shrink": 0
          },
          "path": "BlueRidge/Components/PlantFloor/LineInventoryRow",
          "style": {
            "classes": "pf-inv-list"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "children": [
          {
            "meta": {
              "name": "FootText"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if(indexOf({view.custom.footer}, \"attention\") \u003e\u003d 0, \"pf-inv-foottxt pf-inv-foottxt-warn\", \"pf-inv-foottxt\")"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.footer"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {}
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\"mpp-inventory\", \"BlueRidge/Components/PlantFloor/InventoryManager\", params\u003d{\"locationId\": self.view.custom.locationId}, modal\u003dFalse, showCloseIcon\u003dTrue, draggable\u003dTrue, resizable\u003dTrue)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "DetailButton"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-btn pf-btn-secondary pf-inv-btn",
                "width": "auto"
              },
              "text": "Detail..."
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Foot"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-inv-foot"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-inv-panel",
        "height": "100%"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "inventoryChanged",
          "pageScope": true,
          "script": "\tself.view.custom.refreshToken \u003d (self.view.custom.refreshToken or 0) + 1\n\t# A supervisor release of the low-inventory lock lasts until stock next changes\n\t# at THIS line (a tray closed, a box added). A gateway broadcast for another\n\t# line carries its own cellLocationId and is ignored here.\n\tcell \u003d (payload or {}).get(\"cellLocationId\")\n\tif cell is None or cell \u003d\u003d self.view.custom.locationId:\n\t\tself.view.custom.released \u003d False",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "lowInventoryReleaseRequested",
          "pageScope": true,
          "script": "\t# Replayed by Common.Session.dispatchElevatedAction once a supervisor has\n\t# authenticated. Re-test the window: a page message alone is not authority.\n\tif not self.view.params.lockEnabled:\n\t\treturn\n\tif BlueRidge.Common.Session.isElevated(self.session):\n\t\tself.view.custom.released \u003d True",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}