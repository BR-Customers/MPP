{
  "custom": {},
  "params": {},
  "propConfig": {
    "custom.depths": {
      "binding": {
        "config": {
          "expression": "runScript(\"BlueRidge.Lots.AimPool.getDepth\")"
        },
        "transforms": [
          {
            "code": "\treturn [{\"PartNumber\": r.get(\"PartNumber\") or \"\", \"Depth\": r.get(\"Depth\") or 0} for r in (value or [])]",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.perPartText": {
      "binding": {
        "config": {
          "path": "view.custom.depths"
        },
        "transforms": [
          {
            "code": "\trows \u003d value or []\n\tif not rows:\n\t\treturn \"No available IDs\"\n\treturn \"  |  \".join([((r.get(\"PartNumber\") or \"?\") + \": \" + str(r.get(\"Depth\") or 0)) for r in rows])",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.total": {
      "binding": {
        "config": {
          "path": "view.custom.depths"
        },
        "transforms": [
          {
            "code": "\treturn sum([(r.get(\"Depth\") or 0) for r in (value or [])])",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.valueClass": {
      "binding": {
        "config": {
          "path": "view.custom.total"
        },
        "transforms": [
          {
            "code": "\tt \u003d value or 0\n\tif t \u003c\u003d 10:\n\t\treturn \"pf-kpi-value pf-kpi-value-bad\"\n\tif t \u003c\u003d 20:\n\t\treturn \"pf-kpi-value pf-kpi-value-warn\"\n\treturn \"pf-kpi-value pf-kpi-value-good\"",
            "type": "script"
          }
        ],
        "type": "property"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 220,
      "width": 360
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-kpi-label"
          },
          "text": "AIM Shipper Pool"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Total"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "view.custom.valueClass"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "toStr({view.custom.total})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {}
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Caption"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub"
          },
          "text": "total available IDs across part numbers"
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "PerPartLabel"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "pf-kpi-label"
              },
              "text": "Per part number"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "PerPart"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.perPartText"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-kpi-sub"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "PerPartBlock"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "borderTop": "1px dashed var(--mpp-border-subtle)",
            "gap": "3px",
            "marginTop": "4px",
            "paddingTop": "8px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-kpi pf-panel",
        "gap": "6px",
        "padding": "16px"
      }
    },
    "type": "ia.container.flex"
  }
}