{
  "custom": {},
  "params": {
    "defectCodeId": null,
    "code": "",
    "description": "",
    "quantity": 0
  },
  "propConfig": {
    "params.defectCodeId": { "paramDirection": "input" },
    "params.code": { "paramDirection": "input" },
    "params.description": { "paramDirection": "input" },
    "params.quantity": { "paramDirection": "input" }
  },
  "props": { "defaultSize": { "height": 52, "width": 480 } },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "alignItems": "center",
      "style": {
        "background": "var(--mpp-surface-card)",
        "border": "1px solid var(--mpp-border-subtle)",
        "borderRadius": "var(--mpp-radius-md)",
        "gap": "6px",
        "overflow": "hidden",
        "padding": "4px 6px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": { "name": "Info" },
        "position": { "basis": "0", "grow": 1, "shrink": 1 },
        "props": {
          "direction": "column",
          "style": { "gap": "0px", "overflow": "hidden" }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": { "name": "DescLabel" },
            "propConfig": {
              "props.text": {
                "binding": { "type": "property", "config": { "path": "view.params.description" } }
              }
            },
            "props": {
              "style": {
                "fontSize": "13px",
                "fontWeight": 600,
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": { "name": "CodeLabel" },
            "propConfig": {
              "props.text": {
                "binding": { "type": "property", "config": { "path": "view.params.code" } }
              }
            },
            "props": { "style": { "classes": "pf-field-help", "overflow": "hidden" } }
          }
        ]
      },
      {
        "type": "ia.input.button",
        "meta": { "name": "MinusButton", "tooltip": { "text": "One less" } },
        "position": { "basis": "44px", "shrink": 0 },
        "props": {
          "text": "-",
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "fontSize": "20px",
            "fontWeight": 700,
            "minHeight": "44px",
            "padding": "0"
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"trimScrapChanged\", payload={\"defectCodeId\": self.view.params.defectCodeId, \"delta\": -1}, scope=\"page\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.text-field",
        "meta": { "name": "QtyInput", "tooltip": { "text": "Type a quantity" } },
        "position": { "basis": "68px", "shrink": 0 },
        "props": {
          "deferUpdates": false,
          "placeholder": "qty",
          "style": {
            "classes": "pf-field-input",
            "fontSize": "16px",
            "fontWeight": 700,
            "minHeight": "44px",
            "textAlign": "center"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": { "type": "property", "config": { "path": "view.params.quantity" } }
          }
        },
        "events": {
          "dom": {
            "onBlur": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"trimScrapChanged\", payload={\"defectCodeId\": self.view.params.defectCodeId, \"quantity\": self.props.text}, scope=\"page\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": { "name": "PlusButton", "tooltip": { "text": "One more" } },
        "position": { "basis": "44px", "shrink": 0 },
        "props": {
          "text": "+",
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "fontSize": "20px",
            "fontWeight": 700,
            "minHeight": "44px",
            "padding": "0"
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"trimScrapChanged\", payload={\"defectCodeId\": self.view.params.defectCodeId, \"delta\": 1}, scope=\"page\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": { "name": "RemoveButton", "tooltip": { "text": "Remove this reason" } },
        "position": { "basis": "44px", "shrink": 0 },
        "props": {
          "text": "",
          "image": { "icon": { "path": "mpp/cancel", "color": "var(--mpp-state-bad-fg)" } },
          "style": { "classes": "pf-btn pf-btn-secondary", "minHeight": "44px", "padding": "0" }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"trimScrapChanged\", payload={\"defectCodeId\": self.view.params.defectCodeId, \"quantity\": 0}, scope=\"page\")"
              }
            }
          }
        }
      }
    ]
  }
}
