{
  "custom": {},
  "params": {
    "terminalLocationId": null,
    "pressToken": 0
  },
  "propConfig": {
    "params.terminalLocationId": {
      "paramDirection": "input"
    },
    "params.pressToken": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 420,
      "width": 900
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "pf-panel",
        "gap": "8px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Kicker"
            },
            "props": {
              "text": "PRESS LOG",
              "style": {
                "classes": "pf-kpi-label"
              }
            },
            "position": {
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Hint"
            },
            "props": {
              "text": "Every press, newest first",
              "style": {
                "classes": "pf-kpi-sub"
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "Rows"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "path": "BlueRidge/Components/PlantFloor/ScaleStationPressRow",
          "elementPosition": {
            "basis": "36px",
            "grow": 0,
            "shrink": 0
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"BlueRidge.Workorder.ScaleStation.pressLogInstances\", 0, {view.params.terminalLocationId}, 10, {view.params.pressToken})"
              }
            }
          }
        }
      }
    ]
  }
}
