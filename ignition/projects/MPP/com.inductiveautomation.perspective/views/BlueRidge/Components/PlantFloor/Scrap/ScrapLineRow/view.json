{
  "custom": {},
  "params": {
    "code": "",
    "defectCodeId": null,
    "description": "",
    "messageName": "trimScrapChanged",
    "quantity": 0,
    "useNumpad": false
  },
  "propConfig": {
    "params.code": {
      "paramDirection": "input"
    },
    "params.defectCodeId": {
      "paramDirection": "input"
    },
    "params.description": {
      "paramDirection": "input"
    },
    "params.messageName": {
      "paramDirection": "input"
    },
    "params.quantity": {
      "paramDirection": "input"
    },
    "params.useNumpad": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 480
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "CodeLabel"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.code"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "pf-field-help",
                "overflow": "hidden"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "DescLabel"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.description"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "13px",
                "fontWeight": 600,
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Info"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "style": {
            "gap": "8px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(self.view.params.messageName or \"trimScrapChanged\", payload\u003d{\"defectCodeId\": self.view.params.defectCodeId, \"delta\": -1}, scope\u003d\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "MinusButton",
          "tooltip": {
            "text": "One less"
          }
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "fontSize": "20px",
            "fontWeight": 700,
            "maxHeight": "32px",
            "minHeight": "28px",
            "padding": "0"
          },
          "text": "-"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "dom": {
            "onBlur": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(self.view.params.messageName or \"trimScrapChanged\", payload\u003d{\"defectCodeId\": self.view.params.defectCodeId, \"quantity\": self.props.text}, scope\u003d\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "QtyInput",
          "tooltip": {
            "text": "Type a quantity"
          }
        },
        "position": {
          "basis": "68px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!{view.params.useNumpad}"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.quantity"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "deferUpdates": false,
          "placeholder": "qty",
          "style": {
            "classes": "pf-field-input",
            "fontSize": "16px",
            "fontWeight": 700,
            "maxHeight": "32px",
            "minHeight": "28px",
            "textAlign": "center"
          }
        },
        "type": "ia.input.text-field"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(self.view.params.messageName or \"trimScrapChanged\", payload\u003d{\"defectCodeId\": self.view.params.defectCodeId, \"edit\": True}, scope\u003d\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "QtyButton",
          "tooltip": {
            "text": "Tap to key in a quantity"
          }
        },
        "position": {
          "basis": "68px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.useNumpad}"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "toStr({view.params.quantity})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "fontSize": "16px",
            "fontWeight": 700,
            "maxHeight": "32px",
            "minHeight": "28px",
            "padding": "0"
          }
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(self.view.params.messageName or \"trimScrapChanged\", payload\u003d{\"defectCodeId\": self.view.params.defectCodeId, \"delta\": 1}, scope\u003d\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "PlusButton",
          "tooltip": {
            "text": "One more"
          }
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "fontSize": "20px",
            "fontWeight": 700,
            "maxHeight": "32px",
            "minHeight": "28px",
            "padding": "0"
          },
          "text": "+"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(self.view.params.messageName or \"trimScrapChanged\", payload\u003d{\"defectCodeId\": self.view.params.defectCodeId, \"quantity\": 0}, scope\u003d\"page\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "RemoveButton",
          "tooltip": {
            "text": "Remove this reason"
          }
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "image": {
            "icon": {
              "color": "var(--mpp-state-bad-fg)",
              "path": "mpp/cancel"
            }
          },
          "style": {
            "classes": "pf-btn pf-btn-secondary",
            "maxHeight": "32px",
            "minHeight": "28px",
            "padding": "0"
          },
          "text": ""
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "background": "var(--mpp-surface-card)",
        "border": "1px solid var(--mpp-border-subtle)",
        "borderRadius": "var(--mpp-radius-md)",
        "gap": "6px",
        "overflow": "hidden",
        "padding": "4px 6px"
      }
    },
    "type": "ia.container.flex"
  }
}