{
  "custom": {},
  "params": {
    "trayId": null,
    "position": 0,
    "lot": "",
    "pieces": 0,
    "tagged": false,
    "movedFrom": "",
    "selected": false
  },
  "propConfig": {
    "params.trayId": {
      "paramDirection": "input"
    },
    "params.position": {
      "paramDirection": "input"
    },
    "params.lot": {
      "paramDirection": "input"
    },
    "params.pieces": {
      "paramDirection": "input"
    },
    "params.tagged": {
      "paramDirection": "input"
    },
    "params.movedFrom": {
      "paramDirection": "input"
    },
    "params.selected": {
      "paramDirection": "input"
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if({view.params.selected}, 'var(--mpp-surface-selected)', 'var(--mpp-surface-raised)')"
          }
        }
      }
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "crt-row",
        "gap": "12px",
        "overflow": "hidden",
        "cursor": "pointer"
      }
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tsystem.perspective.sendMessage(\"reworkTraySelect\", payload={\"trayId\": self.view.params.trayId}, scope=\"page\")"
          }
        }
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Pos"
        },
        "position": {
          "basis": "70px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "'Tray ' + toStr({view.params.position})"
              }
            }
          }
        },
        "props": {
          "style": {
            "classes": "crt-meta"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Lot"
        },
        "position": {
          "basis": "170px",
          "shrink": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.lot"
              }
            }
          }
        },
        "props": {
          "style": {
            "classes": "crt-part crt-mono"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Pieces"
        },
        "position": {
          "basis": "70px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "toStr({view.params.pieces})"
              }
            }
          }
        },
        "props": {
          "style": {
            "fontVariantNumeric": "tabular-nums",
            "textAlign": "right",
            "fontWeight": "700"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "position": {
          "basis": "80px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.tagged}, 'CRT', 'CLEAR')"
              }
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.tagged}, 'pf-pill pf-pill-warn', 'pf-pill pf-pill-good')"
              }
            }
          }
        },
        "props": {
          "style": {
            "classes": "pf-pill"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "From"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.movedFrom}) > 0, 'topped up from ' + {view.params.movedFrom}, '')"
              }
            }
          }
        },
        "props": {
          "style": {
            "classes": "crt-meta",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          }
        }
      }
    ]
  },
  "props": {
    "defaultSize": {
      "height": 46,
      "width": 640
    }
  }
}
