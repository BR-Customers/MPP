    "params.runId": {
      "paramDirection": "input"
    },
    "params.memberId": {
      "paramDirection": "input"
    },
    "params.name": {
      "paramDirection": "input"
    },
    "params.isContainer": {
      "paramDirection": "input"
    },
    "params.pieces": {
      "paramDirection": "input"
    },
    "params.leftOver": {
      "paramDirection": "input",
      "onChange": {
        "enabled": true,
        "script": "\tself.getChild(\"root\").refresh()"
      }
    },
    "params.rankLocationId": {
      "paramDirection": "input"
    },
    "params.runOpen": {
      "paramDirection": "input"
    },
    "params.token": {
      "paramDirection": "input",
      "onChange": {
        "enabled": true,
        "script": "\tself.getChild(\"root\").refresh()"
      }
    },
    "params.canReturn": {
      "paramDirection": "input",
      "onChange": {
        "enabled": true,
        "script": "\tself.getChild(\"root\").refresh()"
      }
    },
    "params.origin": {
      "paramDirection": "input"
    }
