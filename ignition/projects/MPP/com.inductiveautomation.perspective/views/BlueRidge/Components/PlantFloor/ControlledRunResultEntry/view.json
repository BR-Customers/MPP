    "pane": "tiles",
    "numpad": {
      "key": "",
      "label": "",
      "value": ""
    },
    "model": {
      "outcomeTiles": [],
      "reasonTiles": [],
      "lines": [],
      "total": 0,
      "moreCount": 0,
      "scrap": 0,
      "summary": "",
      "canSave": false
    },
    "busyUntil": 0
  },
  "params": {
    "runId": null,
    "memberId": null,
    "name": "",
    "isContainer": false,
    "pieces": 0,
    "leftOver": 0,
    "rankLocationId": null,
    "runOpen": false,
    "token": 0,
    "canReturn": false,
    "origin": ""
  },
