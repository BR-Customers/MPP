    "scripts": {
      "customMethods": [
        {
          "name": "init",
          "params": [],
          "script": "\tself.view.custom.catalog = BlueRidge.Quality.ControlledRun.entryCatalog(self.view.params.rankLocationId)\n\tself.refresh()"
        },
        {
          "name": "refresh",
          "params": [],
          "script": "\t# ONE pass rebuilds every derived prop from the two sources of truth: the ranked\n\t# reason catalog and the draft. Assigned whole, so no binding sees half of it.\n\tv = self.view\n\tv.custom.model = BlueRidge.Quality.ControlledRun.entryModel(v.params.memberId, v.custom.catalog, v.custom.draftJson, v.custom.showAll, v.params.leftOver, v.params.isContainer, v.params.canReturn)"
        },
        {
          "name": "change",
          "params": [
            "payload"
          ],
          "script": "\t# Every tile and line on the page sends crEntryChanged; each open member's form\n\t# hears all of them and acts only on its own.\n\tp = payload or {}\n\tv = self.view\n\tif p.get(\"memberId\") != v.params.memberId:\n\t\treturn\n\tif p.get(\"edit\"):\n\t\tself.openNumpad(p.get(\"key\"))\n\t\treturn\n\tv.custom.draftJson = BlueRidge.Quality.ControlledRun.entryChange(v.custom.draftJson, p.get(\"key\"), p.get(\"delta\"), p.get(\"quantity\"))\n\tself.refresh()"
        },
        {
          "name": "openNumpad",
          "params": [
            "key"
          ],
          "script": "\tv = self.view\n\tv.custom.numpad = {\"key\": key, \"label\": BlueRidge.Quality.ControlledRun.entryLineLabel(v.custom.draftJson, key, v.custom.catalog), \"value\": \"\"}\n\tv.custom.pane = \"numpad\"\n\t# only one number pad on the page at a time: the others close theirs\n\tsystem.perspective.sendMessage(\"crEntryNumpadOwner\", payload={\"memberId\": v.params.memberId}, scope=\"page\")"
        },
        {
          "name": "numpadKey",
          "params": [
            "payload"
          ],
          "script": "\tv = self.view\n\tif v.custom.pane != \"numpad\":\n\t\treturn\n\ta = payload.get(\"action\") if payload else None\n\tt = v.custom.numpad.value or \"\"\n\tif a == \"key\" and len(t) < 5:\n\t\tt = t + (\"%s\" % payload.get(\"key\"))\n\telif a == \"backspace\":\n\t\tt = t[:-1]\n\telif a == \"clear\":\n\t\tt = \"\"\n\tv.custom.numpad.value = t"
        },
        {
          "name": "numpadOk",
          "params": [],
          "script": "\tv = self.view\n\tkey = v.custom.numpad.key\n\tt = v.custom.numpad.value or \"\"\n\tv.custom.pane = \"tiles\"\n\tif t != \"\":\n\t\t# 0 removes the line; nothing keyed leaves it as it was\n\t\tv.custom.draftJson = BlueRidge.Quality.ControlledRun.entryChange(v.custom.draftJson, key, None, t)\n\t\tself.refresh()"
        },
        {
          "name": "acceptRest",
          "params": [],
          "script": "\tv = self.view\n\tv.custom.draftJson = BlueRidge.Quality.ControlledRun.entryAcceptRest(v.custom.draftJson, v.params.leftOver)\n\tself.refresh()"
        },
        {
          "name": "clearDraft",
          "params": [],
          "script": "\tv = self.view\n\tv.custom.draftJson = \"\"\n\tv.custom.remarks = \"\"\n\tv.custom.pane = \"tiles\"\n\tself.refresh()"
        },
        {
          "name": "save",
