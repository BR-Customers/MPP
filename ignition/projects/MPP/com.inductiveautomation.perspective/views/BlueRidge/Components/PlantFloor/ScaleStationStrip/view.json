{
  "custom": {},
  "params": {
    "terminalLocationId": null
  },
  "propConfig": {
    "params.terminalLocationId": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 1200
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "style": {
        "flexDirection": "row",
        "classes": "pf-panel",
        "gap": "16px"
      },
      "alignItems": "center"
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Status"
        },
        "props": {
          "style": {
            "classes": "pf-kpi-sub"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"BlueRidge.Workorder.ScaleStation.scaleStatusText\", 15000, {view.params.terminalLocationId})"
              }
            }
          }
        },
        "position": {
          "grow": 1
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Instruction"
        },
        "props": {
          "text": "Tare the container, load the tray, then press the button on the scale."
        }
      }
    ]
  }
}
