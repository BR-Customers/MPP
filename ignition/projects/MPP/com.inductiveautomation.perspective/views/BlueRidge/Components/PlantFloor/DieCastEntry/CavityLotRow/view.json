      "onChange": {
        "enabled": true,
        "script": "\tval \u003d self.view.params.proposedGood\n\tself.view.custom.good \u003d str(val) if val is not None else \"\"\n\tself.view.custom.scrap1Defect \u003d None\n\tself.view.custom.scrap2Defect \u003d None\n\tself.view.custom.scrap3Defect \u003d None\n\tself.view.custom.scrap4Defect \u003d None\n\tself.view.custom.scrap5Defect \u003d None\n\tself.view.custom.scrap6Defect \u003d None\n\tself.view.custom.scrap1Qty \u003d \"\"\n\tself.view.custom.scrap2Qty \u003d \"\"\n\tself.view.custom.scrap3Qty \u003d \"\"\n\tself.view.custom.scrap4Qty \u003d \"\"\n\tself.view.custom.scrap5Qty \u003d \"\"\n\tself.view.custom.scrap6Qty \u003d \"\"\n\tself.view.custom.scrapApplied \u003d 0\n\tself.view.custom.overHeadroom \u003d False"
      },
      "paramDirection": "input"
    },
    "params.toolCavityId": {
      "paramDirection": "input"
    }
  },
