        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "EditableBlock"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.isOpen"
              }
            }
          }
        },
        "props": {
          "alignItems": "stretch",
          "style": {
            "gap": "8px",
            "overflow": "visible"
          },
          "direction": "column"
        },
        "children": [
          {
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "GoodBlock"
                },
                "position": {
                  "basis": "120px",
                  "shrink": 0
                },
                "props": {
                  "direction": "column",
                  "style": {
                    "gap": "2px",
                    "overflow": "hidden"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "GoodLabel"
                    },
                    "props": {
                      "text": "Good (pc)",
                      "style": {
                        "classes": "pf-field-label"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "GoodValue"
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "property",
                          "config": {
                            "path": "view.custom.good"
                          }
                        }
                      }
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "classes": "pf-kpi-value",
                        "fontFamily": "var(--mpp-font-mono)",
                        "fontSize": "22px",
                        "fontWeight": 700
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ReferenceLabel"
                },
                "position": {
                  "basis": "150px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "\"prior \" + toStr({view.params.priorGoodThisShift}) + if({view.params.maxHeadroom} \u003c 2147483647, \"  ·  headroom \" + toStr({view.params.maxHeadroom}), \"\")"
                      }
                    }
                  }
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "pf-kpi-sub"
                  }
                }
              },
              {
                "meta": {
                  "name": "ControlsSpacer"
                },
                "position": {
                  "grow": 1,
                  "shrink": 1
                },
                "props": {
                  "text": ""
                },
                "type": "ia.display.label"
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ScrapTotalLabel"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.custom.scrapTotal} \u003e 0"
                      }
                    }
                  },
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "\"scrap \" + toStr({view.custom.scrapTotal}) + \" pc\""
                      }
                    }
                  }
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "pf-kpi-sub",
                    "whiteSpace": "nowrap"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "HeadroomWarning"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.overHeadroom"
                      }
                    }
                  }
                },
                "props": {
                  "text": "Over basket headroom",
                  "style": {
                    "color": "var(--mpp-warning, #b26a00)",
                    "fontWeight": 600,
                    "whiteSpace": "nowrap"
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "AddScrapButton"
                },
                "position": {
                  "basis": "180px",
                  "shrink": 0
                },
                "props": {
                  "text": "Add scrap reason",
                  "image": {
                    "icon": {
                      "path": "mpp/add_circle"
                    }
                  },
                  "style": {
                    "classes": "pf-btn pf-btn-secondary",
                    "minHeight": "44px"
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tself.view.rootContainer.addScrapLine()"
                      }
                    }
                  }
                }
              }
            ],
            "meta": {
              "name": "ControlsLine"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "style": {
                "gap": "10px",
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ScrapStack"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "6px",
                "overflow": "visible"
              },
              "wrap": "nowrap",
              "alignItems": "stretch"
            },
            "children": [
              {
                "type": "ia.display.flex-repeater",
                "meta": {
                  "name": "ScrapRepeater"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.scrapLines"
                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(value) or []\n\topts \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.params.defectOptions) or []\n\tlotId \u003d self.view.params.lotId\n\tout \u003d []\n\tfor i, r in enumerate(rows):\n\t\tr \u003d r or {}\n\t\tout.append({\"lotId\": lotId, \"index\": i, \"defectCodeId\": r.get(\"defectCodeId\"), \"quantity\": r.get(\"quantity\") or \"\", \"defectOptions\": opts})\n\treturn out"
                        }
                      ]
                    }
                  }
                },
                "props": {
                  "direction": "column",
                  "wrap": "nowrap",
                  "elementPosition": {
                    "basis": "auto",
                    "shrink": 0
                  },
                  "path": "BlueRidge/Components/PlantFloor/DieCastEntry/ScrapLineRow",
                  "style": {
                    "flexWrap": "nowrap",
                    "gap": "6px",
                    "overflow": "visible"
                  },
                  "useDefaultViewHeight": true,
                  "useDefaultViewWidth": false
                }
              }
            ]
          }
        ]
      }
    ],
    "scripts": {
      "customMethods": [
        {
          "name": "addScrapLine",
          "params": [],
          "script": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows \u003d [dict(r or {}) for r in rows]\n\trows.append({\"defectCodeId\": None, \"quantity\": \"\"})\n\tself.view.custom.scrapLines \u003d rows"
        },
        {
          "name": "setScrapLine",
          "params": [
            "index",
            "defectCodeId",
            "quantity"
          ],
          "script": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows \u003d [dict(r or {}) for r in rows]\n\tif index is None or index \u003c 0 or index \u003e\u003d len(rows):\n\t\treturn\n\trows[index] \u003d {\"defectCodeId\": defectCodeId, \"quantity\": quantity or \"\"}\n\tself.view.custom.scrapLines \u003d rows\n\tself.applyScrap()"
        },
        {
          "name": "removeScrapLine",
          "params": [
            "index"
          ],
          "script": "\trows \u003d BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows \u003d [dict(r or {}) for r in rows]\n\tif index is None or index \u003c 0 or index \u003e\u003d len(rows):\n\t\treturn\n\tdel rows[index]\n\tself.view.custom.scrapLines \u003d rows\n\tself.applyScrap()"
        },
        {
          "name": "applyScrap",
          "params": [],
          "script": "\t# FAT #23: scrap auto-decrements Good. Good is DISPLAY-ONLY now (backlog 2.5),\n\t# so it is a pure derivation -- Good \u003d ProposedGood - (submittable scrap),\n\t# floored at 0 -- rather than the old subtract-the-delta bookkeeping that\n\t# existed only to preserve operator hand-edits to an editable Good field.\n\t# Recomputing from the proposal means clearing or shrinking a scrap line puts\n\t# the pieces straight back, with no scrapApplied running total to drift.\n\ttotal \u003d 0\n\tfor r in (BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []):\n\t\tr \u003d r or {}\n\t\tif r.get(\"defectCodeId\") is None:\n\t\t\tcontinue\n\t\tq \u003d BlueRidge.Common.Util.toIntOrNone(r.get(\"quantity\"))\n\t\tif q:\n\t\t\ttotal +\u003d q\n\tbase \u003d BlueRidge.Common.Util.toIntOrNone(self.view.params.proposedGood) or 0\n\tg \u003d base - total\n\tif g \u003c 0:\n\t\tg \u003d 0\n\tmaxH \u003d BlueRidge.Common.Util.toIntOrNone(self.view.params.maxHeadroom)\n\tself.view.custom.scrapTotal \u003d total\n\tself.view.custom.good \u003d str(g)\n\tself.view.custom.overHeadroom \u003d (maxH is not None and g \u003e maxH)\n\tself.emitRowChanged()"
        },
        {
          "name": "emitRowChanged",
          "params": [],
          "script": "\t# Wire shape is UNCHANGED from the fixed-six-slot version DieCastBody\u0027s\n\t# dieCastRowChanged handler + Workorder.DieCastShiftOutput_Record expect:\n\t# {lotId, good, scrapLines: [{defectCodeId, quantity}, ...]}. Only the number\n\t# of scrap lines is now unbounded (backlog 2.3).\n\tlines \u003d []\n\tfor r in (BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []):\n\t\tr \u003d r or {}\n\t\td \u003d r.get(\"defectCodeId\")\n\t\tq \u003d r.get(\"quantity\")\n\t\tif d is not None and q not in (None, \"\"):\n\t\t\tlines.append({\"defectCodeId\": d, \"quantity\": q})\n\tsystem.perspective.sendMessage(\"dieCastRowChanged\", payload\u003d{\n\t\t\"lotId\": self.view.params.lotId,\n\t\t\"good\": self.view.custom.good,\n\t\t\"scrapLines\": lines,\n\t}, scope\u003d\"page\")"
        },
        {
          "name": "_isMine",
          "params": [
            "payload"
          ],
          "script": "\t# The ScrapLineRow children broadcast on PAGE scope, so every CavityLotRow on\n\t# the shift-output list receives every child\u0027s message. Route by lotId.\n\tif not payload:\n\t\treturn False\n\treturn (\"%s\" % payload.get(\"lotId\")) \u003d\u003d (\"%s\" % self.view.params.lotId)"
        }
      ],
      "messageHandlers": [
        {
          "messageType": "dieCastScrapLineChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif self._isMine(payload):\n\t\tself.setScrapLine(payload.get(\"index\"), payload.get(\"defectCodeId\"), payload.get(\"quantity\"))"
        },
        {
          "messageType": "dieCastScrapLineRemoved",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif self._isMine(payload):\n\t\tself.removeScrapLine(payload.get(\"index\"))"
        }
      ]
    }
  }
}