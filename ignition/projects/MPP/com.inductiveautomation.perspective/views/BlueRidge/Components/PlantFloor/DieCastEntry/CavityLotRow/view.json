    "scrap1Qty": "",
    "scrap2Defect": null,
    "scrap2Qty": "",
    "scrap3Defect": null,
    "scrap3Qty": "",
    "scrap4Defect": null,
    "scrap4Qty": "",
    "scrap5Defect": null,
    "scrap5Qty": "",
    "scrap6Defect": null,
    "scrap6Qty": ""
  },
  "params": {
    "toolCavityId": null,
    "cavityNumber": "",
    "lotId": null,
    "lotName": "",
    "isOpen": true,
    "priorGoodThisShift": 0,
    "proposedGood": 0,
    "maxHeadroom": 2147483647
  },
  "propConfig": {
    "params.toolCavityId": {
      "paramDirection": "input"
    },
    "params.cavityNumber": {
      "paramDirection": "input"
    },
    "params.lotId": {
      "paramDirection": "input"
    },
    "params.lotName": {
      "paramDirection": "input"
    },
    "params.isOpen": {
      "paramDirection": "input"
    },
    "params.priorGoodThisShift": {
      "paramDirection": "input"
    },
    "params.maxHeadroom": {
      "paramDirection": "input"
    },
    "params.proposedGood": {
      "paramDirection": "input",
      "onChange": {
        "enabled": true,
        "script": "\tval = self.view.params.proposedGood\n\tself.view.custom.good = str(val) if val is not None else \"\"\n\tself.view.custom.scrap1Defect = None\n\tself.view.custom.scrap2Defect = None\n\tself.view.custom.scrap3Defect = None\n\tself.view.custom.scrap4Defect = None\n\tself.view.custom.scrap5Defect = None\n\tself.view.custom.scrap6Defect = None\n\tself.view.custom.scrap1Qty = \"\"\n\tself.view.custom.scrap2Qty = \"\"\n\tself.view.custom.scrap3Qty = \"\"\n\tself.view.custom.scrap4Qty = \"\"\n\tself.view.custom.scrap5Qty = \"\"\n\tself.view.custom.scrap6Qty = \"\"\n\tself.view.custom.scrapApplied = 0\n\tself.view.custom.overHeadroom = False"
      }
    },
    "custom.defectOptions": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"BlueRidge.Quality.DefectCode.getForDropdown\", 0, \"DieCast\")"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 900
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "pf-inventory-row",
        "gap": "12px",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "CavityLotBlock"
        },
        "position": {
          "basis": "110px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "2px",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "CavityLabel"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"Cavity \" + toStr({view.params.cavityNumber})"
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "fontWeight": 600
              }
            }
          },
          {
            "type": "ia.display.label",
