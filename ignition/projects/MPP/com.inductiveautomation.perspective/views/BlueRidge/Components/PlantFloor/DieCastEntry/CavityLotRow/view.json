{
  "custom": {
    "good": "",
    "overHeadroom": false,
    "scrapLines": [],
    "scrapTotal": 0
  },
  "params": {
    "toolCavityId": null,
    "cavityNumber": "",
    "cavityName": "",
    "cavityOrdinalLabel": "",
    "hasCavityName": false,
    "lotId": null,
    "lotName": "",
    "isOpen": true,
    "priorGoodThisShift": 0,
    "proposedGood": 0,
    "maxHeadroom": 2147483647,
    "defectOptions": []
  },
  "propConfig": {
    "params.toolCavityId": { "paramDirection": "input" },
    "params.cavityNumber": { "paramDirection": "input" },
    "params.cavityName": { "paramDirection": "input" },
    "params.cavityOrdinalLabel": { "paramDirection": "input" },
    "params.hasCavityName": { "paramDirection": "input" },
    "params.lotId": { "paramDirection": "input" },
    "params.lotName": { "paramDirection": "input" },
    "params.isOpen": { "paramDirection": "input" },
    "params.priorGoodThisShift": { "paramDirection": "input" },
    "params.maxHeadroom": { "paramDirection": "input" },
    "params.defectOptions": { "paramDirection": "input" },
    "params.proposedGood": {
      "paramDirection": "input",
      "onChange": {
        "enabled": true,
        "script": "\t# A fresh proposal replaces the row wholesale: the operator's scrap lines and\n\t# the derived Good both belong to the PREVIOUS proposal and must not survive.\n\tval = self.view.params.proposedGood\n\tself.view.custom.scrapLines = []\n\tself.view.custom.scrapTotal = 0\n\tself.view.custom.good = str(val) if val is not None else \"\"\n\tself.view.custom.overHeadroom = False"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 76,
      "width": 900
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "pf-inventory-row",
        "gap": "12px",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "CavityLotBlock"
        },
        "position": {
          "basis": "150px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "2px",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "CavityLabel"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.cavityName"
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "fontWeight": 600,
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "LotLabel"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.lotName"
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "classes": "pf-kpi-sub",
                "fontFamily": "var(--mpp-font-mono)"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "CavityOrdinal"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.hasCavityName"
                  }
                }
              },
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.cavityOrdinalLabel"
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "classes": "pf-kpi-sub"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "EditableBlock"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.isOpen"
              }
            }
          }
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "10px",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "GoodBlock"
            },
            "position": {
              "basis": "120px",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "2px",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "GoodLabel"
                },
                "props": {
                  "text": "Good (pc)",
                  "style": {
                    "classes": "pf-field-label"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "GoodValue"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.good"
                      }
                    }
                  }
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "pf-kpi-value",
                    "fontFamily": "var(--mpp-font-mono)",
                    "fontSize": "22px",
                    "fontWeight": 700
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ReferenceLabel"
            },
            "position": {
              "basis": "150px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"prior \" + toStr({view.params.priorGoodThisShift}) + if({view.params.maxHeadroom} < 2147483647, \"  ·  headroom \" + toStr({view.params.maxHeadroom}), \"\")"
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "classes": "pf-kpi-sub"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ScrapStack"
            },
            "position": {
              "basis": "0",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "direction": "row",
              "style": {
                "gap": "8px",
                "overflow": "hidden"
              },
              "wrap": "wrap"
            },
            "children": [
              {
                "type": "ia.display.flex-repeater",
                "meta": {
                  "name": "ScrapRepeater"
                },
                "position": {
                  "basis": "0",
                  "grow": 1,
                  "shrink": 1
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.scrapLines"
                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\trows = BlueRidge.Common.Util.extractQualifiedValues(value) or []\n\topts = BlueRidge.Common.Util.extractQualifiedValues(self.view.params.defectOptions) or []\n\tlotId = self.view.params.lotId\n\tout = []\n\tfor i, r in enumerate(rows):\n\t\tr = r or {}\n\t\tout.append({\"lotId\": lotId, \"index\": i, \"defectCodeId\": r.get(\"defectCodeId\"), \"quantity\": r.get(\"quantity\") or \"\", \"defectOptions\": opts})\n\treturn out"
                        }
                      ]
                    }
                  }
                },
                "props": {
                  "direction": "row",
                  "wrap": "wrap",
                  "elementPosition": {
                    "basis": "300px",
                    "grow": 1,
                    "shrink": 1
                  },
                  "path": "BlueRidge/Components/PlantFloor/DieCastEntry/ScrapLineRow",
                  "style": {
                    "flexWrap": "wrap",
                    "gap": "8px",
                    "overflow": "hidden"
                  },
                  "useDefaultViewHeight": true,
                  "useDefaultViewWidth": false
                }
              }
            ]
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "AddScrapButton"
            },
            "position": {
              "basis": "180px",
              "shrink": 0
            },
            "props": {
              "text": "Add scrap reason",
              "image": {
                "icon": {
                  "path": "mpp/add_circle"
                }
              },
              "style": {
                "classes": "pf-btn pf-btn-secondary",
                "minHeight": "44px"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tself.view.rootContainer.addScrapLine()"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ScrapTotalLabel"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.scrapTotal} > 0"
                  }
                }
              },
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"scrap \" + toStr({view.custom.scrapTotal}) + \" pc\""
                  }
                }
              }
            },
            "props": {
              "text": "",
              "style": {
                "classes": "pf-kpi-sub",
                "whiteSpace": "nowrap"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HeadroomWarning"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.overHeadroom"
                  }
                }
              }
            },
            "props": {
              "text": "Over basket headroom",
              "style": {
                "color": "var(--mpp-warning, #b26a00)",
                "fontWeight": 600,
                "whiteSpace": "nowrap"
              }
            }
          }
        ]
      }
    ],
    "scripts": {
      "customMethods": [
        {
          "name": "addScrapLine",
          "params": [],
          "script": "\trows = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows = [dict(r or {}) for r in rows]\n\trows.append({\"defectCodeId\": None, \"quantity\": \"\"})\n\tself.view.custom.scrapLines = rows"
        },
        {
          "name": "setScrapLine",
          "params": [
            "index",
            "defectCodeId",
            "quantity"
          ],
          "script": "\trows = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows = [dict(r or {}) for r in rows]\n\tif index is None or index < 0 or index >= len(rows):\n\t\treturn\n\trows[index] = {\"defectCodeId\": defectCodeId, \"quantity\": quantity or \"\"}\n\tself.view.custom.scrapLines = rows\n\tself.applyScrap()"
        },
        {
          "name": "removeScrapLine",
          "params": [
            "index"
          ],
          "script": "\trows = BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []\n\trows = [dict(r or {}) for r in rows]\n\tif index is None or index < 0 or index >= len(rows):\n\t\treturn\n\tdel rows[index]\n\tself.view.custom.scrapLines = rows\n\tself.applyScrap()"
        },
        {
          "name": "applyScrap",
          "params": [],
          "script": "\t# FAT #23: scrap auto-decrements Good. Good is DISPLAY-ONLY now (backlog 2.5),\n\t# so it is a pure derivation -- Good = ProposedGood - (submittable scrap),\n\t# floored at 0 -- rather than the old subtract-the-delta bookkeeping that\n\t# existed only to preserve operator hand-edits to an editable Good field.\n\t# Recomputing from the proposal means clearing or shrinking a scrap line puts\n\t# the pieces straight back, with no scrapApplied running total to drift.\n\ttotal = 0\n\tfor r in (BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []):\n\t\tr = r or {}\n\t\tif r.get(\"defectCodeId\") is None:\n\t\t\tcontinue\n\t\tq = BlueRidge.Common.Util.toIntOrNone(r.get(\"quantity\"))\n\t\tif q:\n\t\t\ttotal += q\n\tbase = BlueRidge.Common.Util.toIntOrNone(self.view.params.proposedGood) or 0\n\tg = base - total\n\tif g < 0:\n\t\tg = 0\n\tmaxH = BlueRidge.Common.Util.toIntOrNone(self.view.params.maxHeadroom)\n\tself.view.custom.scrapTotal = total\n\tself.view.custom.good = str(g)\n\tself.view.custom.overHeadroom = (maxH is not None and g > maxH)\n\tself.emitRowChanged()"
        },
        {
          "name": "emitRowChanged",
          "params": [],
          "script": "\t# Wire shape is UNCHANGED from the fixed-six-slot version DieCastBody's\n\t# dieCastRowChanged handler + Workorder.DieCastShiftOutput_Record expect:\n\t# {lotId, good, scrapLines: [{defectCodeId, quantity}, ...]}. Only the number\n\t# of scrap lines is now unbounded (backlog 2.3).\n\tlines = []\n\tfor r in (BlueRidge.Common.Util.extractQualifiedValues(self.view.custom.scrapLines) or []):\n\t\tr = r or {}\n\t\td = r.get(\"defectCodeId\")\n\t\tq = r.get(\"quantity\")\n\t\tif d is not None and q not in (None, \"\"):\n\t\t\tlines.append({\"defectCodeId\": d, \"quantity\": q})\n\tsystem.perspective.sendMessage(\"dieCastRowChanged\", payload={\n\t\t\"lotId\": self.view.params.lotId,\n\t\t\"good\": self.view.custom.good,\n\t\t\"scrapLines\": lines,\n\t}, scope=\"page\")"
        },
        {
          "name": "_isMine",
          "params": [
            "payload"
          ],
          "script": "\t# The ScrapLineRow children broadcast on PAGE scope, so every CavityLotRow on\n\t# the shift-output list receives every child's message. Route by lotId.\n\tif not payload:\n\t\treturn False\n\treturn (\"%s\" % payload.get(\"lotId\")) == (\"%s\" % self.view.params.lotId)"
        }
      ],
      "messageHandlers": [
        {
          "messageType": "dieCastScrapLineChanged",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif self._isMine(payload):\n\t\tself.setScrapLine(payload.get(\"index\"), payload.get(\"defectCodeId\"), payload.get(\"quantity\"))"
        },
        {
          "messageType": "dieCastScrapLineRemoved",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\tif self._isMine(payload):\n\t\tself.removeScrapLine(payload.get(\"index\"))"
        }
      ]
    }
  }
}
