    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "pf-inventory-row",
        "gap": "12px",
        "overflow": "hidden"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "applyGood",
          "params": [],
          "script": "\tgoodTxt \u003d self.view.custom.good\n\ttry:\n\t\tg \u003d int(goodTxt) if goodTxt not in (None, \"\") else 0\n\texcept (ValueError, TypeError):\n\t\tg \u003d 0\n\tmaxH \u003d self.view.params.maxHeadroom\n\tself.view.custom.overHeadroom \u003d (maxH is not None and g \u003e maxH)\n\tself.emitRowChanged()"
        },
        {
          "name": "emitRowChanged",
          "params": [],
          "script": "\tc \u003d self.view.custom\n\tlines \u003d []\n\tfor d, q in ((c.scrap1Defect, c.scrap1Qty), (c.scrap2Defect, c.scrap2Qty), (c.scrap3Defect, c.scrap3Qty), (c.scrap4Defect, c.scrap4Qty), (c.scrap5Defect, c.scrap5Qty), (c.scrap6Defect, c.scrap6Qty)):\n\t\tif d is not None and q not in (None, \u0027\u0027):\n\t\t\tlines.append({\u0027defectCodeId\u0027: d, \u0027quantity\u0027: q})\n\tsystem.perspective.sendMessage(\u0027dieCastRowChanged\u0027, payload\u003d{\n\t\t\u0027lotId\u0027: self.view.params.lotId,\n\t\t\u0027good\u0027: c.good,\n\t\t\u0027scrapLines\u0027: lines,\n\t}, scope\u003d\u0027page\u0027)"
        },
        {
          "name": "applyScrap",
          "params": [],
          "script": "\t# FAT #23: scrap auto-decrements Good. Sum the submittable scrap (reason +\n\t# qty both present, matching emitRowChanged\u0027s line filter), subtract only the\n\t# DELTA vs what was already applied from the CURRENT Good -- so operator hand-\n\t# edits to Good survive and reducing/clearing a scrap adds the pieces back.\n\tc \u003d self.view.custom\n\ttotal \u003d 0\n\tfor d, q in ((c.scrap1Defect, c.scrap1Qty), (c.scrap2Defect, c.scrap2Qty), (c.scrap3Defect, c.scrap3Qty), (c.scrap4Defect, c.scrap4Qty), (c.scrap5Defect, c.scrap5Qty), (c.scrap6Defect, c.scrap6Qty)):\n\t\tif d is not None:\n\t\t\tqi \u003d BlueRidge.Common.Util.toIntOrNone(q)\n\t\t\tif qi:\n\t\t\t\ttotal +\u003d qi\n\tapplied \u003d BlueRidge.Common.Util.toIntOrNone(c.scrapApplied) or 0\n\tg \u003d BlueRidge.Common.Util.toIntOrNone(c.good) or 0\n\tg \u003d g - (total - applied)\n\tif g \u003c 0:\n\t\tg \u003d 0\n\tself.view.custom.good \u003d str(g)\n\tself.view.custom.scrapApplied \u003d total\n\tself.applyGood()"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": null
    },
    "type": "ia.container.flex"
  }
}