                    "type": "ia.input.dropdown"
                  },
                  {
                    "meta": {
                      "name": "ScrapQty6"
                    },
                    "position": {
                      "basis": "80px"
                    },
                    "propConfig": {
                      "props.value": {
                        "binding": {
                          "config": {
                            "bidirectional": true,
                            "path": "view.custom.scrap6Qty"
                          },
                          "type": "property"
                        },
                        "onChange": {
                          "enabled": null,
                          "script": "\tif previousValue.value \u003d\u003d \u0027\u0027 and currentValue.value \u003d\u003d \u0027\u0027:\n\t\treturn\n\t\n\tif previousValue.value \u003d\u003d \u0027\u0027:\n\t\tdiff \u003d int(currentValue.value)\n\telif currentValue.value \u003d\u003d \u0027\u0027:\n\t\tdiff \u003d 0 - int(previousValue.value)\n\telse:\n\t\tdiff \u003d int(currentValue.value) - int(previousValue.value)\n\t\t\n\tif diff \u003e int(self.view.custom.good):\n\t\tself.view.custom.good \u003d 0\n\telse:\n\t\tself.view.custom.good \u003d int(self.view.custom.good) - diff"
                        }
                      }
                    },
