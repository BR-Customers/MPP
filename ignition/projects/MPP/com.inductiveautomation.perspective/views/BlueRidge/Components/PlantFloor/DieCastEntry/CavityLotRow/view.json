{
  "custom": {
    "good": "",
    "overHeadroom": false,
    "scrapLines": [],
    "scrapTotal": 0
  },
  "params": {
    "toolCavityId": null,
    "cavityNumber": "",
    "cavityName": "",
    "cavityOrdinalLabel": "",
    "hasCavityName": false,
    "lotId": null,
    "lotName": "",
    "isOpen": true,
    "priorGoodThisShift": 0,
    "proposedGood": 0,
    "maxHeadroom": 2147483647,
    "defectOptions": []
  },
  "propConfig": {
    "params.toolCavityId": {
      "paramDirection": "input"
    },
    "params.cavityNumber": {
      "paramDirection": "input"
    },
    "params.cavityName": {
      "paramDirection": "input"
    },
    "params.cavityOrdinalLabel": {
      "paramDirection": "input"
    },
    "params.hasCavityName": {
      "paramDirection": "input"
    },
    "params.lotId": {
      "paramDirection": "input"
    },
    "params.lotName": {
      "paramDirection": "input"
    },
    "params.isOpen": {
      "paramDirection": "input"
    },
    "params.priorGoodThisShift": {
      "paramDirection": "input"
    },
    "params.maxHeadroom": {
      "paramDirection": "input"
    },
    "params.defectOptions": {
      "paramDirection": "input"
    },
    "params.proposedGood": {
      "paramDirection": "input",
      "onChange": {
        "enabled": true,
        "script": "\t# A fresh proposal replaces the row wholesale: the operator\u0027s scrap lines and\n\t# the derived Good both belong to the PREVIOUS proposal and must not survive.\n\tval \u003d self.view.params.proposedGood\n\tself.view.custom.scrapLines \u003d []\n\tself.view.custom.scrapTotal \u003d 0\n\tself.view.custom.good \u003d str(val) if val is not None else \"\"\n\tself.view.custom.overHeadroom \u003d False"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 150,
      "width": 900
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
