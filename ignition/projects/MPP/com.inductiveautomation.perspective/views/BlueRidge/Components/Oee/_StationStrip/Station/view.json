{
  "custom": {},
  "params": {
    "name": "",
    "value": "--",
    "band": null,
    "downText": ""
  },
  "propConfig": {
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.band": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.downText": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 180,
      "height": 76
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "background": "var(--mpp-surface-raised)",
        "border": "1px solid var(--mpp-border-subtle)",
        "borderRadius": "6px",
        "padding": "6px 10px",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Name"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "13px",
            "color": "var(--mpp-text-secondary)",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.name"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Value"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "--",
          "style": {
            "fontSize": "20px",
            "fontWeight": "700"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.value"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.band}\u003d\u0027green\u0027,\u0027#50C878\u0027,if({view.params.band}\u003d\u0027amber\u0027,\u0027#F4B343\u0027,if({view.params.band}\u003d\u0027red\u0027,\u0027#DC5050\u0027,\u0027#697A98\u0027)))"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Down"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "13px",
            "color": "var(--mpp-text-tertiary)"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.downText"
              }
            }
          }
        }
      }
    ]
  }
}