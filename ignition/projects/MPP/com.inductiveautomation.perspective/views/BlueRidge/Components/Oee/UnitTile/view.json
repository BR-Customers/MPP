{
  "custom": {},
  "params": {
    "locationId": null,
    "name": "",
    "value": "--",
    "band": null,
    "dim": false,
    "noReason": false,
    "rowsJson": "[]",
    "rowCount": 0,
    "tileH": 100
  },
  "propConfig": {
    "params.locationId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.band": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dim": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.noReason": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.rowsJson": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.rowCount": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tileH": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 180,
      "height": 120
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "background": "var(--mpp-surface-raised)",
        "borderRadius": "6px",
        "padding": "8px 10px",
        "cursor": "pointer",
        "gap": "2px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "NameRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "6px"
          },
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Name"
            },
            "position": {
              "basis": "0",
              "grow": 1
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "14px",
                "fontWeight": "600",
                "whiteSpace": "nowrap",
                "overflow": "hidden",
                "textOverflow": "ellipsis"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.name"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "NoReasonTag"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "no reason",
              "style": {
                "fontSize": "11px",
                "color": "#F4B343"
              }
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.noReason"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Value"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "--",
          "style": {
            "fontSize": "24px",
            "fontWeight": "700",
            "lineHeight": "1.2"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.value"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.band}\u003d\u0027green\u0027,\u0027#50C878\u0027,if({view.params.band}\u003d\u0027amber\u0027,\u0027#F4B343\u0027,if({view.params.band}\u003d\u0027red\u0027,\u0027#DC5050\u0027,\u0027#697A98\u0027)))"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "Lines"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "path": "BlueRidge/Components/Oee/_UnitTile/Line",
          "instances": [],
          "direction": "column",
          "alignItems": "stretch",
          "justify": "flex-start",
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false,
          "elementPosition": {
            "basis": "20px",
            "shrink": 0,
            "grow": 0
          },
          "style": {}
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"BlueRidge.Oee.Dashboard.rowInstances\", 0, {view.params.rowsJson})"
              }
            }
          }
        }
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tsystem.perspective.navigate(\u0027/shop-floor/oee/unit/\u0027 + str(self.view.params.locationId))"
          }
        }
      }
    },
    "propConfig": {
      "props.style.border": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if({view.params.noReason}, \u00271px solid #DC5050\u0027, \u00271px solid var(--mpp-border-subtle)\u0027)"
          }
        }
      },
      "props.style.opacity": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if({view.params.dim}, 0.5, 1)"
          }
        }
      }
    }
  }
}