{
  "custom": {},
  "params": {
    "label": "",
    "value": "",
    "band": null,
    "indent": false
  },
  "propConfig": {
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.band": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.indent": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 170,
      "height": 20
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "gap": "6px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "13px",
            "color": "var(--mpp-text-secondary)",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.label"
              }
            }
          },
          "props.style.paddingLeft": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.indent}, \u002710px\u0027, \u00270px\u0027)"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Value"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "13px",
            "fontWeight": "600",
            "textAlign": "right",
            "whiteSpace": "nowrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.value"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(isNull({view.params.band}) || {view.params.band} \u003d \u0027\u0027, \u0027var(--mpp-text-primary)\u0027, if({view.params.band}\u003d\u0027green\u0027,\u0027#50C878\u0027,if({view.params.band}\u003d\u0027amber\u0027,\u0027#F4B343\u0027,if({view.params.band}\u003d\u0027red\u0027,\u0027#DC5050\u0027,\u0027#697A98\u0027))))"
              }
            }
          }
        }
      }
    ]
  }
}