{
  "name": "TrayInspectionStation",
  "parameters": {
    "BasePath": {
      "dataType": "String",
      "value": ""
    },
    "Device": {
      "dataType": "String",
      "value": ""
    },
    "OpcServer": {
      "dataType": "String",
      "value": "Ignition OPC UA Server"
    }
  },
  "tagType": "UdtType",
  "tags": [
    {
      "dataType": "Boolean",
      "name": "TrayLocked",
      "opcItemPath": {
        "bindType": "parameter",
        "binding": "ns=1;s=[{Device}]{BasePath}TrayLocked"
      },
      "opcServer": {
        "bindType": "parameter",
        "binding": "{OpcServer}"
      },
      "tagType": "AtomicTag",
      "valueSource": "opc"
    },
    {
      "dataType": "Boolean",
      "name": "InspectionComplete",
      "opcItemPath": {
        "bindType": "parameter",
        "binding": "ns=1;s=[{Device}]{BasePath}InspectionComplete"
      },
      "opcServer": {
        "bindType": "parameter",
        "binding": "{OpcServer}"
      },
      "tagType": "AtomicTag",
      "valueSource": "opc"
    },
    {
      "dataType": "Int4",
      "name": "PartNumber",
      "opcItemPath": {
        "bindType": "parameter",
        "binding": "ns=1;s=[{Device}]{BasePath}PartNumber"
      },
      "opcServer": {
        "bindType": "parameter",
        "binding": "{OpcServer}"
      },
      "tagType": "AtomicTag",
      "valueSource": "opc"
    },
    {
      "dataType": "Int4",
      "name": "VisionPartNumber",
      "opcItemPath": {
        "bindType": "parameter",
        "binding": "ns=1;s=[{Device}]{BasePath}VisionPartNumber"
      },
      "opcServer": {
        "bindType": "parameter",
        "binding": "{OpcServer}"
      },
      "tagType": "AtomicTag",
      "valueSource": "opc"
    },
    {
      "dataType": "Boolean",
      "name": "OkToContinue",
      "defaultValue": false,
      "tagType": "AtomicTag",
      "valueSource": "memory"
    },
    {
      "dataType": "String",
      "name": "ContainerName",
      "opcItemPath": {
        "bindType": "parameter",
        "binding": "ns=1;s=[{Device}]{BasePath}ContainerName"
      },
      "opcServer": {
        "bindType": "parameter",
        "binding": "{OpcServer}"
      },
      "tagType": "AtomicTag",
      "valueSource": "opc"
    },
    {
      "dataType": "String",
      "defaultValue": "SlcPassPulse",
      "name": "Protocol",
      "tagType": "AtomicTag",
      "valueSource": "memory"
    },
    {
      "dataType": "Boolean",
      "defaultValue": false,
      "name": "DisableWriteback",
      "tagType": "AtomicTag",
      "valueSource": "memory"
    },
    {
      "dataType": "Boolean",
      "defaultValue": false,
      "name": "WriteDisplayEnabled",
      "tagType": "AtomicTag",
      "valueSource": "memory"
    },
    {
      "dataType": "Boolean",
      "defaultValue": false,
      "name": "VisionMatchOptional",
      "tagType": "AtomicTag",
      "valueSource": "memory"
    }
  ]
}
