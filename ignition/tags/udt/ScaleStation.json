{
  "name": "ScaleStation",
  "parameters": {
    "BasePath": {
      "dataType": "String",
      "value": ""
    },
    "Device": {
      "dataType": "String",
      "value": "MPP_Sim"
    },
    "OpcServer": {
      "dataType": "String",
      "value": "Ignition OPC UA Server"
    },
    "WeightUom": {
      "dataType": "String",
      "value": "lb"
    }
  },
  "tagType": "UdtType",
  "tags": [
    {
      "name": "Weight",
      "tagType": "Folder",
      "tags": [
        {
          "dataType": "Float8",
          "name": "Net",
          "opcItemPath": {
            "bindType": "parameter",
            "binding": "ns=1;s=[{Device}]{BasePath}HRF2"
          },
          "opcServer": {
            "bindType": "parameter",
            "binding": "{OpcServer}"
          },
          "tagType": "AtomicTag",
          "valueSource": "opc"
        },
        {
          "dataType": "Boolean",
          "name": "InMotion",
          "opcItemPath": {
            "bindType": "parameter",
            "binding": "ns=1;s=[{Device}]{BasePath}HR4.12"
          },
          "opcServer": {
            "bindType": "parameter",
            "binding": "{OpcServer}"
          },
          "tagType": "AtomicTag",
          "valueSource": "opc"
        },
        {
          "dataType": "Boolean",
          "name": "IsValid",
          "opcItemPath": {
            "bindType": "parameter",
            "binding": "ns=1;s=[{Device}]{BasePath}HR4.15"
          },
          "opcServer": {
            "bindType": "parameter",
            "binding": "{OpcServer}"
          },
          "tagType": "AtomicTag",
          "valueSource": "opc"
        },
        {
          "dataType": "Boolean",
          "expression": "{[.]Protocol/Live/FpIndicator} = 1",
          "name": "SourceIsNet",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        },
        {
          "dataType": "String",
          "defaultValue": "{WeightUom}",
          "name": "Uom",
          "tagType": "AtomicTag",
          "valueSource": "memory"
        }
      ]
    },
    {
      "name": "Verdict",
      "tagType": "Folder",
      "tags": [
        {
          "dataType": "Boolean",
          "name": "Under",
          "opcItemPath": {
            "bindType": "parameter",
            "binding": "ns=1;s=[{Device}]{BasePath}HR4.0"
          },
          "opcServer": {
            "bindType": "parameter",
            "binding": "{OpcServer}"
          },
          "tagType": "AtomicTag",
          "valueSource": "opc"
        },
        {
          "dataType": "Boolean",
          "name": "Ok",
          "opcItemPath": {
            "bindType": "parameter",
            "binding": "ns=1;s=[{Device}]{BasePath}HR4.2"
          },
          "opcServer": {
            "bindType": "parameter",
            "binding": "{OpcServer}"
          },
          "tagType": "AtomicTag",
          "valueSource": "opc"
        },
        {
          "dataType": "Boolean",
          "name": "Over",
          "opcItemPath": {
            "bindType": "parameter",
            "binding": "ns=1;s=[{Device}]{BasePath}HR4.4"
          },
          "opcServer": {
            "bindType": "parameter",
            "binding": "{OpcServer}"
          },
          "tagType": "AtomicTag",
          "valueSource": "opc"
        },
        {
          "dataType": "String",
          "expression": "if({[.]Verdict/Ok}, 'Ok', if({[.]Verdict/Under}, 'Under', if({[.]Verdict/Over}, 'Over', 'Unknown')))",
          "name": "State",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        }
      ]
    },
    {
      "name": "Setpoint",
      "tagType": "Folder",
      "tags": [
        {
          "dataType": "Float8",
          "defaultValue": 0.0,
          "name": "Target",
          "tagType": "AtomicTag",
          "valueSource": "memory"
        },
        {
          "dataType": "Float8",
          "defaultValue": 0.0,
          "name": "Tolerance",
          "tagType": "AtomicTag",
          "valueSource": "memory"
        },
        {
          "dataType": "Boolean",
          "defaultValue": false,
          "name": "Apply",
          "tagType": "AtomicTag",
          "valueSource": "memory"
        },
        {
          "dataType": "Float8",
          "defaultValue": 0.0,
          "name": "ActiveTarget",
          "tagType": "AtomicTag",
          "valueSource": "memory"
        },
        {
          "dataType": "String",
          "defaultValue": "Idle",
          "name": "State",
          "tagType": "AtomicTag",
          "valueSource": "memory"
        }
      ]
    },
    {
      "name": "Protocol",
      "tagType": "Folder",
      "tags": [
        {
          "name": "Live",
          "tagType": "Folder",
          "tags": [
            {
              "dataType": "Int4",
              "name": "Command",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HR1026"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Int4",
              "name": "CommandResponse",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HR1"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Int4",
              "name": "Status",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HR4"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Boolean",
              "name": "Integrity1",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HR1.13"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Boolean",
              "name": "Integrity2",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HR4.14"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Int4",
              "expression": "getBit({[.]Protocol/Live/CommandResponse}, 8) * 1 + getBit({[.]Protocol/Live/CommandResponse}, 9) * 2 + getBit({[.]Protocol/Live/CommandResponse}, 10) * 4 + getBit({[.]Protocol/Live/CommandResponse}, 11) * 8 + getBit({[.]Protocol/Live/CommandResponse}, 12) * 16",
              "name": "FpIndicator",
              "tagType": "AtomicTag",
              "valueSource": "expr"
            }
          ]
        },
        {
          "name": "Command",
          "tagType": "Folder",
          "tags": [
            {
              "dataType": "Int4",
              "name": "Command",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HR1029"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Float8",
              "name": "LoadValue",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HRF1030"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Int4",
              "name": "CommandResponse",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HR5"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Float8",
              "name": "EchoValue",
              "opcItemPath": {
                "bindType": "parameter",
                "binding": "ns=1;s=[{Device}]{BasePath}HRF6"
              },
              "opcServer": {
                "bindType": "parameter",
                "binding": "{OpcServer}"
              },
              "tagType": "AtomicTag",
              "valueSource": "opc"
            },
            {
              "dataType": "Int4",
              "expression": "getBit({[.]Protocol/Command/CommandResponse}, 8) * 1 + getBit({[.]Protocol/Command/CommandResponse}, 9) * 2 + getBit({[.]Protocol/Command/CommandResponse}, 10) * 4 + getBit({[.]Protocol/Command/CommandResponse}, 11) * 8 + getBit({[.]Protocol/Command/CommandResponse}, 12) * 16",
              "name": "FpIndicator",
              "tagType": "AtomicTag",
              "valueSource": "expr"
            },
            {
              "dataType": "Int4",
              "expression": "getBit({[.]Protocol/Command/CommandResponse}, 14) * 1 + getBit({[.]Protocol/Command/CommandResponse}, 15) * 2",
              "name": "CommandAck",
              "tagType": "AtomicTag",
              "valueSource": "expr"
            }
          ]
        }
      ]
    }
  ]
}
